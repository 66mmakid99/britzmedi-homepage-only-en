{
	"name": "britzmedi-homepage-only-en",
	"pages_build_output_dir": "./dist",
  "compatibility_date": "2026-01-24",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"observability": {
    "enabled": true
  },
  // D1 Database for leads
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "britzmedi-leads",
      "database_id": "b42c1b3d-bb23-4559-9a25-3d8811d975dc"
    }
  ],
  // KV for sessions (Astro sessions)
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "27c7cd159fc64df89f218371597e716c"
    }
  ]
}
