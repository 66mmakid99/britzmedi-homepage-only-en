---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Dashboard', href: '/admin/leads', icon: 'dashboard', external: false },
  { label: 'Homepage', href: '/admin/homepage', icon: 'homepage', external: false },
  { label: 'YouTube to Blog', href: '/admin/youtube-to-blog', icon: 'youtube', external: false },
  { label: 'Blog Manager', href: '/admin/blog-manager', icon: 'blog', external: false },
  { label: 'Subscribers', href: '/admin/subscribers', icon: 'subscribers', external: false },
  { label: 'Social', href: '/admin/social', icon: 'social', external: false },
  { label: 'Resources', href: '/admin/resources', icon: 'resources', external: false },
  { label: 'Keystatic CMS', href: '/keystatic', icon: 'cms', external: true },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} | BRITZMEDI Admin</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="min-h-screen bg-slate-100">
  <!-- Admin Header -->
  <header class="bg-slate-900 text-white sticky top-0 z-50">
    <div class="container">
      <div class="flex items-center justify-between h-16">
        <!-- Logo -->
        <div class="flex items-center gap-8">
          <a href="/admin/leads" class="flex items-center gap-3">
            <div class="w-8 h-8 bg-primary-500 rounded-lg flex items-center justify-center">
              <span class="text-white font-bold text-sm">B</span>
            </div>
            <div>
              <span class="font-semibold">BRITZMEDI</span>
              <span class="ml-2 px-2 py-0.5 text-xs bg-slate-700 rounded">Admin</span>
            </div>
          </a>

          <!-- Navigation -->
          <nav class="hidden md:flex items-center gap-1">
            {navItems.map(item => (
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-1.5 ${
                  currentPath === item.href || currentPath.startsWith(item.href + '/')
                    ? 'bg-slate-700 text-white'
                    : 'text-slate-300 hover:text-white hover:bg-slate-800'
                }`}
              >
                {item.label}
                {item.external && (
                  <svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                )}
              </a>
            ))}
          </nav>
        </div>

        <!-- Right side -->
        <div class="flex items-center gap-4">
          <a
            href="/"
            class="flex items-center gap-2 px-3 py-1.5 text-sm text-slate-300 hover:text-white transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Site
          </a>
          <a
            href="/api/admin/logout"
            class="flex items-center gap-2 px-3 py-1.5 text-sm bg-slate-700 hover:bg-slate-600 text-white rounded-lg transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            Logout
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main>
    <slot />
  </main>
</body>
</html>
