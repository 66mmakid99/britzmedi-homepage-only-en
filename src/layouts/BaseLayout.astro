---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  ogImage?: string;
  noIndex?: boolean;
}

const { 
  title, 
  description = "BRITZMEDI is a professional aesthetic medical device manufacturer. FDA 510(k) cleared TORR RF and innovative skincare solutions from Korea.",
  keywords = ["BRITZMEDI", "medical device", "aesthetic device", "TORR RF", "RF technology", "Korea medical device", "FDA cleared"],
  ogImage = "/og-image.jpg",
  noIndex = false,
} = Astro.props;

const siteUrl = "https://britzmedi.com";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const fullTitle = title === "Home" ? "BRITZMEDI | Aesthetic Medical Device Manufacturer" : `${title} | BRITZMEDI`;
---

<!DOCTYPE html>
<html lang="en" class="">
<head>
  <!-- Google Consent Mode v2 - Default settings (must be before any Google tags) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    
    // Check if localhost/development environment
    const isDev = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
    
    // Set default consent (denied for production, granted for dev/testing)
    gtag('consent', 'default', {
      'ad_storage': isDev ? 'granted' : 'denied',
      'ad_user_data': isDev ? 'granted' : 'denied',
      'ad_personalization': isDev ? 'granted' : 'denied',
      'analytics_storage': isDev ? 'granted' : 'denied',
      'functionality_storage': isDev ? 'granted' : 'denied',
      'personalization_storage': isDev ? 'granted' : 'denied',
      'security_storage': 'granted',
      'wait_for_update': 500
    });
    
    // Enable ads data redaction when consent denied
    gtag('set', 'ads_data_redaction', true);
  </script>

  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-0G1PVS4XCN"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-0G1PVS4XCN');
  </script>

  <!-- Consent Manager (GDPR/Cookie Consent Banner) -->
  <script type="text/javascript" data-cmp-ab="1" src="https://cdn.consentmanager.net/delivery/autoblocking/be2c22fa62941.js" data-cmp-host="b.delivery.consentmanager.net" data-cmp-cdn="cdn.consentmanager.net" data-cmp-codesrc="16"></script>

  <!-- Dark Mode Initialization (prevents flash) -->
  <script is:inline>
    (function() {
      const savedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- Primary Meta Tags -->
  <title>{fullTitle}</title>
  <meta name="title" content={fullTitle} />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords.join(", ")} />
  
  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalUrl} />
  
  <!-- Robots -->
  {noIndex && <meta name="robots" content="noindex, nofollow" />}
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content="BRITZMEDI" />
  
  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalUrl} />
  <meta property="twitter:title" content={fullTitle} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={`${siteUrl}${ogImage}`} />
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <!-- Fonts - Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  
  <!-- Structured Data - Organization -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MedicalOrganization",
    "name": "BRITZMEDI Co., Ltd.",
    "alternateName": "(주)브리츠메디",
    "url": siteUrl,
    "logo": `${siteUrl}/logo.png`,
    "description": "Professional aesthetic medical device manufacturer established in 2017. FDA 510(k) cleared products.",
    "foundingDate": "2017-10-23",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1211, 388, Dunchon-daero, Jungwon-gu",
      "addressLocality": "Seongnam-si",
      "addressRegion": "Gyeonggi-do",
      "postalCode": "13403",
      "addressCountry": "KR"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+82-70-4348-7244",
      "contactType": "customer service",
      "email": "contact@britzmedi.co.kr"
    },
    "sameAs": []
  })} />

  <!-- Tawk.to Chat Widget -->
  <script is:inline>
    var Tawk_API=Tawk_API||{}, Tawk_LoadStart=new Date();
    (function(){
      var s1=document.createElement("script"),s0=document.getElementsByTagName("script")[0];
      s1.async=true;
      s1.src='https://embed.tawk.to/69750b239602761980a882d2/1jfoj70v5';
      s1.charset='UTF-8';
      s1.setAttribute('crossorigin','*');
      s0.parentNode.insertBefore(s1,s0);
    })();
  </script>
</head>
<body class="min-h-screen flex flex-col">
  <Header />
  
  <main class="flex-1">
    <slot />
  </main>
  
  <Footer />
</body>
</html>
