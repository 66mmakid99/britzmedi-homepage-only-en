---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ChatbotWrapper from '../components/features/ChatbotWrapper.astro';
import PageTracker from '../components/PageTracker.astro';
import SEOHead from '../components/seo/SEOHead.astro';
import WebVitals from '../components/seo/WebVitals.astro';
import { getLangFromUrl, isRTL } from '../i18n/config';

interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  noIndex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
}

const {
  title,
  description = "BRITZMEDI is a professional aesthetic medical device manufacturer. FDA 510(k) cleared TORR RF and innovative skincare solutions from Korea.",
  keywords = ["BRITZMEDI", "medical device", "aesthetic device", "TORR RF", "RF technology", "Korea medical device", "FDA cleared"],
  ogImage = "/og-image.jpg",
  ogType = "website",
  noIndex = false,
  publishedTime,
  modifiedTime,
  author,
} = Astro.props;

const siteUrl = "https://britzmedi.com";

// Detect language from URL
const currentLang = getLangFromUrl(Astro.url);
const isRtl = isRTL(currentLang);
---

<!DOCTYPE html>
<html lang={currentLang} dir={isRtl ? 'rtl' : 'ltr'} class="">
<head>
  <!-- Google Consent Mode v2 - Default settings (must be before any Google tags) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    
    // Check if localhost/development environment
    const isDev = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
    
    // Set default consent (denied for production, granted for dev/testing)
    gtag('consent', 'default', {
      'ad_storage': isDev ? 'granted' : 'denied',
      'ad_user_data': isDev ? 'granted' : 'denied',
      'ad_personalization': isDev ? 'granted' : 'denied',
      'analytics_storage': isDev ? 'granted' : 'denied',
      'functionality_storage': isDev ? 'granted' : 'denied',
      'personalization_storage': isDev ? 'granted' : 'denied',
      'security_storage': 'granted',
      'wait_for_update': 500
    });
    
    // Enable ads data redaction when consent denied
    gtag('set', 'ads_data_redaction', true);
  </script>

  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-0G1PVS4XCN"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-0G1PVS4XCN');
  </script>

  <!-- Consent Manager (GDPR/Cookie Consent Banner) -->
  <script async type="text/javascript" data-cmp-ab="1" src="https://cdn.consentmanager.net/delivery/autoblocking/be2c22fa62941.js" data-cmp-host="b.delivery.consentmanager.net" data-cmp-cdn="cdn.consentmanager.net" data-cmp-codesrc="16"></script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Google Search Console Verification -->
  <meta name="google-site-verification" content="YuNo5zAdeAB96xf5MVQolAzmRieijVq5JOnNKdQAdaA" />

  <!-- Enhanced SEO Meta Tags -->
  <SEOHead
    title={title}
    description={description}
    keywords={keywords}
    ogImage={ogImage}
    ogType={ogType}
    noIndex={noIndex}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    author={author}
  />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.svg?v=4" />

  <!-- Fonts - Inter with non-blocking load for better LCP -->
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" as="style" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" /></noscript>
  
  <!-- Structured Data - Organization -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MedicalOrganization",
    "name": "BRITZMEDI Co., Ltd.",
    "alternateName": "(주)브리츠메디",
    "url": siteUrl,
    "logo": `${siteUrl}/images/logos/britzmedi-logo.png`,
    "image": `${siteUrl}/og-image.jpg`,
    "description": "BRITZMEDI is a South Korean medical aesthetic device manufacturer specializing in innovative RF technology for skin tightening and body contouring.",
    "foundingDate": "2017-10-23",
    "numberOfEmployees": {
      "@type": "QuantitativeValue",
      "minValue": 10,
      "maxValue": 50
    },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1211, 388, Dunchon-daero, Jungwon-gu",
      "addressLocality": "Seongnam-si",
      "addressRegion": "Gyeonggi-do",
      "postalCode": "13403",
      "addressCountry": "KR"
    },
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "telephone": "+82-70-4348-7244",
        "contactType": "customer service",
        "email": "sh.lee@britzmedi.com",
        "availableLanguage": ["English", "Korean", "Japanese", "Chinese"]
      },
      {
        "@type": "ContactPoint",
        "telephone": "+82-70-4348-7244",
        "contactType": "sales",
        "email": "sh.lee@britzmedi.com"
      },
      {
        "@type": "ContactPoint",
        "telephone": "+82-10-6525-9442",
        "contactType": "sales",
        "url": "https://wa.me/821065259442",
        "name": "WhatsApp",
        "availableLanguage": ["English", "Korean"]
      }
    ],
    "areaServed": "Worldwide",
    "knowsAbout": ["RF Technology", "Aesthetic Medical Devices", "Skin Tightening", "Body Contouring"],
    "hasCredential": [
      { "@type": "EducationalOccupationalCredential", "credentialCategory": "FDA 510(k) Clearance", "name": "K212561" },
      { "@type": "EducationalOccupationalCredential", "credentialCategory": "ISO 13485:2016" },
      { "@type": "EducationalOccupationalCredential", "credentialCategory": "GMP Certification" }
    ],
    "sameAs": []
  })} />

  <!-- Page-specific head content (preloads, etc.) -->
  <slot name="head" />

  <!-- Claude AI Chatbot (replaced Tawk.to) -->
</head>
<body class="min-h-screen flex flex-col">
  <Header />

  <main class="flex-1">
    <slot />
  </main>

  <Footer />

  <!-- AI Chatbot -->
  <ChatbotWrapper />

  <!-- Web Vitals Reporting -->
  <WebVitals />

  <!-- Page View Tracking -->
  <PageTracker />
</body>
</html>
