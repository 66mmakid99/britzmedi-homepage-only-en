---
// Enhanced SEO Head Component
import { getAlternateUrls, getLangFromUrl, defaultLang, supportedLanguages, isLocalizedRoute, type Language } from '../../i18n/config';

interface Props {
  title: string;
  description: string;
  keywords?: string[];
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  canonicalUrl?: string;
  noIndex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  tags?: string[];
}

const {
  title,
  description,
  keywords = [],
  ogImage = '/og-image.jpg',
  ogType = 'website',
  canonicalUrl,
  noIndex = false,
  publishedTime,
  modifiedTime,
  author,
  section,
  tags = []
} = Astro.props;

const siteUrl = 'https://britzmedi.com';
const fullTitle = title === 'Home'
  ? 'BRITZMEDI | Korean Medical Aesthetic Device Manufacturer | RF Technology'
  : `${title} | BRITZMEDI`;
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// Generate hreflang URLs — only for pages that actually have localized versions.
// Emitting alternates for English-only pages (e.g. /confirm-subscription) declares 404 URLs to Google.
const hasLocalizedVersions = isLocalizedRoute(Astro.url.pathname);
const alternateUrls = getAlternateUrls(Astro.url.pathname, siteUrl);

// Open Graph locale per page language
const currentLang = getLangFromUrl(Astro.url);
const ogLocaleMap: Record<Language, string> = {
  en: 'en_US',
  ko: 'ko_KR',
  ja: 'ja_JP',
  zh: 'zh_CN',
  th: 'th_TH',
  vi: 'vi_VN',
  es: 'es_ES',
  fr: 'fr_FR',
  ru: 'ru_RU',
  ar: 'ar_SA',
};
const languageNameMap: Record<Language, string> = {
  en: 'English',
  ja: 'Japanese',
  zh: 'Chinese',
  th: 'Thai',
  vi: 'Vietnamese',
  es: 'Spanish',
  fr: 'French',
  ru: 'Russian',
  ar: 'Arabic',
};
const ogLocale = ogLocaleMap[currentLang];
const ogLocaleAlternates = supportedLanguages
  .filter((lang) => lang !== currentLang)
  .map((lang) => ogLocaleMap[lang]);
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}

<!-- Canonical URL -->
<link rel="canonical" href={canonical} />

<!-- Sitemap -->
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

<!-- Robots -->
{noIndex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
)}

<!-- Hreflang Tags for International SEO -->
{hasLocalizedVersions ? (
  <>
    {supportedLanguages.map(lang => (
      <link rel="alternate" hreflang={lang} href={alternateUrls[lang]} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternateUrls[defaultLang]} />
  </>
) : (
  /* English-only pages: declare self as the default version (never a 404). */
  !noIndex && <link rel="alternate" hreflang="x-default" href={canonical} />
)}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={ogLocale} />
{hasLocalizedVersions && ogLocaleAlternates.map((locale) => (
  <meta property="og:locale:alternate" content={locale} />
))}
<meta property="og:site_name" content="BRITZMEDI" />

{/* Article-specific OG tags */}
{ogType === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{ogType === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}
{ogType === 'article' && author && (
  <meta property="article:author" content={author} />
)}
{ogType === 'article' && section && (
  <meta property="article:section" content={section} />
)}
{ogType === 'article' && tags.map(tag => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Additional SEO Tags -->
<meta name="author" content="BRITZMEDI Co., Ltd." />
<meta name="publisher" content="BRITZMEDI Co., Ltd." />
<meta name="copyright" content="BRITZMEDI Co., Ltd." />
<meta name="language" content={languageNameMap[currentLang]} />
<meta name="revisit-after" content="7 days" />
<meta name="distribution" content="global" />
<meta name="rating" content="general" />

<!-- Geo Tags -->
<meta name="geo.region" content="KR-41" />
<meta name="geo.placename" content="Seongnam-si, Gyeonggi-do" />
<meta name="geo.position" content="37.4449;127.1389" />
<meta name="ICBM" content="37.4449, 127.1389" />

<!-- Mobile App Tags -->
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content="BRITZMEDI" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="application-name" content="BRITZMEDI" />
<meta name="msapplication-TileColor" content="#0070c4" />
<meta name="theme-color" content="#0070c4" />

<!-- DNS Prefetch for Performance -->
<link rel="dns-prefetch" href="//fonts.googleapis.com" />
<link rel="dns-prefetch" href="//fonts.gstatic.com" />
<link rel="dns-prefetch" href="//www.googletagmanager.com" />
<link rel="dns-prefetch" href="//api.anthropic.com" />

<!-- Preconnect for Critical Resources -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
