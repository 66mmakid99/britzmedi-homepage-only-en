---
// Astro wrapper for React Chatbot component
import Chatbot from './Chatbot';

interface Props {
  productContext?: string;
  pageContext?: string;
}

const { productContext, pageContext } = Astro.props;
---

<div id="chatbot-container" dir="ltr" style="direction: ltr; text-align: left;">
  <Chatbot
    client:idle
    productContext={productContext}
    pageContext={pageContext}
  />
</div>
