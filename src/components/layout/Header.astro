---
// Header Component - Premium Medical Device Brand Navigation with i18n
import LanguageSwitcher from '../ui/LanguageSwitcher.astro';
import { getLangFromUrl, defaultLang, type Language } from '../../i18n/config';
import { useTranslations } from '../../i18n';

// Detect language from URL
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// Helper to generate language-aware URLs
const localizedUrl = (path: string) => {
  if (currentLang === defaultLang) {
    return path;
  }
  return `/${currentLang}${path}`;
};

// Navigation items with translation keys
const navigation = [
  { key: 'nav.products', href: "/products" },
  { key: 'nav.about', href: "/about" },
  { key: 'nav.certifications', href: "/certifications" },
  { key: 'nav.blog', href: "/blog" },
  { key: 'nav.resources', href: "/resources" },
  { key: 'nav.faq', href: "/faq" },
  { key: 'nav.contact', href: "/contact" },
];

const currentPath = Astro.url.pathname;

// Check if path is active (considering language prefix)
const isActivePath = (href: string) => {
  const localizedHref = localizedUrl(href);
  return currentPath === localizedHref || currentPath.startsWith(localizedHref + "/");
};
---

<header class="fixed top-0 left-0 right-0 z-[100] transition-all duration-300" id="header">
  <div class="absolute inset-0 bg-white/80 backdrop-blur-xl border-b border-slate-200/50"></div>
  <div class="container relative">
    <nav class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href={localizedUrl("/")} class="flex items-center group" aria-label="BRITZMEDI">
        <img src="/images/logos/britzmedi-logo.png" alt="BRITZMEDI" class="h-10 lg:h-12 w-auto" />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        {navigation.map((item) => {
          const isActive = isActivePath(item.href);
          return (
            <a
              href={localizedUrl(item.href)}
              class:list={[
                "relative px-4 py-2 text-sm font-medium rounded-lg transition-all duration-200",
                isActive
                  ? "text-primary-600 bg-primary-50"
                  : "text-slate-600 hover:text-slate-900 hover:bg-slate-50"
              ]}
            >
              {t(item.key as any)}
            </a>
          );
        })}
      </div>

      <!-- CTA Button & Controls -->
      <div class="hidden lg:flex items-center gap-2">
        <LanguageSwitcher />
        <a
          href={localizedUrl("/contact")}
          class="group inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm font-semibold text-white bg-gradient-to-r from-primary-600 to-primary-700 hover:from-primary-700 hover:to-primary-800 rounded-xl shadow-lg shadow-primary-500/25 hover:shadow-primary-500/40 transition-all duration-300"
        >
          {t('nav.contactUs')}
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="lg:hidden flex items-center gap-2">
        <button
          type="button"
          class="w-10 h-10 flex items-center justify-center rounded-xl bg-slate-100 hover:bg-slate-200 transition-colors"
          id="mobile-menu-button"
          aria-label="Open menu"
        >
          <svg class="w-5 h-5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<!-- Mobile Menu -->
<div class="lg:hidden fixed inset-0 z-[200] pointer-events-none" id="mobile-menu" aria-hidden="true">
  <!-- Backdrop -->
  <div
    class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-none"
    id="mobile-menu-overlay"
  ></div>

  <!-- Panel -->
  <div
    class="absolute top-0 end-0 bottom-0 w-full max-w-[320px] bg-white shadow-2xl transform translate-x-full rtl:-translate-x-full transition-transform duration-300 ease-out pointer-events-none"
    id="mobile-menu-panel"
  >
    <!-- Header -->
    <div class="flex items-center justify-between h-16 px-5 border-b border-slate-100">
      <span class="text-lg font-bold text-slate-900">
        {t('nav.menu')}
      </span>
      <button
        type="button"
        class="w-10 h-10 flex items-center justify-center rounded-xl bg-slate-100 hover:bg-slate-200 transition-colors"
        id="mobile-menu-close"
        aria-label="Close menu"
      >
        <svg class="w-5 h-5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Navigation -->
    <nav class="p-5 space-y-2">
      {navigation.map((item) => {
        const isActive = isActivePath(item.href);
        return (
          <a
            href={localizedUrl(item.href)}
            class:list={[
              "flex items-center gap-3 px-4 py-3.5 rounded-xl text-base font-medium transition-all duration-200",
              isActive
                ? "bg-primary-50 text-primary-600"
                : "text-slate-700 hover:bg-slate-50"
            ]}
          >
            {t(item.key as any)}
            <svg class="w-4 h-4 ms-auto text-slate-400 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        );
      })}
    </nav>

    <!-- Language Switcher for Mobile -->
    <div class="px-5 py-3 border-t border-slate-100">
      <LanguageSwitcher />
    </div>

    <!-- CTA -->
    <div class="absolute bottom-0 left-0 right-0 p-5 border-t border-slate-100 bg-slate-50">
      <a
        href={localizedUrl("/contact")}
        class="flex items-center justify-center gap-2 w-full px-6 py-4 text-base font-semibold text-white bg-gradient-to-r from-primary-600 to-primary-700 hover:from-primary-700 hover:to-primary-800 rounded-xl shadow-lg transition-all duration-300"
      >
        {t('nav.contactUs')}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</div>

<!-- Spacer for fixed header -->
<div class="h-16 lg:h-20"></div>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
  const mobileMenuPanel = document.getElementById('mobile-menu-panel');
  const mobileMenuClose = document.getElementById('mobile-menu-close');

  const isRtl = document.documentElement.dir === 'rtl';

  function openMenu() {
    if (!mobileMenu || !mobileMenuOverlay || !mobileMenuPanel) return;

    mobileMenu.classList.remove('pointer-events-none');
    mobileMenu.setAttribute('aria-hidden', 'false');
    mobileMenuOverlay.classList.remove('opacity-0', 'pointer-events-none');
    mobileMenuOverlay.classList.add('opacity-100', 'pointer-events-auto');
    mobileMenuPanel.classList.remove('translate-x-full', '-translate-x-full', 'pointer-events-none');
    mobileMenuPanel.classList.add('translate-x-0', 'pointer-events-auto');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    if (!mobileMenu || !mobileMenuOverlay || !mobileMenuPanel) return;

    mobileMenuOverlay.classList.add('opacity-0', 'pointer-events-none');
    mobileMenuOverlay.classList.remove('opacity-100', 'pointer-events-auto');
    const offscreenClass = isRtl ? '-translate-x-full' : 'translate-x-full';
    mobileMenuPanel.classList.add(offscreenClass, 'pointer-events-none');
    mobileMenuPanel.classList.remove('translate-x-0', 'pointer-events-auto');
    document.body.style.overflow = '';

    setTimeout(() => {
      mobileMenu.classList.add('pointer-events-none');
      mobileMenu.setAttribute('aria-hidden', 'true');
    }, 300);
  }

  mobileMenuButton?.addEventListener('click', openMenu);
  mobileMenuClose?.addEventListener('click', closeMenu);
  mobileMenuOverlay?.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  const menuLinks = mobileMenuPanel?.querySelectorAll('a');
  menuLinks?.forEach(link => {
    link.addEventListener('click', () => {
      setTimeout(closeMenu, 100);
    });
  });
</script>
