---
// Header Component - Premium Medical Device Brand Navigation

const navigation = [
  { name: "Products", href: "/products" },
  { name: "About", href: "/about" },
  { name: "Certifications", href: "/certifications" },
  { name: "Resources", href: "/resources" },
  { name: "FAQ", href: "/faq" },
  { name: "Contact", href: "/contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-[100] transition-all duration-300" id="header">
  <div class="absolute inset-0 bg-white/80 backdrop-blur-xl border-b border-slate-200/50"></div>
  <div class="container relative">
    <nav class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 bg-gradient-to-br from-primary-500 to-primary-700 rounded-xl flex items-center justify-center shadow-lg shadow-primary-500/20 group-hover:shadow-primary-500/40 transition-shadow">
          <span class="text-white font-bold text-lg">B</span>
        </div>
        <span class="text-xl lg:text-2xl font-bold tracking-tight bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent">
          BRITZMEDI
        </span>
      </a>
      
      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        {navigation.map((item) => {
          const isActive = currentPath === item.href || currentPath.startsWith(item.href + "/");
          return (
            <a 
              href={item.href}
              class:list={[
                "relative px-4 py-2 text-sm font-medium rounded-lg transition-all duration-200",
                isActive 
                  ? "text-primary-600 bg-primary-50" 
                  : "text-slate-600 hover:text-slate-900 hover:bg-slate-50"
              ]}
            >
              {item.name}
            </a>
          );
        })}
      </div>
      
      <!-- CTA Button & Theme Toggle -->
      <div class="hidden lg:flex items-center gap-3">
        <!-- Theme Toggle Button -->
        <button 
          type="button"
          id="theme-toggle-desktop"
          class="w-10 h-10 flex items-center justify-center rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 transition-colors"
          aria-label="Toggle dark mode"
        >
          <!-- Sun icon (shown in dark mode) -->
          <svg class="w-5 h-5 text-slate-700 dark:text-slate-300 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg class="w-5 h-5 text-slate-700 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
        
        <a 
          href="/contact" 
          class="group inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm font-semibold text-white bg-gradient-to-r from-primary-600 to-primary-700 hover:from-primary-700 hover:to-primary-800 rounded-xl shadow-lg shadow-primary-500/25 hover:shadow-primary-500/40 transition-all duration-300"
        >
          Get in Touch
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
      
      <!-- Mobile: Theme Toggle + Menu Button -->
      <div class="lg:hidden flex items-center gap-2">
        <!-- Mobile Theme Toggle -->
        <button 
          type="button"
          id="theme-toggle-mobile"
          class="w-10 h-10 flex items-center justify-center rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 transition-colors"
          aria-label="Toggle dark mode"
        >
          <svg class="w-5 h-5 text-slate-700 dark:text-slate-300 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="w-5 h-5 text-slate-700 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
        
        <!-- Mobile Menu Button -->
        <button 
          type="button" 
          class="w-10 h-10 flex items-center justify-center rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 transition-colors"
          id="mobile-menu-button"
          aria-label="Open menu"
        >
          <svg class="w-5 h-5 text-slate-700 dark:text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<!-- Mobile Menu - Separate from header to avoid z-index issues -->
<div class="lg:hidden fixed inset-0 z-[200] pointer-events-none" id="mobile-menu" aria-hidden="true">
  <!-- Backdrop -->
  <div 
    class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-none" 
    id="mobile-menu-overlay"
  ></div>
  
  <!-- Panel -->
  <div 
    class="absolute top-0 right-0 bottom-0 w-full max-w-[320px] bg-white shadow-2xl transform translate-x-full transition-transform duration-300 ease-out pointer-events-none"
    id="mobile-menu-panel"
  >
    <!-- Header -->
    <div class="flex items-center justify-between h-16 px-5 border-b border-slate-100">
      <span class="text-lg font-bold text-slate-900">Menu</span>
      <button 
        type="button" 
        class="w-10 h-10 flex items-center justify-center rounded-xl bg-slate-100 hover:bg-slate-200 transition-colors"
        id="mobile-menu-close"
        aria-label="Close menu"
      >
        <svg class="w-5 h-5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    
    <!-- Navigation -->
    <nav class="p-5 space-y-2">
      {navigation.map((item) => {
        const isActive = currentPath === item.href || currentPath.startsWith(item.href + "/");
        return (
          <a 
            href={item.href}
            class:list={[
              "flex items-center gap-3 px-4 py-3.5 rounded-xl text-base font-medium transition-all duration-200",
              isActive 
                ? "bg-primary-50 text-primary-600" 
                : "text-slate-700 hover:bg-slate-50"
            ]}
          >
            {item.name}
            <svg class="w-4 h-4 ml-auto text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        );
      })}
    </nav>
    
    <!-- CTA -->
    <div class="absolute bottom-0 left-0 right-0 p-5 border-t border-slate-100 bg-slate-50">
      <a 
        href="/contact" 
        class="flex items-center justify-center gap-2 w-full px-6 py-4 text-base font-semibold text-white bg-gradient-to-r from-primary-600 to-primary-700 hover:from-primary-700 hover:to-primary-800 rounded-xl shadow-lg transition-all duration-300"
      >
        Get in Touch
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</div>

<!-- Spacer for fixed header -->
<div class="h-16 lg:h-20"></div>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
  const mobileMenuPanel = document.getElementById('mobile-menu-panel');
  const mobileMenuClose = document.getElementById('mobile-menu-close');

  function openMenu() {
    if (!mobileMenu || !mobileMenuOverlay || !mobileMenuPanel) return;
    
    mobileMenu.classList.remove('pointer-events-none');
    mobileMenu.setAttribute('aria-hidden', 'false');
    mobileMenuOverlay.classList.remove('opacity-0', 'pointer-events-none');
    mobileMenuOverlay.classList.add('opacity-100', 'pointer-events-auto');
    mobileMenuPanel.classList.remove('translate-x-full', 'pointer-events-none');
    mobileMenuPanel.classList.add('translate-x-0', 'pointer-events-auto');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    if (!mobileMenu || !mobileMenuOverlay || !mobileMenuPanel) return;
    
    mobileMenuOverlay.classList.add('opacity-0', 'pointer-events-none');
    mobileMenuOverlay.classList.remove('opacity-100', 'pointer-events-auto');
    mobileMenuPanel.classList.add('translate-x-full', 'pointer-events-none');
    mobileMenuPanel.classList.remove('translate-x-0', 'pointer-events-auto');
    document.body.style.overflow = '';
    
    setTimeout(() => {
      mobileMenu.classList.add('pointer-events-none');
      mobileMenu.setAttribute('aria-hidden', 'true');
    }, 300);
  }

  mobileMenuButton?.addEventListener('click', openMenu);
  mobileMenuClose?.addEventListener('click', closeMenu);
  mobileMenuOverlay?.addEventListener('click', closeMenu);

  // Close on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  // Close menu on navigation (for SPA-like behavior)
  const menuLinks = mobileMenuPanel?.querySelectorAll('a');
  menuLinks?.forEach(link => {
    link.addEventListener('click', () => {
      setTimeout(closeMenu, 100);
    });
  });

  // Theme Toggle Functionality
  function initTheme() {
    const savedTheme = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    
    if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  }

  function toggleTheme() {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  }

  // Initialize theme
  initTheme();

  // Add event listeners for theme toggle buttons
  document.getElementById('theme-toggle-desktop')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);
</script>
