---
// Footer Component - Professional Medical Device Brand with i18n

import { company } from '../../content/company';
import { getLangFromUrl, defaultLang, type Language } from '../../i18n/config';
import { useTranslations } from '../../i18n';

// Detect language from URL
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// Helper to generate language-aware URLs
const localizedUrl = (path: string) => {
  if (currentLang === defaultLang) {
    return path;
  }
  return `/${currentLang}${path}`;
};

const currentYear = new Date().getFullYear();

// Product links (product names stay in English as brand names)
const productLinks = [
  { name: "TORR RF", href: localizedUrl("/products/torr-rf") },
  { name: "ULBLANC", href: localizedUrl("/products/ulblanc") },
  { name: "NEWCHAE SHOT", href: localizedUrl("/products/newchae-shot") },
  { name: "LUMINO WAVE", href: localizedUrl("/products/lumino-wave") },
];
---

<footer class="bg-slate-900 text-slate-300">
  <!-- Main Footer -->
  <div class="container py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-12">
      <!-- Brand Column -->
      <div class="lg:col-span-2">
        <a href={localizedUrl("/")} class="inline-block" aria-label="BRITZMEDI">
          <img src="/images/logos/britzmedi-logo.png" alt="BRITZMEDI" class="h-12 w-auto brightness-0 invert" />
        </a>
        <p class="mt-4 text-sm leading-relaxed text-slate-400 max-w-sm">
          {t('footer.description')}
        </p>

        <!-- Certifications Badges -->
        <div class="mt-6 flex flex-wrap gap-3">
          <span class="inline-flex items-center px-3 py-1.5 text-xs font-medium bg-slate-800 text-slate-300 rounded-full">
            {t('footer.badges.fdaCleared')}
          </span>
          <span class="inline-flex items-center px-3 py-1.5 text-xs font-medium bg-slate-800 text-slate-300 rounded-full">
            {t('footer.badges.iso')}
          </span>
          <span class="inline-flex items-center px-3 py-1.5 text-xs font-medium bg-slate-800 text-slate-300 rounded-full">
            {t('footer.badges.gmp')}
          </span>
        </div>
      </div>

      <!-- Products Links -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">
          {t('footer.products')}
        </h3>
        <ul class="space-y-3">
          {productLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-slate-400 hover:text-white transition-colors"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company Links -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">
          {t('footer.company')}
        </h3>
        <ul class="space-y-3">
          <li>
            <a
              href={localizedUrl("/about")}
              class="text-sm text-slate-400 hover:text-white transition-colors"
            >
              {t('footer.links.aboutUs')}
            </a>
          </li>
          <li>
            <a
              href={localizedUrl("/certifications")}
              class="text-sm text-slate-400 hover:text-white transition-colors"
            >
              {t('footer.links.certifications')}
            </a>
          </li>
          <li>
            <a
              href={localizedUrl("/faq")}
              class="text-sm text-slate-400 hover:text-white transition-colors"
            >
              {t('footer.links.faq')}
            </a>
          </li>
          <li>
            <a
              href={localizedUrl("/contact")}
              class="text-sm text-slate-400 hover:text-white transition-colors"
            >
              {t('footer.contact')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">
          {t('footer.contact')}
        </h3>
        <ul class="space-y-3 text-sm text-slate-400">
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-slate-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{company.address.city}, {company.address.province}<br />{company.address.country}</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-5 h-5 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href={`tel:${company.contact.phone}`} class="hover:text-white transition-colors">
              {company.contact.phone}
            </a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-5 h-5 text-slate-500 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.174.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 016.99 2.898 9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            <a
              href={company.contact.whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
            >
              WhatsApp {company.contact.whatsapp}
            </a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-5 h-5 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={`mailto:${company.contact.email}`} class="hover:text-white transition-colors">
              {company.contact.email}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Newsletter Section -->
  <div class="border-t border-slate-800">
    <div class="container py-8">
      <div class="max-w-2xl mx-auto text-center">
        <h3 class="text-lg font-semibold text-white mb-2">{t('footer.newsletter.title')}</h3>
        <p class="text-sm text-slate-400 mb-5">{t('footer.newsletter.subtitle')}</p>
        <form
          id="newsletterForm"
          class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto"
          data-msg-invalid={t('footer.newsletter.msgInvalid')}
          data-msg-subscribing={t('footer.newsletter.msgSubscribing')}
          data-msg-success={t('footer.newsletter.msgSuccess')}
          data-msg-error={t('footer.newsletter.msgError')}
          data-msg-network={t('footer.newsletter.msgNetwork')}
          data-label-subscribe={t('footer.newsletter.subscribe')}
        >
          <input
            type="email"
            id="newsletterEmail"
            name="email"
            required
            placeholder={t('footer.newsletter.placeholder')}
            class="flex-1 px-4 py-3 bg-slate-800 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm"
          />
          <button
            type="submit"
            id="newsletterBtn"
            class="px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-lg transition-colors shrink-0"
          >
            {t('footer.newsletter.subscribe')}
          </button>
        </form>
        <div id="newsletterStatus" class="hidden mt-3 text-sm"></div>
        <p class="mt-3 text-xs text-slate-500">{t('footer.newsletter.privacy')}</p>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-slate-800">
    <div class="container py-6">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-sm text-slate-500">
          {t('footer.copyright').replace('{year}', currentYear.toString())}
        </p>
        <div class="flex items-center gap-6">
          <a href={localizedUrl("/privacy")} class="text-sm text-slate-500 hover:text-slate-300 transition-colors">
            {t('footer.privacyPolicy')}
          </a>
          <a href={localizedUrl("/terms")} class="text-sm text-slate-500 hover:text-slate-300 transition-colors">
            {t('footer.termsOfService')}
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  const nlForm = document.getElementById('newsletterForm') as HTMLFormElement;
  const nlEmail = document.getElementById('newsletterEmail') as HTMLInputElement;
  const nlBtn = document.getElementById('newsletterBtn') as HTMLButtonElement;
  const nlStatus = document.getElementById('newsletterStatus') as HTMLElement;

  // Read i18n strings from data-* attributes (injected at build time)
  const msgInvalid = nlForm?.dataset.msgInvalid || 'Please enter a valid email address.';
  const msgSubscribing = nlForm?.dataset.msgSubscribing || 'Subscribing...';
  const msgSuccess = nlForm?.dataset.msgSuccess || 'Thank you for subscribing!';
  const msgError = nlForm?.dataset.msgError || 'Something went wrong. Please try again.';
  const msgNetwork = nlForm?.dataset.msgNetwork || 'Network error. Please try again.';
  const labelSubscribe = nlForm?.dataset.labelSubscribe || 'Subscribe';

  nlForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = nlEmail.value.trim();

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
      nlStatus.textContent = msgInvalid;
      nlStatus.className = 'mt-3 text-sm text-red-400';
      return;
    }

    nlBtn.disabled = true;
    nlBtn.textContent = msgSubscribing;

    try {
      const res = await fetch('/api/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json();

      if (res.ok) {
        nlStatus.textContent = data.message || msgSuccess;
        nlStatus.className = 'mt-3 text-sm text-green-400';
        nlForm.reset();
      } else {
        nlStatus.textContent = data.error || msgError;
        nlStatus.className = 'mt-3 text-sm text-red-400';
      }
    } catch {
      nlStatus.textContent = msgNetwork;
      nlStatus.className = 'mt-3 text-sm text-red-400';
    } finally {
      nlBtn.disabled = false;
      nlBtn.textContent = labelSubscribe;
    }
  });
</script>
