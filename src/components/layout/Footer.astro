---
// Footer Component - Professional Medical Device Brand

import { company } from '../../content/company';

const footerLinks = {
  products: {
    title: "Products",
    links: [
      { name: "TORR RF", href: "/products/torr-rf" },
      { name: "ULBLANC", href: "/products/ulblanc" },
      { name: "NEWCHAE SHOT", href: "/products/newchae-shot" },
      { name: "LUMINO WAVE", href: "/products/lumino-wave" },
    ],
  },
  company: {
    title: "Company",
    links: [
      { name: "About Us", href: "/about" },
      { name: "Certifications", href: "/certifications" },
      { name: "FAQ", href: "/faq" },
      { name: "Contact", href: "/contact" },
    ],
  },
  resources: {
    title: "Resources",
    links: [
      { name: "Resource Center", href: "/resources" },
      { name: "Product Brochures", href: "/resources#product-brochure" },
      { name: "Technical Documents", href: "/resources#technical-docs" },
      { name: "Certificates", href: "/resources#certificates" },
    ],
  },
};

const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300">
  <!-- Main Footer -->
  <div class="container py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-12">
      <!-- Brand Column -->
      <div class="lg:col-span-2">
        <a href="/" class="inline-block">
          <span class="text-2xl font-semibold text-white">BRITZMEDI</span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-slate-400 max-w-sm">
          {company.description.short}. Leading innovation in aesthetic medicine with FDA-cleared technology from Korea.
        </p>
        
        <!-- Certifications Badges -->
        <div class="mt-6 flex flex-wrap gap-3">
          <span class="inline-flex items-center px-3 py-1.5 text-xs font-medium bg-slate-800 text-slate-300 rounded-full">
            FDA 510(k) Cleared
          </span>
          <span class="inline-flex items-center px-3 py-1.5 text-xs font-medium bg-slate-800 text-slate-300 rounded-full">
            ISO 13485
          </span>
          <span class="inline-flex items-center px-3 py-1.5 text-xs font-medium bg-slate-800 text-slate-300 rounded-full">
            GMP Certified
          </span>
        </div>
      </div>
      
      <!-- Products Links -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">
          {footerLinks.products.title}
        </h3>
        <ul class="space-y-3">
          {footerLinks.products.links.map((link) => (
            <li>
              <a 
                href={link.href} 
                class="text-sm text-slate-400 hover:text-white transition-colors"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Company Links -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">
          {footerLinks.company.title}
        </h3>
        <ul class="space-y-3">
          {footerLinks.company.links.map((link) => (
            <li>
              <a 
                href={link.href} 
                class="text-sm text-slate-400 hover:text-white transition-colors"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Contact Info -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">
          Contact
        </h3>
        <ul class="space-y-3 text-sm text-slate-400">
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-slate-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{company.address.city}, {company.address.province}<br />{company.address.country}</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-5 h-5 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href={`tel:${company.contact.phone}`} class="hover:text-white transition-colors">
              {company.contact.phone}
            </a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-5 h-5 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={`mailto:${company.contact.email}`} class="hover:text-white transition-colors">
              {company.contact.email}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
  
  <!-- Bottom Bar -->
  <div class="border-t border-slate-800">
    <div class="container py-6">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-sm text-slate-500">
          © {currentYear} {company.name}. All rights reserved.
        </p>
        <div class="flex items-center gap-6">
          <a href="/privacy" class="text-sm text-slate-500 hover:text-slate-300 transition-colors">
            Privacy Policy
          </a>
          <a href="/terms" class="text-sm text-slate-500 hover:text-slate-300 transition-colors">
            Terms of Service
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
