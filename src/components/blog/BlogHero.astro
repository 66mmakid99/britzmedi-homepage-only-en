---
interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  categoryLabel: string;
  publishedAt: string;
  featuredImage?: string | null;
  dateLocale?: string;
  readMoreText?: string;
  basePath?: string;
}

const {
  slug,
  title,
  description,
  category,
  categoryLabel,
  publishedAt,
  featuredImage,
  dateLocale = 'en-US',
  readMoreText = 'Read More',
  basePath = '/blog',
} = Astro.props;

const categoryPlaceholders: Record<string, string> = {
  'technology-guide': '/images/blog/placeholder-technology.svg',
  'technology-comparison': '/images/blog/placeholder-technology.svg',
  'clinical-reviews': '/images/blog/placeholder-clinical-studies.svg',
  'clinical-technology': '/images/blog/placeholder-clinical-studies.svg',
  'industry-news': '/images/blog/placeholder-industry-news.svg',
  'industry-trends': '/images/blog/placeholder-industry-news.svg',
  'industry-insights': '/images/blog/placeholder-industry-news.svg',
  'industry-analysis': '/images/blog/placeholder-industry-news.svg',
  'buyer-guide': '/images/blog/placeholder-product-updates.svg',
  'product-updates': '/images/blog/placeholder-product-updates.svg',
  'equipment-technology': '/images/blog/placeholder-product-updates.svg',
  'medical-devices': '/images/blog/placeholder-medical-devices.svg',
  'aesthetic-technology': '/images/blog/placeholder-aesthetic-technology.svg',
  'body-contouring': '/images/blog/placeholder-body-contouring.svg',
  'education': '/images/blog/placeholder-education.svg',
  'treatment-comparisons': '/images/blog/placeholder-technology.svg',
};
const placeholderSrc = categoryPlaceholders[category] || '/images/blog/placeholder-default.svg';
const imageSrc = featuredImage || placeholderSrc;

const categoryColors: Record<string, string> = {
  'technology-guide': 'bg-blue-100/90 text-blue-700',
  'technology-comparison': 'bg-blue-100/90 text-blue-700',
  'clinical-reviews': 'bg-green-100/90 text-green-700',
  'clinical-technology': 'bg-green-100/90 text-green-700',
  'industry-news': 'bg-orange-100/90 text-orange-700',
  'industry-trends': 'bg-teal-100/90 text-teal-700',
  'industry-insights': 'bg-teal-100/90 text-teal-700',
  'industry-analysis': 'bg-teal-100/90 text-teal-700',
  'buyer-guide': 'bg-amber-100/90 text-amber-700',
  'product-updates': 'bg-amber-100/90 text-amber-700',
  'equipment-technology': 'bg-amber-100/90 text-amber-700',
  'medical-devices': 'bg-indigo-100/90 text-indigo-700',
  'aesthetic-technology': 'bg-pink-100/90 text-pink-700',
  'body-contouring': 'bg-emerald-100/90 text-emerald-700',
  'education': 'bg-purple-100/90 text-purple-700',
  'treatment-comparisons': 'bg-blue-100/90 text-blue-700',
};
const badgeColor = categoryColors[category] || 'bg-slate-100/90 text-slate-600';

const formattedDate = new Date(publishedAt).toLocaleDateString(dateLocale, {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<article class="card-premium overflow-hidden group">
  <a href={`${basePath}/${slug}`} class="block relative h-[280px] md:h-[400px] lg:h-[480px] overflow-hidden">
    <img
      src={imageSrc}
      alt={`Featured image for: ${title}`}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="eager"
      width="1200"
      height="480"
    />
    <!-- Gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/30 to-transparent"></div>
    <!-- Content overlay -->
    <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8 lg:p-10">
      <span class:list={['inline-block text-xs font-semibold px-3 py-1.5 rounded-full backdrop-blur-sm shadow-sm mb-3', badgeColor]}>
        {categoryLabel}
      </span>
      <div class="flex items-center gap-2 mb-3 text-sm text-white/80">
        <time datetime={publishedAt}>{formattedDate}</time>
      </div>
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-3 group-hover:text-primary-300 transition-colors duration-300 line-clamp-3">
        {title}
      </h2>
      <p class="text-base text-white/80 mb-4 line-clamp-2 max-w-2xl">{description}</p>
      <span class="inline-flex items-center text-sm font-medium text-white group-hover:text-primary-300 transition-colors duration-300">
        {readMoreText}
        <svg class="w-4 h-4 ml-1.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </span>
    </div>
  </a>
</article>
