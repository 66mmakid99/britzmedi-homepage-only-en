---
interface Category {
  value: string;
  label: string;
}

interface Props {
  categories: Category[];
  activeCategory?: string;
  filterLabel?: string;
}

const { categories, activeCategory = 'all', filterLabel = 'Filter by topic' } = Astro.props;
---

<div class="mb-10" id="category-filter-wrapper">
  <div class="flex items-center gap-3 mb-4">
    <span class="text-sm font-semibold text-slate-500 uppercase tracking-wide whitespace-nowrap">{filterLabel}</span>
    <div class="divider-gradient flex-1"></div>
  </div>
  <div class="flex flex-wrap gap-3" id="category-filter">
    {categories.map((cat) => (
      <button
        data-category={cat.value}
        class:list={[
          'px-5 py-2.5 rounded-full text-sm font-semibold transition-all duration-300 cursor-pointer border',
          cat.value === activeCategory
            ? 'bg-primary-600 text-white shadow-md shadow-primary-500/20 border-primary-600'
            : 'bg-white text-slate-600 border-slate-200 hover:border-primary-300 hover:text-primary-600'
        ]}
      >
        {cat.label}
      </button>
    ))}
  </div>
</div>

<script>
  function initCategoryFilter() {
    const filterContainer = document.getElementById('category-filter');
    if (!filterContainer) return;

    const buttons = filterContainer.querySelectorAll('button');
    const heroCard = document.getElementById('blog-hero-card');
    const paginationEl = document.getElementById('blog-pagination');

    buttons.forEach(button => {
      button.addEventListener('click', () => {
        const category = button.getAttribute('data-category');

        // Update active button
        buttons.forEach(btn => {
          btn.classList.remove('bg-primary-600', 'text-white', 'shadow-md', 'shadow-primary-500/20', 'border-primary-600');
          btn.classList.add('bg-white', 'text-slate-600', 'border-slate-200', 'hover:border-primary-300', 'hover:text-primary-600');
        });
        button.classList.remove('bg-white', 'text-slate-600', 'border-slate-200', 'hover:border-primary-300', 'hover:text-primary-600');
        button.classList.add('bg-primary-600', 'text-white', 'shadow-md', 'shadow-primary-500/20', 'border-primary-600');

        // Filter cards (skip buttons themselves which also have data-category)
        const articles = document.querySelectorAll('article[data-category]');
        articles.forEach(card => {
          if (category === 'all' || card.getAttribute('data-category') === category) {
            (card as HTMLElement).style.display = '';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });

        // Show/hide hero based on filter
        if (heroCard) {
          const heroCategory = heroCard.getAttribute('data-hero-category');
          if (category === 'all' || heroCategory === category) {
            (heroCard as HTMLElement).style.display = '';
          } else {
            (heroCard as HTMLElement).style.display = 'none';
          }
        }

        // Hide pagination when filtering
        if (paginationEl) {
          (paginationEl as HTMLElement).style.display = category === 'all' ? '' : 'none';
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initCategoryFilter);
  initCategoryFilter();
</script>
