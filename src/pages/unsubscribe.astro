---
export const prerender = false;

const url = Astro.url;
const status = url.searchParams.get('status') || 'success';

const messages = {
  success: {
    icon: 'check',
    title: 'Unsubscribed Successfully',
    description: 'You have been removed from our mailing list. You will no longer receive email notifications from BRITZMEDI.',
    color: 'green',
  },
  already: {
    icon: 'info',
    title: 'Already Unsubscribed',
    description: 'You were already unsubscribed from our mailing list.',
    color: 'blue',
  },
  invalid: {
    icon: 'error',
    title: 'Invalid Link',
    description: 'This unsubscribe link is invalid or has expired.',
    color: 'red',
  },
  error: {
    icon: 'error',
    title: 'Something Went Wrong',
    description: 'An error occurred while processing your request. Please try again later.',
    color: 'red',
  },
};

const msg = messages[status as keyof typeof messages] || messages.error;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{msg.title} | BRITZMEDI</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f1f5f9;
      padding: 20px;
    }
    .card {
      max-width: 480px;
      width: 100%;
      background: white;
      border-radius: 16px;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,.1);
      padding: 48px 32px;
      text-align: center;
    }
    .icon {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
    }
    .icon-green { background: #dcfce7; color: #16a34a; }
    .icon-blue { background: #dbeafe; color: #2563eb; }
    .icon-red { background: #fee2e2; color: #dc2626; }
    .icon svg { width: 32px; height: 32px; }
    h1 { font-size: 24px; font-weight: 700; color: #1e293b; margin-bottom: 12px; }
    p { font-size: 15px; color: #64748b; line-height: 1.7; margin-bottom: 24px; }
    .btn {
      display: inline-block;
      padding: 12px 28px;
      background: #2563eb;
      color: white;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 14px;
      transition: background .2s;
    }
    .btn:hover { background: #1d4ed8; }
    .resubscribe {
      display: inline-block;
      margin-top: 12px;
      font-size: 13px;
      color: #64748b;
      text-decoration: underline;
    }
    .resubscribe:hover { color: #475569; }
    .brand {
      margin-top: 32px;
      font-size: 12px;
      color: #94a3b8;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class={`icon icon-${msg.color}`}>
      {msg.icon === 'check' && (
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      )}
      {msg.icon === 'info' && (
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      )}
      {msg.icon === 'error' && (
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      )}
    </div>

    <h1>{msg.title}</h1>
    <p>{msg.description}</p>

    <a href="/blog" class="btn">Visit Our Blog</a>

    {(status === 'success' || status === 'already') && (
      <a href="/blog" class="resubscribe">Changed your mind? Visit our blog to resubscribe.</a>
    )}

    <p class="brand">BRITZMEDI - Medical Aesthetics Technology</p>
  </div>
</body>
</html>
