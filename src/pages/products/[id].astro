---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products, getProductById } from '../../content/products';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;

// SEO-optimized titles per product
const seoTitles: Record<string, string> = {
  'torr-rf': 'TORR RF - FDA Cleared Multi-Wave RF Skin Tightening Device',
  'ulblanc': 'ULBLANC - Dual Frequency Ultrasound Aesthetic Workstation',
  'newchae-shot': 'NEWCHAE SHOT - 3-in-1 RF EMS Home Beauty Device',
  'lumino-wave': 'LUMINO WAVE - Next-Gen Ultrasound Laser Convergence Device',
};

const seoDescriptions: Record<string, string> = {
  'torr-rf': 'TORR RF (K212561) FDA 510(k) cleared multi-wave RF device for skin tightening, body contouring, and pain relief. Non-invasive with auto-circular motion technology. Request a quote.',
  'ulblanc': 'ULBLANC dual-frequency ultrasound workstation combining skin tightening and sonophoresis drug delivery. MFDS certified aesthetic device from BRITZMEDI. Learn more.',
  'newchae-shot': 'NEWCHAE SHOT 3-in-1 personal beauty device with RF tightening, EMS contouring, and ELP skin boosting. Clinical-grade home-care technology by BRITZMEDI.',
  'lumino-wave': 'LUMINO WAVE next-generation convergence device combining ultrasound and laser energy for enhanced skin treatment. Launching H2 2026 from BRITZMEDI.',
};

const pageTitle = seoTitles[product.id] || `${product.name} - ${product.tagline}`;
const pageDescription = seoDescriptions[product.id] || `${product.name} - ${product.tagline}. ${product.overview}`.slice(0, 160);

const siteUrl = 'https://britzmedi.com';

// Build Product + MedicalDevice JSON-LD schema
const productSchema = {
  "@context": "https://schema.org",
  "@type": product.category === 'medical-device' ? ["Product", "MedicalDevice"] : "Product",
  "name": product.name,
  "model": product.model,
  "description": product.overview,
  "url": `${siteUrl}/products/${product.id}`,
  ...(product.images?.main ? { "image": `${siteUrl}${product.images.main}` } : {}),
  "brand": { "@type": "Brand", "name": "BRITZMEDI" },
  "manufacturer": {
    "@type": "Organization",
    "name": "BRITZMEDI Co., Ltd.",
    "url": siteUrl,
  },
  "category": product.category === 'medical-device' ? "Medical Device" : "Beauty Device",
  ...(product.indications ? {
    "relevantSpecialty": { "@type": "MedicalSpecialty", "name": "Dermatology" }
  } : {}),
  ...(product.certifications && product.certifications.length > 0 ? {
    "additionalProperty": product.certifications.map(cert => ({
      "@type": "PropertyValue",
      "name": cert.name,
      "value": cert.status + (cert.detail ? ` (${cert.detail})` : '')
    }))
  } : {}),
  "offers": {
    "@type": "Offer",
    "availability": product.status === 'available'
      ? "https://schema.org/InStock"
      : "https://schema.org/PreOrder",
    "seller": { "@type": "Organization", "name": "BRITZMEDI Co., Ltd." },
    "url": `${siteUrl}/contact`
  }
};

// BreadcrumbList schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": `${siteUrl}/products` },
    { "@type": "ListItem", "position": 3, "name": product.name, "item": `${siteUrl}/products/${product.id}` }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogType="product"
  ogImage={product.images?.main}
  keywords={[product.name, product.model, "BRITZMEDI", "medical device", "aesthetic device", ...product.keyTechnologies.map(t => t.name)]}
>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <!-- BreadcrumbList Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-slate-50 to-white py-12 lg:py-20">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="mb-8">
        <ol class="flex items-center gap-2 text-sm">
          <li>
            <a href="/" class="text-slate-500 hover:text-primary-600 transition-colors">Home</a>
          </li>
          <li class="text-slate-400">/</li>
          <li>
            <a href="/products" class="text-slate-500 hover:text-primary-600 transition-colors">Products</a>
          </li>
          <li class="text-slate-400">/</li>
          <li class="text-slate-900 font-medium">{product.name}</li>
        </ol>
      </nav>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <!-- Product Image -->
        <div class="aspect-square bg-gradient-to-br from-slate-100 to-slate-200 rounded-2xl relative overflow-hidden">
          {product.images?.main ? (
            <img
              src={product.images.main}
              alt={product.name}
              width="800"
              height="800"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full h-full object-cover"
            />
          ) : (
            <div class="w-full h-full flex items-center justify-center">
              <span class="text-8xl font-light text-slate-300">{product.name.charAt(0)}</span>
            </div>
          )}

          <!-- Badges -->
          <div class="absolute top-6 left-6 flex flex-col gap-2">
            {product.featured && (
              <span class="inline-flex items-center px-3 py-1.5 text-xs font-medium bg-primary-600 text-white rounded-full">
                Flagship Product
              </span>
            )}
            {product.status === 'coming-soon' && (
              <span class="inline-flex items-center px-3 py-1.5 text-xs font-medium bg-accent-500 text-white rounded-full">
                Coming H2 2026
              </span>
            )}
          </div>
        </div>

        <!-- Product Info -->
        <div>
          <!-- Category Badge -->
          <span class="inline-flex items-center px-3 py-1 mb-4 text-xs font-medium bg-primary-50 text-primary-700 rounded-full uppercase tracking-wider">
            {product.category === 'medical-device' ? 'Medical Device' : 'Medical Cosmetic'}
          </span>

          <h1 class="heading-1 mb-2">{product.name}</h1>
          <p class="text-lg text-slate-500 mb-4">Model: {product.model}</p>

          <p class="text-xl text-primary-600 font-medium mb-6">{product.tagline}</p>

          <p class="body-large mb-8">{product.description}</p>

          <!-- Certifications -->
          {product.certifications && product.certifications.length > 0 && (
            <div class="mb-8">
               <h2 class="text-sm font-semibold text-slate-900 uppercase tracking-wider mb-3">Certifications</h2>
              <div class="flex flex-wrap gap-2">
                {product.certifications.map((cert) => (
                  <div class:list={[
                    "inline-flex items-center gap-2 px-3 py-2 rounded-lg border",
                    cert.status === 'Cleared' || cert.status === 'Approved' || cert.status === 'Certified'
                      ? "bg-green-50 border-green-200 text-green-800"
                      : cert.status === 'Under Review'
                        ? "bg-amber-50 border-amber-200 text-amber-800"
                        : "bg-slate-50 border-slate-200 text-slate-700"
                  ]}>
                    {(cert.status === 'Cleared' || cert.status === 'Approved' || cert.status === 'Certified') && (
                      <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                    )}
                    <span class="text-sm font-medium">{cert.name}</span>
                    {cert.detail && <span class="text-xs opacity-75">({cert.detail})</span>}
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- CTA -->
          <div class="flex flex-wrap gap-4">
            <a
              href={`/contact?product=${product.id}`}
              class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white bg-primary-600 hover:bg-primary-700 rounded-lg transition-colors"
            >
              Request Quote
            </a>
            <a
              href={`/contact?product=${product.id}`}
              class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-slate-700 bg-white border border-slate-200 hover:border-slate-300 hover:bg-slate-50 rounded-lg transition-colors"
            >
              Request Demo
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product Gallery Section -->
  <section class="section bg-slate-50">
    <div class="container">
      <div class="max-w-2xl mb-12">
        <span class="label mb-3 block">Gallery</span>
        <h2 class="heading-2 mb-4">Product Images</h2>
        <p class="body-large">
          Detailed views of {product.name} and its components.
        </p>
      </div>

      {product.images?.gallery && (
        <div class="grid md:grid-cols-3 gap-6">
          {product.images.gallery.map((img: string) => (
            <div class="aspect-[4/3] rounded-xl overflow-hidden bg-white border border-slate-200 group cursor-pointer hover:shadow-xl transition-all duration-300">
              <img
                src={img}
                alt={product.name}
                width="800"
                height="600"
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                loading="lazy"
                decoding="async"
              />
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Key Technologies Section -->
  <section class="section bg-white">
    <div class="container">
      <div class="max-w-2xl mb-12">
        <span class="label mb-3 block">Technology</span>
        <h2 class="heading-2 mb-4">Key Technologies</h2>
        <p class="body-large">
          Innovative technologies powering {product.name}'s exceptional performance.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {product.keyTechnologies.map((tech) => (
          <div class="bg-slate-50 border border-slate-100 rounded-xl p-6">
            <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="font-semibold text-slate-900 mb-2">{tech.name}</h3>
            <p class="body-small">{tech.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Clinical Applications Section (if available) -->
  {product.indications && product.indications.length > 0 && (
    <section class="section bg-slate-50">
      <div class="container">
        <div class="max-w-2xl mb-12">
          <span class="label mb-3 block">Clinical Applications</span>
          <h2 class="heading-2 mb-4">Treatment Areas & Indications</h2>
          <p class="body-large">
            FDA-cleared and approved applications for {product.name}.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          {product.indications.map((indication) => {
            const [title, desc] = indication.includes(' - ')
              ? indication.split(' - ')
              : [indication, null];

            // Determine icon based on indication type
            const iconPath = title.toLowerCase().includes('body') || title.toLowerCase().includes('contour')
              ? "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
              : title.toLowerCase().includes('face') || title.toLowerCase().includes('lift') || title.toLowerCase().includes('skin')
                ? "M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                : title.toLowerCase().includes('pain') || title.toLowerCase().includes('vascular')
                  ? "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                  : "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z";

            return (
              <div class="bg-white rounded-xl p-6 border border-slate-100 hover:border-primary-200 hover:shadow-lg transition-all duration-300">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={iconPath} />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-slate-900 mb-1">{title}</h3>
                    {desc && <p class="text-sm text-slate-600">{desc}</p>}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Specifications Section (if available) -->
  {product.specifications && product.specifications.length > 0 && (
    <section class="section bg-white">
      <div class="container">
        <div class="max-w-2xl mb-12">
          <span class="label mb-3 block">Technical Data</span>
          <h2 class="heading-2 mb-4">Specifications</h2>
        </div>

        <div class="bg-slate-50 rounded-2xl border border-slate-100 overflow-hidden">
          <table class="w-full">
            <tbody>
              {product.specifications.map((spec, index) => (
                <tr class:list={[
                  "border-b border-slate-100 last:border-0",
                  index % 2 === 0 ? "bg-white" : "bg-slate-50"
                ]}>
                  <td class="p-4 lg:p-6 w-1/3">
                    <span class="font-medium text-slate-900">{spec.label}</span>
                  </td>
                  <td class="p-4 lg:p-6">
                    <span class="text-slate-700">{spec.value}</span>
                    {spec.note && (
                      <span class="block text-sm text-slate-500 mt-1">{spec.note}</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <!-- Handpieces Section (if available) -->
  {product.handpieces && product.handpieces.length > 0 && (
    <section class="section bg-slate-50">
      <div class="container">
        <div class="max-w-2xl mb-12">
          <span class="label mb-3 block">Accessories</span>
          <h2 class="heading-2 mb-4">Handpiece Configuration</h2>
          <p class="body-large">
            Specialized handpieces tailored for different anatomical areas and treatment depths.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {product.handpieces.map((handpiece) => {
            // Map handpiece name to image key
            const nameToKey = {
              'Large Handpiece (Body)': 'body-super',
              'Small Handpiece (Face)': 'face-super',
              'Micro Handpiece (Eye/Delicate)': 'eye',
              'Body Handpiece - Deep': 'body-deep',
              'Body Handpiece - Super': 'body-super',
              'Body Handpiece - Vibe': 'body-vibe',
              'Face Handpiece - Deep': 'face-deep',
              'Face Handpiece - Super': 'face-super',
              'Eye Handpiece': 'eye'
            };
            const imageKey = nameToKey[handpiece.name];
            const imageSrc = imageKey && product.images?.handpieces?.[imageKey];

            return (
              <div class="bg-white rounded-xl p-6 border border-slate-100 hover:border-primary-200 hover:shadow-lg transition-all duration-300 group">
                <div class="aspect-[4/3] bg-gradient-to-br from-slate-100 to-slate-200 rounded-lg mb-4 overflow-hidden">
                  {imageSrc ? (
                    <img
                      src={imageSrc}
                      alt={handpiece.name}
                      width="800"
                      height="600"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center">
                      <svg class="w-12 h-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                      </svg>
                    </div>
                  )}
                </div>
                <h3 class="font-semibold text-slate-900 mb-3">{handpiece.name}</h3>
                <div class="space-y-2 text-sm">
                  <div class="flex justify-between">
                    <span class="text-slate-500">Tip Size</span>
                    <span class="text-slate-900 font-medium">{handpiece.tipSize}</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-slate-500">Depth</span>
                    <span class="text-slate-900 font-medium">{handpiece.depth}</span>
                  </div>
                </div>
                <p class="body-small mt-4 pt-4 border-t border-slate-100">{handpiece.feature}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Why [Product] Section (USP) -->
  {product.differentiators && product.differentiators.length > 0 && (
    <section class="section bg-gradient-to-br from-primary-600 via-primary-700 to-primary-800 text-white">
      <div class="container">
        <div class="max-w-2xl mb-12">
          <span class="inline-flex items-center gap-2 px-3 py-1 text-xs font-semibold bg-white/20 text-white rounded-full mb-4">
            Why Choose
          </span>
          <h2 class="text-3xl lg:text-4xl font-bold mb-4">Why {product.name}?</h2>
          <p class="text-lg text-primary-100">
            Key differentiators that set {product.name} apart from the competition.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {product.differentiators.map((diff, index) => (
            <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-white/20">
              <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center mb-4">
                <span class="text-2xl font-bold">{index + 1}</span>
              </div>
              <h3 class="text-xl font-semibold mb-3">{diff.feature}</h3>
              <p class="text-primary-100">{diff.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Clinical Benefits Section (if available) -->
  {product.clinicalBenefits && product.clinicalBenefits.length > 0 && (
    <section class="section bg-white">
      <div class="container">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <span class="label mb-3 justify-center">Benefits</span>
            <h2 class="heading-2 mb-4">Clinical Benefits</h2>
            <p class="body-large">
              Why clinicians choose {product.name} for their practice.
            </p>
          </div>

          <div class="grid md:grid-cols-2 gap-6">
            {product.clinicalBenefits.map((benefit) => (
              <div class="flex items-start gap-4 bg-slate-50 rounded-xl p-5 border border-slate-100">
                <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="text-slate-700 font-medium">{benefit}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Related Products Section -->
  <section class="section bg-slate-50">
    <div class="container">
      <div class="max-w-2xl mb-12">
        <span class="label mb-3 block">Explore More</span>
        <h2 class="heading-2 mb-4">Related Products</h2>
        <p class="body-large">
          Discover other innovative aesthetic devices from BRITZMEDI.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
        {products.filter(p => p.id !== product.id).map((related) => (
          <a
            href={`/products/${related.id}`}
            class="group card-premium p-6 lg:p-7"
          >
            <div class="aspect-[4/3] bg-gradient-to-br from-slate-100 via-slate-50 to-slate-100 rounded-xl mb-6 relative overflow-hidden">
              {related.images?.main ? (
                <img
                  src={related.images.main}
                  alt={related.name}
                  width="800"
                  height="600"
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center">
                  <span class="text-5xl font-light text-slate-300 group-hover:text-primary-300 transition-colors">{related.name.charAt(0)}</span>
                </div>
              )}
              {related.status === 'coming-soon' && (
                <span class="absolute top-3 right-3 inline-flex items-center px-2.5 py-1 text-xs font-medium bg-accent-500 text-white rounded-full">
                  Coming Soon
                </span>
              )}
            </div>

            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <h3 class="text-lg font-bold text-slate-900 group-hover:text-primary-600 transition-colors">{related.name}</h3>
                <p class="text-sm text-primary-600 font-medium mt-1">{related.tagline}</p>
              </div>
              <div class="w-10 h-10 rounded-xl bg-slate-100 group-hover:bg-primary-100 flex items-center justify-center shrink-0 transition-colors">
                <svg class="w-5 h-5 text-slate-400 group-hover:text-primary-600 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>

            <p class="body-small line-clamp-2">{related.overview}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section bg-slate-900">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">
          Interested in {product.name}?
        </h2>
        <p class="text-lg text-slate-300 mb-8">
          Schedule a live demo or download the product catalog for detailed specifications.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href={`/contact?product=${product.id}&type=demo`}
            class="inline-flex items-center gap-2 px-7 py-4 text-base font-semibold text-slate-900 bg-white hover:bg-slate-100 rounded-xl transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            Request Demo
          </a>
          <a
            href="/resources"
            class="inline-flex items-center gap-2 px-7 py-4 text-base font-semibold text-white border-2 border-white/30 hover:bg-white/10 rounded-xl transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
