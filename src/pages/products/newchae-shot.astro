---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProductById, products } from '../../content/products';

const product = getProductById('newchae-shot')!;
const data = await import('../../content/products/newchae-shot/index.json');

const pageTitle = 'NEWCHAE SHOT - 3-in-1 RF EMS Home Beauty Device | BRITZMEDI';
const pageDescription = 'NEWCHAE SHOT personal beauty device with RF tightening, EMS contouring, and ELP skin boosting. Medical-grade technology designed for home care by BRITZMEDI.';
const siteUrl = 'https://britzmedi.com';

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "NEWCHAE SHOT",
  "model": data.model,
  "description": data.overview,
  "url": `${siteUrl}/products/newchae-shot`,
  "image": `${siteUrl}/images/products/newchae-shot.webp`,
  "brand": { "@type": "Brand", "name": "BRITZMEDI" },
  "manufacturer": {
    "@type": "Organization",
    "name": "BRITZMEDI Co., Ltd.",
    "url": siteUrl,
  },
  "category": "Beauty Device",
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/InStock",
    "seller": { "@type": "Organization", "name": "BRITZMEDI Co., Ltd." },
    "url": `${siteUrl}/contact`
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": `${siteUrl}/products` },
    { "@type": "ListItem", "position": 3, "name": "NEWCHAE SHOT", "item": `${siteUrl}/products/newchae-shot` }
  ]
};

const specs = data.specifications || [];
const differentiators = data.differentiators || [];
const companion = data.companionProduct;
const packageItems = data.packageContents || [];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogType="product"
  ogImage="/images/products/newchae-shot.webp"
  keywords={["NEWCHAE SHOT", "BD-ERD24NWP", "BRITZMEDI", "RF beauty device", "EMS", "Electroporation", "home beauty device", "personal beauty device"]}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .gradient-text {
      background: linear-gradient(135deg, #1e3a8a, #3b82f6, #60a5fa);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .mode-card {
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .mode-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.12);
    }
    @keyframes pulse-ring {
      0% { transform: scale(0.9); opacity: 0.6; }
      50% { transform: scale(1.1); opacity: 0.3; }
      100% { transform: scale(0.9); opacity: 0.6; }
    }
    .pulse-ring { animation: pulse-ring 2.5s ease-in-out infinite; }
    @keyframes electrode-glow {
      0%, 100% { filter: drop-shadow(0 0 2px rgba(59,130,246,0.3)); }
      50% { filter: drop-shadow(0 0 6px rgba(59,130,246,0.6)); }
    }
    .electrode-glow { animation: electrode-glow 2.5s ease-in-out infinite; }
  </style>

  <!-- ==================== SECTION 1: HERO ==================== -->
  <section class="relative bg-gradient-to-br from-slate-50 via-white to-blue-50/30 py-12 lg:py-24 overflow-hidden">
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-gradient-to-bl from-blue-50/40 to-transparent rounded-full -translate-y-1/3 translate-x-1/4"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-gradient-to-tr from-rose-50/30 to-transparent rounded-full translate-y-1/3 -translate-x-1/4"></div>

    <div class="relative container">
      <nav class="mb-10">
        <ol class="flex items-center gap-2 text-sm">
          <li><a href="/" class="text-slate-400 hover:text-blue-600 transition">Home</a></li>
          <li class="text-slate-300">/</li>
          <li><a href="/products" class="text-slate-400 hover:text-blue-600 transition">Products</a></li>
          <li class="text-slate-300">/</li>
          <li class="text-slate-700 font-medium">NEWCHAE SHOT</li>
        </ol>
      </nav>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <!-- Product Image -->
        <div class="relative">
          <div class="aspect-square bg-gradient-to-br from-slate-100/80 to-slate-50 rounded-3xl relative overflow-hidden border border-slate-100">
            {product.images?.main ? (
              <img
                src={product.images.main}
                alt="NEWCHAE SHOT"
                width="800"
                height="800"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="w-full h-full object-cover"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center">
                <span class="text-8xl font-light text-slate-300">N</span>
              </div>
            )}
            <!-- Heritage Badge -->
            <div class="absolute top-6 left-6">
              <div class="flex items-center gap-2 bg-white/90 backdrop-blur-sm rounded-full px-4 py-2 shadow-sm border border-slate-100">
                <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
                <span class="text-xs font-semibold text-slate-700">Powered by TORR RF Technology</span>
              </div>
            </div>
            <!-- Cert Badges -->
            <div class="absolute bottom-6 right-6 flex gap-2">
              <span class="inline-flex items-center px-3 py-1.5 bg-white/90 backdrop-blur-sm text-xs font-bold text-slate-600 rounded-full border border-slate-100">KC</span>
              <span class="inline-flex items-center px-3 py-1.5 bg-white/90 backdrop-blur-sm text-xs font-bold text-slate-600 rounded-full border border-slate-100">CE</span>
              <span class="inline-flex items-center px-3 py-1.5 bg-white/90 backdrop-blur-sm text-xs font-bold text-slate-600 rounded-full border border-slate-100">VCCI</span>
            </div>
          </div>
        </div>

        <!-- Product Info -->
        <div>
          <div class="flex items-center gap-3 mb-5">
            <span class="inline-flex items-center px-3 py-1 text-xs font-semibold bg-rose-50 text-rose-600 rounded-full uppercase tracking-wider">Personal Beauty Device</span>
            <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-slate-100 text-slate-500 rounded-full">{data.model}</span>
          </div>

          <h1 class="text-4xl lg:text-5xl font-extrabold text-slate-900 mb-3 tracking-tight">NEWCHAE SHOT</h1>

          <p class="text-xl lg:text-2xl font-semibold mb-2 leading-snug">
            <span class="text-slate-800">{data.tagline}</span>
          </p>
          <p class="text-lg text-blue-600 font-medium mb-6 tracking-wide">{data.taglineSub}</p>

          <p class="text-lg text-slate-600 leading-relaxed mb-8">{data.description}</p>

          <!-- Quick Specs -->
          <div class="flex flex-wrap gap-3 mb-8">
            <div class="flex items-center gap-2 px-4 py-2 bg-slate-50 rounded-xl border border-slate-100">
              <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              <span class="text-sm font-medium text-slate-700">Max 8W RF Power</span>
            </div>
            <div class="flex items-center gap-2 px-4 py-2 bg-slate-50 rounded-xl border border-slate-100">
              <svg class="w-4 h-4 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
              <span class="text-sm font-medium text-slate-700">3 Modes</span>
            </div>
            <div class="flex items-center gap-2 px-4 py-2 bg-slate-50 rounded-xl border border-slate-100">
              <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              <span class="text-sm font-medium text-slate-700">Medical-Grade Steel</span>
            </div>
            <div class="flex items-center gap-2 px-4 py-2 bg-slate-50 rounded-xl border border-slate-100">
              <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
              <span class="text-sm font-medium text-slate-700">Samsung SDI Battery</span>
            </div>
          </div>

          <!-- CTA -->
          <div class="flex flex-wrap gap-4">
            <a href="/contact?product=newchae-shot" class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl transition-all shadow-lg shadow-blue-600/20 hover:shadow-blue-600/30">
              Request a Quote
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <a href="/contact?product=newchae-shot" class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-slate-700 bg-white border-2 border-slate-200 hover:border-blue-300 hover:text-blue-700 rounded-xl transition-all">
              Download Brochure
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== SECTION 2: TECHNOLOGY HERITAGE ==================== -->
  <section class="section bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span class="label mb-3 justify-center">Core Technology</span>
        <h2 class="heading-2 mb-4">Medical-Grade Technology, <span class="gradient-text">Designed for Home Care</span></h2>
        <p class="body-large">NEWCHAE SHOT inherits the multi-channel RF technology proven in BRITZMEDI's TORR RF medical device, now engineered for safe, effective home use.</p>
      </div>

      <div class="bg-gradient-to-br from-slate-50 to-blue-50/30 rounded-3xl border border-slate-100 p-8 lg:p-12">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-xs font-semibold mb-4">
              <span class="w-1.5 h-1.5 bg-blue-500 rounded-full"></span>
              RF STACK Method
            </div>
            <h3 class="text-2xl font-bold text-slate-900 mb-4">Multi-Channel Concentrated Energy Shot System</h3>
            <p class="text-slate-600 leading-relaxed mb-6">
              Unlike conventional single-channel RF devices, NEWCHAE SHOT uses a proprietary multi-circuit, multi-electrode system for deeper and more even energy distribution. Low energy is converted to high thermal energy through the RF STACK method, delivering heat deep into the dermis while preventing surface burns.
            </p>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3.5 h-3.5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-sm text-slate-700">Deeper heat penetration vs single-channel devices</span>
              </li>
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3.5 h-3.5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-sm text-slate-700">Safe output activated only upon skin contact</span>
              </li>
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3.5 h-3.5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-sm text-slate-700">Medical-grade stainless steel electrodes (not plated)</span>
              </li>
            </ul>
          </div>

          <!-- Toroidal 3-Ring Diagram -->
          <div class="bg-white rounded-2xl border border-slate-200 aspect-[4/3] flex flex-col items-center justify-center p-8">
            <div class="flex items-center gap-10 w-full max-w-md justify-center">
              <!-- Other Devices -->
              <div class="text-center flex-1">
                <div class="w-32 h-32 mx-auto relative flex items-center justify-center mb-4">
                  <div class="absolute inset-0 rounded-full border-2 border-dashed border-slate-200"></div>
                  <div class="w-4 h-4 bg-slate-300 rounded-full"></div>
                </div>
                <p class="text-xs font-medium text-slate-400">Other Devices</p>
                <p class="text-[10px] text-slate-400 mt-1">Single Channel</p>
              </div>
              <div class="text-xs font-bold text-slate-300">VS</div>
              <!-- NEWCHAE SHOT -->
              <div class="text-center flex-1">
                <div class="w-32 h-32 mx-auto relative flex items-center justify-center mb-4">
                  <svg class="absolute inset-0 w-32 h-32 electrode-glow" viewBox="0 0 128 128">
                    <defs>
                      <g id="rf-wave-lg">
                        <circle cx="0" cy="0" r="0" fill="none" stroke="#3b82f6" stroke-width="1" opacity="0">
                          <animate attributeName="r" values="0;12" dur="2s" repeatCount="indefinite"/>
                          <animate attributeName="opacity" values="0.5;0" dur="2s" repeatCount="indefinite"/>
                        </circle>
                        <circle cx="0" cy="0" r="0" fill="none" stroke="#3b82f6" stroke-width="0.8" opacity="0">
                          <animate attributeName="r" values="0;12" dur="2s" begin="0.7s" repeatCount="indefinite"/>
                          <animate attributeName="opacity" values="0.4;0" dur="2s" begin="0.7s" repeatCount="indefinite"/>
                        </circle>
                      </g>
                      <g id="rf-wave-md">
                        <circle cx="0" cy="0" r="0" fill="none" stroke="#2563eb" stroke-width="0.8" opacity="0">
                          <animate attributeName="r" values="0;9" dur="2.2s" repeatCount="indefinite"/>
                          <animate attributeName="opacity" values="0.5;0" dur="2.2s" repeatCount="indefinite"/>
                        </circle>
                        <circle cx="0" cy="0" r="0" fill="none" stroke="#2563eb" stroke-width="0.6" opacity="0">
                          <animate attributeName="r" values="0;9" dur="2.2s" begin="0.8s" repeatCount="indefinite"/>
                          <animate attributeName="opacity" values="0.35;0" dur="2.2s" begin="0.8s" repeatCount="indefinite"/>
                        </circle>
                      </g>
                      <g id="rf-wave-sm">
                        <circle cx="0" cy="0" r="0" fill="none" stroke="#1d4ed8" stroke-width="0.8" opacity="0">
                          <animate attributeName="r" values="0;7" dur="1.8s" repeatCount="indefinite"/>
                          <animate attributeName="opacity" values="0.6;0" dur="1.8s" repeatCount="indefinite"/>
                        </circle>
                      </g>
                    </defs>
                    <!-- Static structure -->
                    <circle cx="64" cy="64" r="56" fill="none" stroke="#dbeafe" stroke-width="1.5" stroke-dasharray="6 4"/>
                    <circle cx="64" cy="64" r="34" fill="none" stroke="#bfdbfe" stroke-width="1.5" stroke-dasharray="5 3"/>
                    <circle cx="64" cy="64" r="14" fill="none" stroke="#93c5fd" stroke-width="1.5"/>
                    <!-- RF emissions -->
                    <use href="#rf-wave-lg" x="64" y="8"/><use href="#rf-wave-lg" x="103.6" y="24.4"/><use href="#rf-wave-lg" x="120" y="64"/><use href="#rf-wave-lg" x="103.6" y="103.6"/><use href="#rf-wave-lg" x="64" y="120"/><use href="#rf-wave-lg" x="24.4" y="103.6"/><use href="#rf-wave-lg" x="8" y="64"/><use href="#rf-wave-lg" x="24.4" y="24.4"/>
                    <use href="#rf-wave-md" x="64" y="30"/><use href="#rf-wave-md" x="88" y="47"/><use href="#rf-wave-md" x="88" y="81"/><use href="#rf-wave-md" x="64" y="98"/><use href="#rf-wave-md" x="40" y="81"/><use href="#rf-wave-md" x="40" y="47"/>
                    <use href="#rf-wave-sm" x="64" y="64"/>
                    <!-- Static electrodes -->
                    <circle cx="64" cy="8" r="4.5" fill="#3b82f6"/><circle cx="103.6" cy="24.4" r="4.5" fill="#3b82f6"/><circle cx="120" cy="64" r="4.5" fill="#3b82f6"/><circle cx="103.6" cy="103.6" r="4.5" fill="#3b82f6"/><circle cx="64" cy="120" r="4.5" fill="#3b82f6"/><circle cx="24.4" cy="103.6" r="4.5" fill="#3b82f6"/><circle cx="8" cy="64" r="4.5" fill="#3b82f6"/><circle cx="24.4" cy="24.4" r="4.5" fill="#3b82f6"/>
                    <circle cx="64" cy="30" r="4" fill="#2563eb"/><circle cx="88" cy="47" r="4" fill="#2563eb"/><circle cx="88" cy="81" r="4" fill="#2563eb"/><circle cx="64" cy="98" r="4" fill="#2563eb"/><circle cx="40" cy="81" r="4" fill="#2563eb"/><circle cx="40" cy="47" r="4" fill="#2563eb"/>
                    <circle cx="64" cy="64" r="5.5" fill="#1d4ed8"/>
                  </svg>
                </div>
                <p class="text-xs font-bold text-blue-700">NEWCHAE SHOT</p>
                <p class="text-[10px] text-blue-500 mt-1">Toroidal 3-Ring Multi-Channel</p>
              </div>
            </div>
            <div class="flex items-center gap-5 mt-5 pt-4 border-t border-slate-100">
              <div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-full bg-[#1d4ed8]"></div><span class="text-[10px] text-slate-500">Core Ring</span></div>
              <div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-full bg-[#2563eb]"></div><span class="text-[10px] text-slate-500">Middle Ring</span></div>
              <div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-full bg-[#3b82f6]"></div><span class="text-[10px] text-slate-500">Outer Ring</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== SECTION 3: THREE MODES ==================== -->
  <section class="section bg-slate-50">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span class="label mb-3 justify-center">3 Professional Modes</span>
        <h2 class="heading-2 mb-4">One Device, Complete Skin Care</h2>
        <p class="body-large">From deep collagen stimulation to muscle toning and nutrient absorption, each mode addresses a different dimension of skin health.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- RF Mode -->
        <div class="mode-card bg-white rounded-2xl overflow-hidden border border-slate-100">
          <div class="h-2 bg-gradient-to-r from-red-400 via-orange-400 to-amber-400"></div>
          <div class="p-8">
            <div class="w-14 h-14 bg-gradient-to-br from-red-50 to-orange-50 rounded-2xl flex items-center justify-center mb-6 border border-red-100">
              <svg class="w-7 h-7 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <div class="flex items-center gap-2 mb-3">
              <h3 class="text-xl font-bold text-slate-900">RF Mode</h3>
              <span class="text-xs font-medium text-red-500 bg-red-50 px-2 py-0.5 rounded-full">1 MHz</span>
            </div>
            <p class="text-sm font-medium text-red-500 mb-4">Tightening & Collagen Boost</p>
            <ul class="space-y-3 text-sm text-slate-600">
              <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 bg-red-400 rounded-full shrink-0 mt-2"></span>Multi-channel concentrated energy shot deep into dermal layer</li>
              <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 bg-red-400 rounded-full shrink-0 mt-2"></span>Promotes collagen & elastin secretion for skin elasticity</li>
              <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 bg-red-400 rounded-full shrink-0 mt-2"></span>Enhances blood circulation for smoother texture & brighter tone</li>
              <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 bg-red-400 rounded-full shrink-0 mt-2"></span>Prevention of fine lines and volume management</li>
            </ul>
            <div class="mt-6 pt-5 border-t border-slate-100">
              <div class="flex items-center justify-between text-xs"><span class="text-slate-400">Max Power</span><span class="font-bold text-slate-700">8W</span></div>
              <div class="w-full bg-slate-100 rounded-full h-1.5 mt-2"><div class="bg-gradient-to-r from-red-400 to-orange-400 h-1.5 rounded-full" style="width: 80%"></div></div>
            </div>
          </div>
        </div>

        <!-- EMS Mode -->
        <div class="mode-card bg-white rounded-2xl overflow-hidden border border-slate-100">
          <div class="h-2 bg-gradient-to-r from-blue-400 via-indigo-400 to-violet-400"></div>
          <div class="p-8">
            <div class="w-14 h-14 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl flex items-center justify-center mb-6 border border-blue-100">
              <svg class="w-7 h-7 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
            </div>
            <div class="flex items-center gap-2 mb-3">
              <h3 class="text-xl font-bold text-slate-900">EMS Mode</h3>
              <span class="text-xs font-medium text-blue-500 bg-blue-50 px-2 py-0.5 rounded-full">1 KHz</span>
            </div>
            <p class="text-sm font-medium text-blue-500 mb-4">Muscle Toning & Lifting</p>
            <ul class="space-y-3 text-sm text-slate-600">
              <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 bg-blue-400 rounded-full shrink-0 mt-2"></span>Induces muscle contraction & relaxation for skin elasticity</li>
