---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products, productCategories } from '../../content/products';

const pageDescription = "Explore BRITZMEDI's complete lineup of aesthetic medical devices. FDA 510(k) cleared TORR RF, ULBLANC ultrasound system, NEWCHAE SHOT, and upcoming LUMINO WAVE.";
---

<BaseLayout
  title="Medical Aesthetic Devices - FDA Cleared Products"
  description="Explore BRITZMEDI's FDA 510(k) cleared aesthetic devices. TORR RF skin tightening, ULBLANC ultrasound, NEWCHAE SHOT beauty device, and LUMINO WAVE. Request product specs today."
  keywords={["BRITZMEDI products", "TORR RF", "ULBLANC", "NEWCHAE SHOT", "LUMINO WAVE", "aesthetic medical device", "FDA cleared device", "RF skin tightening"]}
>
  <!-- Products ItemList Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "BRITZMEDI Product Lineup",
    "description": "Complete lineup of BRITZMEDI aesthetic medical devices including FDA 510(k) cleared TORR RF.",
    "url": "https://britzmedi.com/products",
    "numberOfItems": products.length,
    "itemListElement": products.map((p, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": p.name,
      "url": `https://britzmedi.com/products/${p.id}`,
      "item": {
        "@type": p.category === 'medical-device' ? "MedicalDevice" : "Product",
        "name": p.name,
        "description": p.overview,
        ...(p.images?.main ? { "image": `https://britzmedi.com${p.images.main}` } : {})
      }
    }))
  })} />

  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-slate-50 to-white py-16 lg:py-24">
    <div class="container">
      <div class="max-w-3xl">
        <span class="label mb-3 block">Our Products</span>
        <h1 class="heading-1 mb-6">
          Medical Device<br />
          <span class="text-primary-600">Excellence</span>
        </h1>
        <p class="body-large">
          From our flagship FDA-cleared TORR RF to next-generation convergence technology,
          discover innovative solutions designed for superior clinical outcomes.
        </p>
      </div>
    </div>
  </section>

  <!-- Products Overview -->
  <section class="py-12 bg-white border-b border-slate-100">
    <div class="container">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        <div class="text-center">
          <div class="text-3xl font-bold text-primary-600 mb-1">{products.length}</div>
          <div class="text-sm text-slate-500">Product Lines</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary-600 mb-1">FDA</div>
          <div class="text-sm text-slate-500">510(k) Cleared</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary-600 mb-1">MFDS</div>
          <div class="text-sm text-slate-500">Certified</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary-600 mb-1">11+</div>
          <div class="text-sm text-slate-500">Patents</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product Categories -->
  <section class="section bg-white">
    <div class="container">
      <!-- Medical Devices -->
      <div class="mb-16">
        <div class="mb-8">
          <h2 class="heading-2 mb-2">Medical Devices</h2>
          <p class="body-large">Professional aesthetic medical devices for clinical use</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {products.filter(p => p.category === 'medical-device').map((product) => (
            <a
              href={`/products/${product.id}`}
              class="group block bg-white border border-slate-200 rounded-xl overflow-hidden hover:border-primary-300 hover:shadow-lg transition-all duration-300"
            >
              <!-- Product Image -->
              <div class="aspect-[4/3] bg-gradient-to-br from-slate-100 to-slate-200 relative overflow-hidden">
                {product.images?.main ? (
                  <img
                    src={product.images.main}
                    alt={product.name}
                    width="800"
                    height="600"
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center">
                    <span class="text-5xl font-light text-slate-300">{product.name.charAt(0)}</span>
                  </div>
                )}

                <!-- Status Badge -->
                {product.status === 'coming-soon' && (
                  <span class="absolute top-4 right-4 inline-flex items-center px-3 py-1 text-xs font-medium bg-accent-500 text-white rounded-full">
                    Coming Soon
                  </span>
                )}
                {product.featured && (
                  <span class="absolute top-4 left-4 inline-flex items-center px-3 py-1 text-xs font-medium bg-primary-600 text-white rounded-full">
                    Flagship
                  </span>
                )}
              </div>

              <!-- Content -->
              <div class="p-6">
                <div class="flex items-start justify-between gap-4 mb-3">
                  <div>
                    <h3 class="text-xl font-semibold text-slate-900 group-hover:text-primary-600 transition-colors">
                      {product.name}
                    </h3>
                    <p class="text-sm text-slate-500">Model: {product.model}</p>
                  </div>
                  <svg class="w-5 h-5 text-slate-400 group-hover:text-primary-600 group-hover:translate-x-1 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>

                <p class="text-sm text-primary-600 font-medium mb-3">{product.tagline}</p>

                <p class="body-small line-clamp-2 mb-4">{product.overview}</p>

                <!-- Key Technologies Preview -->
                {product.keyTechnologies && product.keyTechnologies.length > 0 && (
                  <div class="flex flex-wrap gap-2 mb-4">
                    {product.keyTechnologies.slice(0, 2).map((tech) => (
                      <span class="text-xs text-slate-600 bg-slate-100 px-2 py-1 rounded">
                        {tech.name.split(' ')[0]}
                      </span>
                    ))}
                  </div>
                )}

                <!-- Certifications -->
                {product.certifications && product.certifications.length > 0 && (
                  <div class="flex flex-wrap gap-2 pt-4 border-t border-slate-100">
                    {product.certifications.map((cert) => (
                      <span class:list={[
                        "text-xs font-medium px-2 py-1 rounded",
                        cert.status === 'Cleared' || cert.status === 'Approved' || cert.status === 'Certified'
                          ? "bg-green-50 text-green-700"
                          : cert.status === 'Under Review'
                            ? "bg-amber-50 text-amber-700"
                            : "bg-slate-100 text-slate-600"
                      ]}>
                        {cert.name}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Cosmetic Devices -->
      <div>
        <div class="mb-8">
          <h2 class="heading-2 mb-2">Medical Cosmetics</h2>
          <p class="body-large">Professional-grade home beauty devices</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {products.filter(p => p.category === 'cosmetic').map((product) => (
            <a
              href={`/products/${product.id}`}
              class="group block bg-white border border-slate-200 rounded-xl overflow-hidden hover:border-primary-300 hover:shadow-lg transition-all duration-300"
            >
              <!-- Product Image -->
              <div class="aspect-[4/3] bg-gradient-to-br from-slate-100 to-slate-200 relative overflow-hidden">
                {product.images?.main ? (
                  <img
                    src={product.images.main}
                    alt={product.name}
                    width="800"
                    height="600"
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center">
                    <span class="text-5xl font-light text-slate-300">{product.name.charAt(0)}</span>
                  </div>
                )}
              </div>

              <!-- Content -->
              <div class="p-6">
                <div class="flex items-start justify-between gap-4 mb-3">
                  <div>
                    <h3 class="text-xl font-semibold text-slate-900 group-hover:text-primary-600 transition-colors">
                      {product.name}
                    </h3>
                  </div>
                  <svg class="w-5 h-5 text-slate-400 group-hover:text-primary-600 group-hover:translate-x-1 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>

                <p class="text-sm text-primary-600 font-medium mb-3">{product.tagline}</p>

                <p class="body-small line-clamp-2 mb-4">{product.overview}</p>

                <!-- Clinical Benefits Preview -->
                {product.clinicalBenefits && product.clinicalBenefits.length > 0 && (
                  <div class="space-y-2 pt-4 border-t border-slate-100">
                    {product.clinicalBenefits.slice(0, 2).map((benefit) => (
                      <div class="flex items-center gap-2 text-xs text-slate-600">
                        <svg class="w-4 h-4 text-green-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>{benefit}</span>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison Overview -->
  <section class="section bg-slate-50">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="label mb-3 block">Product Comparison</span>
        <h2 class="heading-2 mb-4">Find the Right Solution</h2>
        <p class="body-large">
          Compare our product lineup to find the best fit for your clinical needs.
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full bg-white rounded-xl border border-slate-200 overflow-hidden">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200">
              <th class="text-left p-4 font-semibold text-slate-900">Product</th>
              <th class="text-left p-4 font-semibold text-slate-900">Technology</th>
              <th class="text-left p-4 font-semibold text-slate-900">Primary Use</th>
              <th class="text-left p-4 font-semibold text-slate-900">Certifications</th>
              <th class="text-left p-4 font-semibold text-slate-900">Status</th>
            </tr>
          </thead>
          <tbody>
            {products.map((product) => (
              <tr class="border-b border-slate-100 last:border-0 hover:bg-slate-50">
                <td class="p-4">
                  <a href={`/products/${product.id}`} class="font-semibold text-primary-600 hover:text-primary-700">
                    {product.name}
                  </a>
                  <p class="text-xs text-slate-500">{product.model}</p>
                </td>
                <td class="p-4 text-sm text-slate-600">
                  {product.keyTechnologies?.[0]?.name.split(' ').slice(0, 3).join(' ') || '-'}
                </td>
                <td class="p-4 text-sm text-slate-600">
                  {product.indications?.[0]?.split(' - ')[0] || product.tagline}
                </td>
                <td class="p-4">
                  <div class="flex flex-wrap gap-1">
                    {product.certifications?.slice(0, 2).map((cert) => (
                      <span class:list={[
                        "text-xs font-medium px-2 py-0.5 rounded",
                        cert.status === 'Cleared' || cert.status === 'Approved' || cert.status === 'Certified'
                          ? "bg-green-50 text-green-700"
                          : "bg-slate-100 text-slate-600"
                      ]}>
                        {cert.name}
                      </span>
                    )) || <span class="text-xs text-slate-400">-</span>}
                  </div>
                </td>
                <td class="p-4">
                  <span class:list={[
                    "inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-full",
                    product.status === 'available'
                      ? "bg-green-50 text-green-700"
                      : "bg-amber-50 text-amber-700"
                  ]}>
                    {product.status === 'available' ? 'Available' : 'Coming Soon'}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section bg-primary-600">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">
          Need Help Choosing?
        </h2>
        <p class="text-lg text-primary-100 mb-8">
          Our team can help you find the perfect solution for your clinic's needs.
          Contact us for a personalized consultation.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-primary-600 bg-white hover:bg-primary-50 rounded-lg transition-colors"
          >
            Contact Sales Team
          </a>
          <a
            href="/certifications"
            class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white border border-white/30 hover:bg-white/10 rounded-lg transition-colors"
          >
            View Certifications
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
