---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Health Check">
  <div id="health-root">
    <div style="display:flex; align-items:center; justify-content:center; height:200px; color:#94a3b8;">
      Loading last report...
    </div>
  </div>

  <style>
    @keyframes spin { to { transform: rotate(360deg); } }
    .health-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; flex-wrap: wrap; gap: 12px; }
    .health-summary { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }
    .health-badge { padding: 6px 14px; border-radius: 8px; font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 6px; }
    .health-badge.pass { background: #dcfce7; color: #16a34a; }
    .health-badge.warn { background: #fef3c7; color: #d97706; }
    .health-badge.fail { background: #fee2e2; color: #dc2626; }
    .run-btn { padding: 10px 24px; font-size: 14px; font-weight: 600; color: #fff; background: #2563eb; border: none; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 8px; box-shadow: 0 1px 3px rgba(37,99,235,0.3); }
    .run-btn:hover { background: #1d4ed8; box-shadow: 0 2px 6px rgba(37,99,235,0.4); }
    .run-btn:disabled { background: #93c5fd; cursor: wait; box-shadow: none; }
    .export-btn { padding: 10px 20px; font-size: 13px; font-weight: 600; color: #334155; background: #fff; border: 1px solid #cbd5e1; border-radius: 8px; cursor: pointer; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
    .export-btn:hover { background: #f1f5f9; border-color: #94a3b8; }

    .category-section { background: #fff; border-radius: 12px; border: 1px solid #e2e8f0; margin-bottom: 16px; overflow: hidden; }
    .category-header { padding: 12px 20px; font-size: 13px; font-weight: 600; color: #0f172a; background: #f8fafc; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 8px; }
    .cat-count { font-size: 11px; font-weight: 500; padding: 2px 8px; border-radius: 10px; margin-left: auto; }
    .cat-count.all-pass { background: #dcfce7; color: #16a34a; }
    .cat-count.has-warn { background: #fef3c7; color: #d97706; }
    .cat-count.has-fail { background: #fee2e2; color: #dc2626; }

    .check-row { display: flex; align-items: center; padding: 10px 20px; border-bottom: 1px solid #f1f5f9; gap: 12px; font-size: 13px; cursor: pointer; transition: background 0.1s; }
    .check-row:last-of-type { border-bottom: none; }
    .check-row:hover { background: #f8fafc; }
    .check-row.row-warn { background: #fffbeb; }
    .check-row.row-warn:hover { background: #fef3c7; }
    .check-row.row-fail { background: #fef2f2; }
    .check-row.row-fail:hover { background: #fee2e2; }
    .check-icon { width: 18px; height: 18px; flex-shrink: 0; }
    .check-name { flex: 1; color: #334155; font-weight: 500; }
    .check-detail { color: #64748b; font-size: 12px; max-width: 320px; text-align: right; }
    .check-duration { color: #94a3b8; font-size: 11px; width: 55px; text-align: right; }
    .check-expand { display: none; padding: 10px 20px 10px 52px; background: #f8fafc; font-size: 12px; color: #64748b; line-height: 1.8; border-bottom: 1px solid #f1f5f9; }
    .check-expand.show { display: block; }
    .meta-line { font-size: 12px; color: #94a3b8; margin-top: 6px; }

    .empty-state { text-align: center; padding: 80px 20px; }
    .empty-icon { font-size: 48px; margin-bottom: 16px; opacity: 0.3; }
  </style>

  <script is:inline>
    const STATUS_ICONS = {
      pass: '<svg class="check-icon" viewBox="0 0 20 20" fill="#16a34a"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>',
      warn: '<svg class="check-icon" viewBox="0 0 20 20" fill="#d97706"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>',
      fail: '<svg class="check-icon" viewBox="0 0 20 20" fill="#dc2626"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>',
    };

    const CATEGORY_ICONS = {
      'Infrastructure': '\u{1F4E1}',
      'Environment': '\u{1F511}',
      'Data': '\u{1F4CA}',
      'External': '\u{1F517}',
    };

    let currentReport = null;

    async function loadLastReport() {
      try {
        const res = await fetch('/api/admin/health-check');
        if (!res.ok) return;
        const data = await res.json();
        if (data.results) {
          currentReport = data;
          renderReport(data);
        } else {
          renderEmpty();
        }
      } catch {
        renderEmpty();
      }
    }

    async function runHealthCheck() {
      const btn = document.getElementById('runBtn');
      if (btn) { btn.disabled = true; btn.innerHTML = '<span style="display:inline-block;width:16px;height:16px;border:2px solid #fff;border-top-color:transparent;border-radius:50%;animation:spin 1s linear infinite;"></span> Running...'; }

      try {
        const res = await fetch('/api/admin/health-check', { method: 'POST' });
        const data = await res.json();
        currentReport = data;
        renderReport(data);
      } catch {
        alert('Health check failed. Please try again.');
      } finally {
        if (btn) { btn.disabled = false; btn.innerHTML = 'Run Health Check'; }
      }
    }

    function exportReport() {
      if (!currentReport) return;
      const blob = new Blob([JSON.stringify(currentReport, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'health-report-' + new Date().toISOString().slice(0,10) + '.json';
      a.click();
      URL.revokeObjectURL(url);
    }

    function renderEmpty() {
      document.getElementById('health-root').innerHTML =
        '<div class="health-header">' +
          '<h2 style="font-size:18px; font-weight:600; color:#0f172a; margin:0;">System Health Check</h2>' +
          '<button id="runBtn" class="run-btn" onclick="runHealthCheck()">Run Health Check</button>' +
        '</div>' +
        '<div class="empty-state">' +
          '<div class="empty-icon">\u{1F6E1}</div>' +
          '<div style="font-size:15px; color:#64748b;">No health check has been run yet.</div>' +
          '<div style="font-size:13px; color:#94a3b8; margin-top:4px;">Click "Run Health Check" to scan all systems.</div>' +
        '</div>';
    }

    function renderReport(report) {
      // Group results by category
      var categories = {};
      for (var i = 0; i < report.results.length; i++) {
        var r = report.results[i];
        if (!categories[r.category]) categories[r.category] = [];
        categories[r.category].push(r);
      }

      // Header + summary badges + buttons
      var html =
        '<div class="health-header">' +
          '<div>' +
            '<h2 style="font-size:18px; font-weight:600; color:#0f172a; margin:0;">System Health Check</h2>' +
            '<div class="health-summary">' +
              '<span class="health-badge pass">' + report.summary.pass + ' Pass</span>' +
              '<span class="health-badge warn">' + report.summary.warn + ' Warn</span>' +
              '<span class="health-badge fail">' + report.summary.fail + ' Fail</span>' +
            '</div>' +
            '<div class="meta-line">Checked: ' + new Date(report.checkedAt).toLocaleString() + ' \u00B7 Duration: ' + report.duration + 'ms</div>' +
          '</div>' +
          '<div style="display:flex; gap:8px;">' +
            '<button class="export-btn" onclick="exportReport()">Export JSON</button>' +
            '<button id="runBtn" class="run-btn" onclick="runHealthCheck()">Run Health Check</button>' +
          '</div>' +
        '</div>';

      // Each category section with detailed rows
      var catKeys = Object.keys(categories);
      for (var ci = 0; ci < catKeys.length; ci++) {
        var cat = catKeys[ci];
        var checks = categories[cat];

        // Category-level summary
        var catFails = 0, catWarns = 0;
        for (var j = 0; j < checks.length; j++) {
          if (checks[j].status === 'fail') catFails++;
          if (checks[j].status === 'warn') catWarns++;
        }
        var catClass = catFails > 0 ? 'has-fail' : catWarns > 0 ? 'has-warn' : 'all-pass';
        var catLabel = catFails > 0 ? catFails + ' fail' : catWarns > 0 ? catWarns + ' warn' : 'All pass';

        html += '<div class="category-section">' +
          '<div class="category-header">' +
            (CATEGORY_ICONS[cat] || '\u{1F4CB}') + ' ' + escapeHtml(cat) +
            '<span class="cat-count ' + catClass + '">' + catLabel + '</span>' +
          '</div>';

        for (var k = 0; k < checks.length; k++) {
          var c = checks[k];
          var rowId = 'check-' + ci + '-' + k;
          var rowClass = c.status === 'warn' ? ' row-warn' : c.status === 'fail' ? ' row-fail' : '';

          html +=
            '<div class="check-row' + rowClass + '" onclick="document.getElementById(\'' + rowId + '\').classList.toggle(\'show\')">' +
              STATUS_ICONS[c.status] +
              '<span class="check-name">' + escapeHtml(c.name) + '</span>' +
              '<span class="check-detail">' + escapeHtml(c.detail) + '</span>' +
              (c.duration ? '<span class="check-duration">' + c.duration + 'ms</span>' : '<span class="check-duration"></span>') +
            '</div>' +
            '<div class="check-expand" id="' + rowId + '">' +
              '<strong>Status:</strong> ' + c.status.toUpperCase() + '<br>' +
              '<strong>Detail:</strong> ' + escapeHtml(c.detail) + '<br>' +
              (c.duration ? '<strong>Response time:</strong> ' + c.duration + 'ms<br>' : '') +
              (c.status === 'fail' ? '<strong>Fix:</strong> ' + getHint(c.name) : '') +
              (c.status === 'warn' ? '<strong>Note:</strong> ' + getHint(c.name) : '') +
            '</div>';
        }
        html += '</div>';
      }

      document.getElementById('health-root').innerHTML = html;
    }

    function getHint(name) {
      var hints = {
        'D1 Database': 'Check wrangler.jsonc d1_databases binding.',
        'KV Namespace': 'Check wrangler.jsonc kv_namespaces binding.',
        'R2 Bucket': 'R2 bucket is optional. Bind BLOG_IMAGES in wrangler.jsonc if needed.',
        'Claude API': 'Set ANTHROPIC_API_KEY in Cloudflare Dashboard > Settings > Environment Variables.',
        'GitHub API': 'Set GITHUB_TOKEN and GITHUB_REPO in Cloudflare Dashboard.',
        'Resend API': 'Set RESEND_API_KEY in Cloudflare Dashboard.',
      };
      if (name.startsWith('Table:')) return 'Run the migration SQL in D1 Console to create this table.';
      if (hints[name]) return hints[name];
      // Env var hints
      if (name === 'SLACK_WEBHOOK_URL') return 'Create a Slack Incoming Webhook and set this env var.';
      if (name.startsWith('TWITTER_')) return 'Set Twitter/X API credentials in Cloudflare Dashboard.';
      if (name.startsWith('LINKEDIN_')) return 'Set LinkedIn OAuth credentials in Cloudflare Dashboard.';
      if (name.startsWith('INSTAGRAM_')) return 'Set Instagram Graph API credentials in Cloudflare Dashboard.';
      return 'Set this environment variable in Cloudflare Dashboard > Settings > Environment Variables.';
    }

    function escapeHtml(str) {
      var d = document.createElement('div');
      d.textContent = str || '';
      return d.innerHTML;
    }

    loadLastReport();
  </script>
</AdminLayout>
