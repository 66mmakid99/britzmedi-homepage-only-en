---
// Server-side rendering for authentication
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';

// This page requires authentication via middleware
---

<AdminLayout title="Lead Dashboard">
  <div class="min-h-screen bg-slate-100">
    <!-- Page Header -->
    <header class="bg-white border-b border-slate-200">
      <div class="container py-6">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-2xl font-bold text-slate-900">Lead Dashboard</h1>
            <p class="text-sm text-slate-500">Manage and track incoming leads</p>
          </div>
          <div class="flex items-center gap-3">
            <button
              id="refresh-btn"
              class="px-4 py-2 text-sm font-medium text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors"
            >
              <svg class="w-4 h-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              Refresh
            </button>
            <a
              href="/contact"
              target="_blank"
              class="px-4 py-2 text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 rounded-lg transition-colors"
            >
              Test Lead Form
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Stats Cards -->
    <section class="container py-6">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card-premium p-6">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div>
              <p class="text-2xl font-bold text-slate-900" id="stat-total">0</p>
              <p class="text-sm text-slate-500">Total Leads</p>
            </div>
          </div>
        </div>

        <div class="card-premium p-6">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center">
              <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
              </svg>
            </div>
            <div>
              <p class="text-2xl font-bold text-slate-900" id="stat-hot">0</p>
              <p class="text-sm text-slate-500">Hot Leads (A)</p>
            </div>
          </div>
        </div>

        <div class="card-premium p-6">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-amber-100 flex items-center justify-center">
              <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="text-2xl font-bold text-slate-900" id="stat-new">0</p>
              <p class="text-sm text-slate-500">New (Today)</p>
            </div>
          </div>
        </div>

        <div class="card-premium p-6">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <div>
              <p class="text-2xl font-bold text-slate-900" id="stat-avg-score">0</p>
              <p class="text-sm text-slate-500">Avg Score</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Filters -->
    <section class="container pb-6">
      <div class="card-premium p-4">
        <div class="flex flex-wrap items-center gap-4">
          <div class="flex items-center gap-2">
            <label class="text-sm font-medium text-slate-700">Grade:</label>
            <select id="filter-grade" class="px-3 py-2 text-sm border border-slate-200 rounded-lg bg-white text-slate-700">
              <option value="">All</option>
              <option value="A">A - Hot</option>
              <option value="B">B - Warm</option>
              <option value="C">C - Cool</option>
              <option value="D">D - Cold</option>
            </select>
          </div>

          <div class="flex items-center gap-2">
            <label class="text-sm font-medium text-slate-700">Status:</label>
            <select id="filter-status" class="px-3 py-2 text-sm border border-slate-200 rounded-lg bg-white text-slate-700">
              <option value="">All</option>
              <option value="new">New</option>
              <option value="contacted">Contacted</option>
              <option value="qualified">Qualified</option>
              <option value="proposal">Proposal</option>
              <option value="won">Won</option>
              <option value="lost">Lost</option>
            </select>
          </div>

          <div class="flex-1"></div>

          <div class="flex items-center gap-2">
            <input
              type="search"
              id="search-input"
              placeholder="Search leads..."
              class="px-4 py-2 text-sm border border-slate-200 rounded-lg bg-white text-slate-700 w-64"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Leads Table -->
    <section class="container pb-12">
      <div class="card-premium overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-slate-50 border-b border-slate-200">
              <tr>
                <th class="text-left px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Lead</th>
                <th class="text-left px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Company</th>
                <th class="text-left px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Country</th>
                <th class="text-left px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Products</th>
                <th class="text-center px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Score</th>
                <th class="text-left px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
                <th class="text-left px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Date</th>
                <th class="text-center px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody id="leads-table-body" class="divide-y divide-slate-200">
              <!-- Leads will be populated by JavaScript -->
              <tr>
                <td colspan="8" class="px-6 py-12 text-center text-slate-500">
                  <div class="flex flex-col items-center gap-3">
                    <svg class="w-12 h-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                    <p class="font-medium">No leads yet</p>
                    <p class="text-sm">Leads from the contact form will appear here</p>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
</AdminLayout>

<script>
  // Lead dashboard functionality with API integration
  interface Lead {
    id: number;
    company_name: string;
    company_website?: string;
    contact_name: string;
    job_title: string;
    email: string;
    country: string;
    interested_products: string;
    message?: string;
    lead_score: number;
    lead_grade: string;
    status: string;
    created_at: string;
    ai_research?: string;
  }

  interface Stats {
    total: number;
    hot: number;
    newToday: number;
    avgScore: number;
  }

  let allLeads: Lead[] = [];
  let isLoading = false;

  // Fetch leads from API
  async function fetchLeads(): Promise<Lead[]> {
    try {
      const params = new URLSearchParams();
      const gradeFilter = document.getElementById('filter-grade') as HTMLSelectElement;
      const statusFilter = document.getElementById('filter-status') as HTMLSelectElement;
      const searchInput = document.getElementById('search-input') as HTMLInputElement;

      if (gradeFilter?.value) params.set('grade', gradeFilter.value);
      if (statusFilter?.value) params.set('status', statusFilter.value);
      if (searchInput?.value) params.set('search', searchInput.value);

      const response = await fetch(`/api/leads?${params.toString()}`);
      if (!response.ok) throw new Error('Failed to fetch leads');

      const data = await response.json();
      return data.leads || [];
    } catch (error) {
      console.error('Error fetching leads:', error);
      return [];
    }
  }

  // Fetch stats from API
  async function fetchStats(): Promise<Stats> {
    try {
      const response = await fetch('/api/leads/stats');
      if (!response.ok) throw new Error('Failed to fetch stats');

      const data = await response.json();
      return {
        total: data.total || 0,
        hot: data.hot || 0,
        newToday: data.newToday || 0,
        avgScore: data.avgScore || 0,
      };
    } catch (error) {
      console.error('Error fetching stats:', error);
      return { total: 0, hot: 0, newToday: 0, avgScore: 0 };
    }
  }

  // Update status via API
  async function updateLeadStatus(leadId: number, newStatus: string): Promise<boolean> {
    try {
      const response = await fetch(`/api/leads/${leadId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: newStatus }),
      });
      return response.ok;
    } catch (error) {
      console.error('Error updating lead:', error);
      return false;
    }
  }

  function renderLeads(leads: Lead[]) {
    const tbody = document.getElementById('leads-table-body');
    if (!tbody) return;

    if (leads.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="8" class="px-6 py-12 text-center text-slate-500">
            <div class="flex flex-col items-center gap-3">
              <svg class="w-12 h-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
              <p class="font-medium">No leads found</p>
              <p class="text-sm">Leads from the contact form will appear here</p>
            </div>
          </td>
        </tr>
      `;
      return;
    }

    const gradeColors: Record<string, string> = {
      A: 'bg-green-100 text-green-700',
      B: 'bg-amber-100 text-amber-700',
      C: 'bg-blue-100 text-blue-700',
      D: 'bg-slate-100 text-slate-700'
    };
    const statusColors: Record<string, string> = {
      new: 'bg-blue-100 text-blue-700',
      contacted: 'bg-amber-100 text-amber-700',
      qualified: 'bg-purple-100 text-purple-700',
      proposal: 'bg-indigo-100 text-indigo-700',
      won: 'bg-green-100 text-green-700',
      lost: 'bg-red-100 text-red-700'
    };

    tbody.innerHTML = leads.map(lead => {
      let products: string[] = [];
      try {
        products = typeof lead.interested_products === 'string'
          ? JSON.parse(lead.interested_products)
          : lead.interested_products || [];
      } catch { products = []; }

      return `
        <tr class="hover:bg-slate-50 transition-colors" data-lead-id="${lead.id}">
          <td class="px-6 py-4">
            <div>
              <p class="font-medium text-slate-900">${escapeHtml(lead.contact_name)}</p>
              <p class="text-sm text-slate-500">${escapeHtml(lead.job_title)}</p>
              <a href="mailto:${escapeHtml(lead.email)}" class="text-sm text-primary-600 hover:underline">${escapeHtml(lead.email)}</a>
            </div>
          </td>
          <td class="px-6 py-4">
            <div>
              <p class="font-medium text-slate-900">${escapeHtml(lead.company_name)}</p>
              ${lead.company_website ? `<a href="${escapeHtml(lead.company_website)}" target="_blank" rel="noopener" class="text-sm text-primary-600 hover:underline">Website</a>` : ''}
            </div>
          </td>
          <td class="px-6 py-4">
            <span class="text-sm font-medium">${escapeHtml(lead.country)}</span>
          </td>
          <td class="px-6 py-4">
            <div class="flex flex-wrap gap-1">
              ${products.map(p => `<span class="px-2 py-0.5 text-xs bg-slate-100 rounded">${escapeHtml(p)}</span>`).join('')}
            </div>
          </td>
          <td class="px-6 py-4 text-center">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-sm font-semibold rounded-full ${gradeColors[lead.lead_grade] || gradeColors.D}">
              ${lead.lead_score}
              <span class="text-xs">(${lead.lead_grade})</span>
            </span>
          </td>
          <td class="px-6 py-4">
            <select
              class="status-select px-2.5 py-1 text-xs font-medium rounded-full border-0 cursor-pointer ${statusColors[lead.status] || statusColors.new}"
              data-lead-id="${lead.id}"
              data-current-status="${lead.status}"
            >
              <option value="new" ${lead.status === 'new' ? 'selected' : ''}>New</option>
              <option value="contacted" ${lead.status === 'contacted' ? 'selected' : ''}>Contacted</option>
              <option value="qualified" ${lead.status === 'qualified' ? 'selected' : ''}>Qualified</option>
              <option value="proposal" ${lead.status === 'proposal' ? 'selected' : ''}>Proposal</option>
              <option value="won" ${lead.status === 'won' ? 'selected' : ''}>Won</option>
              <option value="lost" ${lead.status === 'lost' ? 'selected' : ''}>Lost</option>
            </select>
          </td>
          <td class="px-6 py-4 text-sm text-slate-500">
            ${new Date(lead.created_at).toLocaleDateString()}
          </td>
          <td class="px-6 py-4">
            <div class="flex items-center justify-center gap-1">
              <button
                class="research-btn p-2 rounded-lg transition-colors ${lead.ai_research ? 'text-green-500 hover:text-green-700 hover:bg-green-50' : 'text-slate-400 hover:text-violet-600 hover:bg-violet-50'}"
                data-lead-id="${lead.id}"
                data-has-research="${lead.ai_research ? 'true' : 'false'}"
                title="${lead.ai_research ? 'View AI Research' : 'Run AI Research'}"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
              </button>
              <a href="mailto:${escapeHtml(lead.email)}" class="p-2 text-slate-400 hover:text-slate-600 rounded-lg hover:bg-slate-100" title="Send Email">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </a>
              ${lead.company_website ? `
              <a href="${escapeHtml(lead.company_website)}" target="_blank" rel="noopener" class="p-2 text-slate-400 hover:text-slate-600 rounded-lg hover:bg-slate-100" title="Visit Website">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>` : ''}
            </div>
          </td>
        </tr>
      `;
    }).join('');

    // Add status change handlers
    document.querySelectorAll('.status-select').forEach(select => {
      select.addEventListener('change', async (e) => {
        const target = e.target as HTMLSelectElement;
        const leadId = parseInt(target.dataset.leadId || '0');
        const newStatus = target.value;
        const oldStatus = target.dataset.currentStatus || '';

        target.disabled = true;
        const success = await updateLeadStatus(leadId, newStatus);

        if (success) {
          target.dataset.currentStatus = newStatus;
          // Update colors
          const statusColors: Record<string, string> = {
            new: 'bg-blue-100 text-blue-700',
            contacted: 'bg-amber-100 text-amber-700',
            qualified: 'bg-purple-100 text-purple-700',
            proposal: 'bg-indigo-100 text-indigo-700',
            won: 'bg-green-100 text-green-700',
            lost: 'bg-red-100 text-red-700'
          };
          target.className = `status-select px-2.5 py-1 text-xs font-medium rounded-full border-0 cursor-pointer ${statusColors[newStatus]}`;
        } else {
          target.value = oldStatus;
          alert('Failed to update status');
        }
        target.disabled = false;
      });
    });
  }

  function updateStats(stats: Stats) {
    const statTotal = document.getElementById('stat-total');
    const statHot = document.getElementById('stat-hot');
    const statNew = document.getElementById('stat-new');
    const statAvg = document.getElementById('stat-avg-score');

    if (statTotal) statTotal.textContent = stats.total.toString();
    if (statHot) statHot.textContent = stats.hot.toString();
    if (statNew) statNew.textContent = stats.newToday.toString();
    if (statAvg) statAvg.textContent = stats.avgScore.toString();
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text || '';
    return div.innerHTML;
  }

  function showLoading(show: boolean) {
    const tbody = document.getElementById('leads-table-body');
    if (!tbody) return;

    if (show) {
      tbody.innerHTML = `
        <tr>
          <td colspan="8" class="px-6 py-12 text-center text-slate-500">
            <div class="flex items-center justify-center gap-2">
              <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span>Loading leads...</span>
            </div>
          </td>
        </tr>
      `;
    }
  }

  // Load data
  async function loadData() {
    if (isLoading) return;
    isLoading = true;
    showLoading(true);

    const [leads, stats] = await Promise.all([fetchLeads(), fetchStats()]);
    allLeads = leads;
    renderLeads(leads);
    updateStats(stats);

    isLoading = false;
  }

  // Filter handlers with debounce
  let filterTimeout: number;
  function applyFilters() {
    clearTimeout(filterTimeout);
    filterTimeout = window.setTimeout(loadData, 300);
  }

  const gradeFilter = document.getElementById('filter-grade') as HTMLSelectElement;
  const statusFilter = document.getElementById('filter-status') as HTMLSelectElement;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;

  gradeFilter?.addEventListener('change', applyFilters);
  statusFilter?.addEventListener('change', applyFilters);
  searchInput?.addEventListener('input', applyFilters);

  // Refresh button
  document.getElementById('refresh-btn')?.addEventListener('click', loadData);

  // --- AI Research Panel ---
  const researchCache = new Map<number, any>();

  async function runResearch(leadId: number): Promise<any> {
    const response = await fetch('/api/admin/leads/research', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ leadId }),
    });
    const data = await response.json();
    if (!response.ok) throw new Error(data.error || 'Research failed');
    return data.research;
  }

  function renderResearchPanel(research: any): string {
    const fitColor = research.partnershipFitScore >= 7 ? 'text-green-600 bg-green-100'
      : research.partnershipFitScore >= 4 ? 'text-amber-600 bg-amber-100'
      : 'text-red-600 bg-red-100';

    return `
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-xs text-slate-400">Researched: ${new Date(research.researchedAt).toLocaleString()}</span>
          <span class="px-2.5 py-1 text-sm font-bold rounded-full ${fitColor}">Fit: ${research.partnershipFitScore}/10</span>
        </div>
        <p class="text-sm text-slate-700 font-medium">${escapeHtml(research.summary)}</p>
        <div class="grid grid-cols-1 gap-3 text-sm">
          <div><span class="font-medium text-slate-500">Company Size:</span> <span class="text-slate-800">${escapeHtml(research.companySize)}</span></div>
          <div><span class="font-medium text-slate-500">Est. Revenue:</span> <span class="text-slate-800">${escapeHtml(research.estimatedRevenue)}</span></div>
          <div><span class="font-medium text-slate-500">Main Business:</span> <span class="text-slate-800">${escapeHtml(research.mainBusiness)}</span></div>
          <div><span class="font-medium text-slate-500">Device Relevance:</span> <span class="text-slate-800">${escapeHtml(research.aestheticDeviceRelevance)}</span></div>
          <div><span class="font-medium text-slate-500">Competitor Equipment:</span> <span class="text-slate-800">${escapeHtml(research.competitorEquipment)}</span></div>
          <div><span class="font-medium text-slate-500">Decision Makers:</span> <span class="text-slate-800">${escapeHtml(research.decisionMakers)}</span></div>
        </div>
      </div>
    `;
  }

  function showResearchModal(leadId: number, lead: Lead) {
    // Remove existing modal
    document.getElementById('research-modal')?.remove();

    const existing = lead.ai_research ? JSON.parse(lead.ai_research) : researchCache.get(leadId);
    const hasExisting = !!existing;

    const modal = document.createElement('div');
    modal.id = 'research-modal';
    modal.className = 'fixed inset-0 z-50 flex items-center justify-center p-4';
    modal.innerHTML = `
      <div class="absolute inset-0 bg-black/40" id="research-backdrop"></div>
      <div class="relative bg-white rounded-xl shadow-2xl w-full max-w-lg max-h-[80vh] overflow-auto p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-bold text-slate-900">AI Research: ${escapeHtml(lead.company_name)}</h3>
          <button id="close-research" class="p-1 text-slate-400 hover:text-slate-600 rounded">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <div id="research-content">
          ${hasExisting ? renderResearchPanel(existing) : '<p class="text-sm text-slate-500">No research yet. Click below to run AI analysis.</p>'}
        </div>
        <div class="mt-4 flex gap-2">
          <button id="run-research-btn" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-violet-600 hover:bg-violet-700 rounded-lg transition-colors">
            ${hasExisting ? 'Re-research' : 'Run AI Research'}
          </button>
        </div>
      </div>
    `;
    document.body.appendChild(modal);

    document.getElementById('research-backdrop')?.addEventListener('click', () => modal.remove());
    document.getElementById('close-research')?.addEventListener('click', () => modal.remove());

    document.getElementById('run-research-btn')?.addEventListener('click', async () => {
      const btn = document.getElementById('run-research-btn') as HTMLButtonElement;
      const content = document.getElementById('research-content')!;
      btn.disabled = true;
      btn.textContent = 'Researching...';
      content.innerHTML = '<div class="flex items-center gap-2 text-sm text-slate-500"><svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>AI is analyzing this company... (10-20 seconds)</div>';

      try {
        const research = await runResearch(leadId);
        researchCache.set(leadId, research);
        content.innerHTML = renderResearchPanel(research);
        btn.textContent = 'Re-research';
        // Update the button icon color in the table
        const tableBtn = document.querySelector(`.research-btn[data-lead-id="${leadId}"]`) as HTMLButtonElement;
        if (tableBtn) {
          tableBtn.classList.remove('text-slate-400');
          tableBtn.classList.add('text-green-500');
          tableBtn.dataset.hasResearch = 'true';
        }
      } catch (err: any) {
        content.innerHTML = `<p class="text-sm text-red-600">Error: ${escapeHtml(err.message)}</p>`;
        btn.textContent = 'Retry';
      }
      btn.disabled = false;
    });
  }

  // Attach research button handlers after render
  function attachResearchHandlers() {
    document.querySelectorAll('.research-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const leadId = parseInt(target.dataset.leadId || '0');
        const lead = allLeads.find(l => l.id === leadId);
        if (lead) showResearchModal(leadId, lead);
      });
    });
  }

  // Patch renderLeads to attach research handlers after DOM update
  const _originalRenderLeads = renderLeads;
  renderLeads = function(leads: Lead[]) {
    _originalRenderLeads(leads);
    attachResearchHandlers();
  };

  // Initial load
  loadData();
</script>
