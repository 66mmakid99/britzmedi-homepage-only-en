---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';

const tab = Astro.url.searchParams.get('tab') || 'health';
---

<AdminLayout title="System">
  <div class="max-w-7xl mx-auto">
    <div class="flex items-center gap-1 mb-6 bg-white rounded-xl border border-slate-200 p-1 w-fit">
      <button class={`sys-tab ${tab === 'health' ? 'active' : ''}`} data-tab="health" onclick="switchSysTab('health')">Health Check</button>
      <button class={`sys-tab ${tab === 'activity' ? 'active' : ''}`} data-tab="activity" onclick="switchSysTab('activity')">Activity Log</button>
    </div>

    <div id="sys-health" style={tab !== 'health' ? 'display:none' : ''}>
      <div id="health-root">
        <div style="display:flex; align-items:center; justify-content:center; height:200px; color:#94a3b8;">Loading last report...</div>
      </div>
    </div>

    <div id="sys-activity" style={tab !== 'activity' ? 'display:none' : ''}>
      <div id="activity-root">
        <div style="display:flex; align-items:center; justify-content:center; height:200px;">
          <div style="width:32px; height:32px; border:3px solid #2563eb; border-top-color:transparent; border-radius:50%; animation:spin 1s linear infinite;"></div>
        </div>
      </div>
    </div>
  </div>

  <style is:global>
    @keyframes spin { to { transform: rotate(360deg); } }
    .sys-tab { padding: 8px 16px; font-size: 14px; font-weight: 500; border-radius: 8px; border: none; background: transparent; color: #64748b; cursor: pointer; transition: all 0.15s; }
    .sys-tab:hover { color: #0f172a; background: #f1f5f9; }
    .sys-tab.active { background: #0f172a; color: #fff; }

    .health-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; flex-wrap: wrap; gap: 12px; }
    .health-summary { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }
    .health-badge { padding: 6px 14px; border-radius: 8px; font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 6px; }
    .health-badge.pass { background: #dcfce7; color: #16a34a; }
    .health-badge.warn { background: #fef3c7; color: #d97706; }
    .health-badge.fail { background: #fee2e2; color: #dc2626; }
    .run-btn { padding: 10px 24px; font-size: 14px; font-weight: 600; color: #fff; background: #2563eb; border: none; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 8px; box-shadow: 0 1px 3px rgba(37,99,235,0.3); }
    .run-btn:hover { background: #1d4ed8; }
    .run-btn:disabled { background: #93c5fd; cursor: wait; }
    .export-btn { padding: 10px 20px; font-size: 13px; font-weight: 600; color: #334155; background: #fff; border: 1px solid #cbd5e1; border-radius: 8px; cursor: pointer; }
    .export-btn:hover { background: #f1f5f9; }
    .category-section { background: #fff; border-radius: 12px; border: 1px solid #e2e8f0; margin-bottom: 16px; overflow: hidden; }
    .category-header { padding: 12px 20px; font-size: 13px; font-weight: 600; color: #0f172a; background: #f8fafc; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 8px; }
    .cat-count { font-size: 11px; font-weight: 500; padding: 2px 8px; border-radius: 10px; margin-left: auto; }
    .cat-count.all-pass { background: #dcfce7; color: #16a34a; }
    .cat-count.has-warn { background: #fef3c7; color: #d97706; }
    .cat-count.has-fail { background: #fee2e2; color: #dc2626; }
    .check-row { display: flex; align-items: center; padding: 10px 20px; border-bottom: 1px solid #f1f5f9; gap: 12px; font-size: 13px; cursor: pointer; transition: background 0.1s; }
    .check-row:last-of-type { border-bottom: none; }
    .check-row:hover { background: #f8fafc; }
    .check-row.row-warn { background: #fffbeb; }
    .check-row.row-fail { background: #fef2f2; }
    .check-icon { width: 18px; height: 18px; flex-shrink: 0; }
    .check-name { flex: 1; color: #334155; font-weight: 500; }
    .check-detail { color: #64748b; font-size: 12px; max-width: 320px; text-align: right; }
    .check-duration { color: #94a3b8; font-size: 11px; width: 55px; text-align: right; }
    .check-expand { display: none; padding: 10px 20px 10px 52px; background: #f8fafc; font-size: 12px; color: #64748b; line-height: 1.8; border-bottom: 1px solid #f1f5f9; }
    .check-expand.show { display: block; }
    .meta-line { font-size: 12px; color: #94a3b8; margin-top: 6px; }
    .empty-state { text-align: center; padding: 80px 20px; }

    .act-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 12px; }
    .act-filters { display: flex; gap: 8px; flex-wrap: wrap; }
    .act-filter-btn { padding: 6px 14px; font-size: 12px; font-weight: 500; border-radius: 6px; border: 1px solid #e2e8f0; background: #fff; color: #64748b; cursor: pointer; }
    .act-filter-btn.active { background: #2563eb; color: #fff; border-color: #2563eb; }
    .act-filter-btn:hover:not(.active) { background: #f8fafc; }
    .act-select { padding: 6px 10px; font-size: 12px; border-radius: 6px; border: 1px solid #e2e8f0; background: #fff; color: #334155; }
    .act-refresh { padding: 6px 14px; font-size: 12px; font-weight: 500; border-radius: 6px; border: 1px solid #e2e8f0; background: #fff; color: #64748b; cursor: pointer; display: flex; align-items: center; gap: 4px; }
    .act-refresh:hover { background: #f8fafc; }
    .timeline { background: #fff; border-radius: 12px; border: 1px solid #e2e8f0; overflow: hidden; }
    .timeline-item { display: flex; align-items: flex-start; gap: 12px; padding: 14px 20px; border-bottom: 1px solid #f1f5f9; }
    .timeline-item:last-child { border-bottom: none; }
    .timeline-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 14px; }
    .timeline-body { flex: 1; min-width: 0; }
    .timeline-text { font-size: 13px; color: #334155; line-height: 1.5; }
    .timeline-meta { font-size: 11px; color: #94a3b8; margin-top: 2px; display: flex; gap: 12px; }
  </style>

  <script is:inline>
    // ═══ Tab Switching ═══
    function switchSysTab(tab) {
      document.getElementById('sys-health').style.display = tab === 'health' ? '' : 'none';
      document.getElementById('sys-activity').style.display = tab === 'activity' ? '' : 'none';
      document.querySelectorAll('.sys-tab').forEach(t => t.classList.toggle('active', t.dataset.tab === tab));
      if (tab === 'activity' && !activityLoaded) { activityLoaded = true; loadActivities(); }
    }

    // ═══ Health Check ═══
    var STATUS_ICONS = {
      pass: '<svg class="check-icon" viewBox="0 0 20 20" fill="#16a34a"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>',
      warn: '<svg class="check-icon" viewBox="0 0 20 20" fill="#d97706"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>',
      fail: '<svg class="check-icon" viewBox="0 0 20 20" fill="#dc2626"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>',
    };
    var CATEGORY_ICONS = { 'Infrastructure': '\u{1F4E1}', 'Environment': '\u{1F511}', 'Data': '\u{1F4CA}', 'External': '\u{1F517}' };
    var currentReport = null;

    async function loadLastReport() {
      try {
        var res = await fetch('/api/admin/health-check');
        if (!res.ok) return;
        var data = await res.json();
        if (data.results) { currentReport = data; renderReport(data); } else { renderEmpty(); }
      } catch { renderEmpty(); }
    }

    async function runHealthCheck() {
      var btn = document.getElementById('runBtn');
      if (btn) { btn.disabled = true; btn.innerHTML = '<span style="display:inline-block;width:16px;height:16px;border:2px solid #fff;border-top-color:transparent;border-radius:50%;animation:spin 1s linear infinite;"></span> Running...'; }
      try { var res = await fetch('/api/admin/health-check', { method: 'POST' }); var data = await res.json(); currentReport = data; renderReport(data); } catch { alert('Health check failed.'); }
      finally { if (btn) { btn.disabled = false; btn.innerHTML = 'Run Health Check'; } }
    }

    function exportReport() {
      if (!currentReport) return;
      var blob = new Blob([JSON.stringify(currentReport, null, 2)], { type: 'application/json' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a'); a.href = url; a.download = 'health-report-' + new Date().toISOString().slice(0,10) + '.json'; a.click();
      URL.revokeObjectURL(url);
    }

    function renderEmpty() {
      document.getElementById('health-root').innerHTML =
        '<div class="health-header"><h2 style="font-size:18px; font-weight:600; color:#0f172a; margin:0;">System Health Check</h2>' +
        '<button id="runBtn" class="run-btn" onclick="runHealthCheck()">Run Health Check</button></div>' +
        '<div class="empty-state"><div style="font-size:48px; margin-bottom:16px; opacity:0.3;">\u{1F6E1}</div>' +
        '<div style="font-size:15px; color:#64748b;">No health check has been run yet.</div>' +
        '<div style="font-size:13px; color:#94a3b8; margin-top:4px;">Click "Run Health Check" to scan all systems.</div></div>';
    }

    function renderReport(report) {
      var categories = {};
      for (var i = 0; i < report.results.length; i++) { var r = report.results[i]; if (!categories[r.category]) categories[r.category] = []; categories[r.category].push(r); }
      var html = '<div class="health-header"><div><h2 style="font-size:18px; font-weight:600; color:#0f172a; margin:0;">System Health Check</h2>' +
        '<div class="health-summary"><span class="health-badge pass">' + report.summary.pass + ' Pass</span><span class="health-badge warn">' + report.summary.warn + ' Warn</span><span class="health-badge fail">' + report.summary.fail + ' Fail</span></div>' +
        '<div class="meta-line">Checked: ' + new Date(report.checkedAt).toLocaleString() + ' \u00B7 Duration: ' + report.duration + 'ms</div></div>' +
        '<div style="display:flex; gap:8px;"><button class="export-btn" onclick="exportReport()">Export JSON</button><button id="runBtn" class="run-btn" onclick="runHealthCheck()">Run Health Check</button></div></div>';
      var catKeys = Object.keys(categories);
      for (var ci = 0; ci < catKeys.length; ci++) {
        var cat = catKeys[ci]; var checks = categories[cat];
        var catFails = 0, catWarns = 0;
        for (var j = 0; j < checks.length; j++) { if (checks[j].status === 'fail') catFails++; if (checks[j].status === 'warn') catWarns++; }
        var catClass = catFails > 0 ? 'has-fail' : catWarns > 0 ? 'has-warn' : 'all-pass';
        var catLabel = catFails > 0 ? catFails + ' fail' : catWarns > 0 ? catWarns + ' warn' : 'All pass';
        html += '<div class="category-section"><div class="category-header">' + (CATEGORY_ICONS[cat] || '\u{1F4CB}') + ' ' + escapeHtml(cat) + '<span class="cat-count ' + catClass + '">' + catLabel + '</span></div>';
        for (var k = 0; k < checks.length; k++) {
          var c = checks[k]; var rowId = 'check-' + ci + '-' + k;
          var rowClass = c.status === 'warn' ? ' row-warn' : c.status === 'fail' ? ' row-fail' : '';
          html += '<div class="check-row' + rowClass + '" onclick="document.getElementById(\'' + rowId + '\').classList.toggle(\'show\')">' + STATUS_ICONS[c.status] + '<span class="check-name">' + escapeHtml(c.name) + '</span><span class="check-detail">' + escapeHtml(c.detail) + '</span>' + (c.duration ? '<span class="check-duration">' + c.duration + 'ms</span>' : '<span class="check-duration"></span>') + '</div>' +
            '<div class="check-expand" id="' + rowId + '"><strong>Status:</strong> ' + c.status.toUpperCase() + '<br><strong>Detail:</strong> ' + escapeHtml(c.detail) + '<br>' + (c.duration ? '<strong>Response time:</strong> ' + c.duration + 'ms<br>' : '') + '</div>';
        }
        html += '</div>';
      }
      document.getElementById('health-root').innerHTML = html;
    }

    // ═══ Activity Log ═══
    var TYPE_CONFIG = {
      lead_created:{ icon:'\u{1F464}', bg:'#dcfce7', label:'Lead Created' }, lead_updated:{ icon:'\u{270F}\u{FE0F}', bg:'#dbeafe', label:'Lead Updated' },
      subscriber_added:{ icon:'\u{1F4E7}', bg:'#dbeafe', label:'Subscriber Added' }, blog_published:{ icon:'\u{1F4DD}', bg:'#ede9fe', label:'Blog Published' },
      blog_created:{ icon:'\u{270D}\u{FE0F}', bg:'#ede9fe', label:'Blog Created' }, social_posted:{ icon:'\u{1F4F1}', bg:'#fef3c7', label:'Social Posted' },
      social_failed:{ icon:'\u{26A0}\u{FE0F}', bg:'#fee2e2', label:'Social Failed' }, resource_downloaded:{ icon:'\u{1F4E5}', bg:'#ccfbf1', label:'Resource Downloaded' },
      admin_login:{ icon:'\u{1F510}', bg:'#f1f5f9', label:'Admin Login' }, admin_logout:{ icon:'\u{1F513}', bg:'#f1f5f9', label:'Admin Logout' },
      ai_research:{ icon:'\u{1F52C}', bg:'#fce7f3', label:'AI Research' }, health_check:{ icon:'\u{1FA7A}', bg:'#cffafe', label:'Health Check' },
      content_transition:{ icon:'\u{1F504}', bg:'#ede9fe', label:'Content Transition' },
    };
    var currentPeriod = 'all'; var currentType = ''; var activityLoaded = false;

    async function loadActivities() {
      var root = document.getElementById('activity-root');
      try {
        var params = new URLSearchParams();
        if (currentPeriod !== 'all') params.set('period', currentPeriod);
        if (currentType) params.set('type', currentType);
        params.set('limit', '100');
        var res = await fetch('/api/admin/activity?' + params.toString());
        if (!res.ok) throw new Error();
        var data = await res.json();
        renderActivities(data.activities || []);
      } catch { root.innerHTML = '<div class="empty-state">Failed to load. <button onclick="loadActivities()" style="color:#2563eb; background:none; border:none; cursor:pointer;">Retry</button></div>'; }
    }

    function renderActivities(activities) {
      var root = document.getElementById('activity-root');
      var typeOptions = Object.entries(TYPE_CONFIG).map(function(e) { return '<option value="' + e[0] + '"' + (currentType === e[0] ? ' selected' : '') + '>' + e[1].label + '</option>'; }).join('');
      var html = '<div class="act-header"><h2 style="font-size:18px; font-weight:600; color:#0f172a; margin:0;">Activity Log</h2><div class="act-filters">' +
        '<button class="act-filter-btn ' + (currentPeriod==='all'?'active':'') + '" onclick="setPeriod(\'all\')">All</button>' +
        '<button class="act-filter-btn ' + (currentPeriod==='today'?'active':'') + '" onclick="setPeriod(\'today\')">Today</button>' +
        '<button class="act-filter-btn ' + (currentPeriod==='week'?'active':'') + '" onclick="setPeriod(\'week\')">This Week</button>' +
        '<button class="act-filter-btn ' + (currentPeriod==='month'?'active':'') + '" onclick="setPeriod(\'month\')">This Month</button>' +
        '<select class="act-select" onchange="setType(this.value)"><option value="">All Types</option>' + typeOptions + '</select>' +
        '<button class="act-refresh" onclick="loadActivities()">\u{21BB} Refresh</button></div></div>';
      if (activities.length === 0) {
        html += '<div class="empty-state"><div style="font-size:36px; margin-bottom:12px;">\u{1F4CB}</div><div>No activities found.</div></div>';
      } else {
        html += '<div class="timeline">';
        for (var i = 0; i < activities.length; i++) {
          var a = activities[i]; var cfg = TYPE_CONFIG[a.type] || { icon:'\u{1F4CB}', bg:'#f1f5f9', label:a.type };
          html += '<div class="timeline-item"><div class="timeline-icon" style="background:' + cfg.bg + '">' + cfg.icon + '</div><div class="timeline-body"><div class="timeline-text">' + escapeHtml(a.detail) + '</div><div class="timeline-meta"><span>' + cfg.label + '</span><span>' + timeAgo(a.created_at) + '</span>' + (a.ip ? '<span>IP: ' + escapeHtml(a.ip) + '</span>' : '') + '</div></div></div>';
        }
        html += '</div>';
      }
      root.innerHTML = html;
    }

    function setPeriod(p) { currentPeriod = p; loadActivities(); }
    function setType(t) { currentType = t; loadActivities(); }

    // ═══ Shared ═══
    function escapeHtml(str) { var d = document.createElement('div'); d.textContent = str || ''; return d.innerHTML; }
    function timeAgo(dateStr) {
      if (!dateStr) return '';
      var now = new Date(); var date = new Date(dateStr + 'Z'); var diff = Math.floor((now - date) / 1000);
      if (diff < 60) return 'just now'; if (diff < 3600) return Math.floor(diff / 60) + 'm ago';
      if (diff < 86400) return Math.floor(diff / 3600) + 'h ago'; var d = Math.floor(diff / 86400);
      return d === 1 ? 'yesterday' : d + 'd ago';
    }

    // ═══ Init ═══
    loadLastReport();
    var initTab = new URLSearchParams(window.location.search).get('tab');
    if (initTab === 'activity') { activityLoaded = true; loadActivities(); }
  </script>
</AdminLayout>
