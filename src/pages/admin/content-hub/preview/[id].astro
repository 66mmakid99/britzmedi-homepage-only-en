---
export const prerender = false;

import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TldrBox from '../../../../components/ui/TldrBox.astro';
import { marked } from 'marked';
import { isHtml } from '../../../../lib/html-to-markdown';

const { id } = Astro.params;

// Auth is handled by middleware (validates KV session).
// No duplicate check needed here.
const runtime = (Astro.locals as any).runtime;
const env = runtime?.env;
const db = env?.DB as D1Database | undefined;

if (!db) {
  return new Response('Database not available', { status: 503 });
}

// Load content item
const item = await db.prepare(
  'SELECT * FROM content_items WHERE id = ?'
).bind(Number(id)).first<any>();

if (!item) {
  return Astro.redirect('/admin/content-hub');
}

// Convert markdown → HTML (or use as-is if already HTML)
const htmlContent = isHtml(item.content || '') ? item.content : await marked(item.content || '');

// Extract TL;DR from content if present
function extractTldr(content: string): string {
  const match = content.match(/<h2>TL;DR<\/h2>\s*<p>([\s\S]*?)<\/p>/);
  return match ? match[1].replace(/<[^>]*>/g, '').trim() : '';
}
const tldr = extractTldr(htmlContent);

// Parse FAQ
let faqs: Array<{ question: string; answer: string }> = [];
try {
  if (item.faq) faqs = JSON.parse(item.faq);
} catch { /* ignore */ }

// Parse tags
let tags: string[] = [];
try {
  if (item.tags) tags = JSON.parse(item.tags);
} catch { /* ignore */ }

// Parse keywords
let keywords: string[] = [];
try {
  if (item.seo_secondary_keywords) keywords = JSON.parse(item.seo_secondary_keywords);
} catch { /* ignore */ }
if (item.seo_keyword && !keywords.includes(item.seo_keyword)) {
  keywords.unshift(item.seo_keyword);
}

const publishDate = item.published_at || item.created_at;
const isPublished = item.status === 'published';
---

<BaseLayout
  title={`Preview: ${item.title}`}
  description={item.excerpt || ''}
  keywords={tags}
>
  <!-- Preview Banner -->
  <div style="position:fixed;top:0;left:0;right:0;z-index:9999;background:linear-gradient(90deg,#f59e0b,#f97316);color:#fff;text-align:center;padding:10px 16px;font-size:14px;font-weight:600;box-shadow:0 2px 8px rgba(0,0,0,0.15);display:flex;align-items:center;justify-content:center;gap:12px;">
    <svg style="width:18px;height:18px;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z" />
    </svg>
    <span>Preview — {isPublished ? 'Published Version' : 'Not Published'}</span>
    <a href={`/admin/content-hub/edit/${id}`} style="color:#fff;text-decoration:underline;font-weight:500;margin-left:8px;opacity:0.9;">
      Back to Editor
    </a>
  </div>

  <!-- Spacer for fixed banner -->
  <div style="height:44px;" />

  <!-- Breadcrumb -->
  <nav class="container py-4 text-sm">
    <ol class="flex items-center gap-2 text-slate-500">
      <li><span class="text-slate-400">Home</span></li>
      <li>/</li>
      <li><span class="text-slate-400">Blog</span></li>
      <li>/</li>
      <li class="text-slate-700 truncate max-w-[250px]">{item.title}</li>
    </ol>
  </nav>

  <article class="blog-article">
    <!-- Category & Date -->
    <div class="blog-meta">
      {item.category && (
        <span class="category-badge">{item.category.replace(/-/g, ' ')}</span>
      )}
      <time datetime={publishDate}>
        {new Date(publishDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
      </time>
    </div>

    <!-- Title -->
    <h1>{item.title}</h1>

    <!-- Description -->
    {item.excerpt && (
      <p class="text-lg" style="color: var(--color-slate-600); line-height: 1.75; margin-bottom: 1.5rem;">
        {item.excerpt}
      </p>
    )}

    <!-- Featured Image -->
    {item.featured_image && (
      <div class="blog-featured-image">
        <img src={item.featured_image} alt={item.title} />
      </div>
    )}

    <!-- TL;DR Box -->
    {tldr && (
      <TldrBox summary={tldr} />
    )}

    <!-- Author and Share -->
    <div class="blog-author-bar">
      <div class="author-info">
        <div class="author-avatar">B</div>
        <div>
          <p class="author-name">{item.author || 'BRITZMEDI Research Team'}</p>
          <p class="author-org">BRITZMEDI Co., Ltd.</p>
        </div>
      </div>
      <div class="share-links">
        <span>Share:</span>
        <a
          href={`https://www.linkedin.com/shareArticle?mini=true&url=https://britzmedi.com/blog/${item.slug}&title=${encodeURIComponent(item.title)}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on LinkedIn"
        >
          <svg fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(item.title)}&url=https://britzmedi.com/blog/${item.slug}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on Twitter"
        >
          <svg fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Article Content -->
    <div class="blog-content">
      <Fragment set:html={htmlContent} />
    </div>

    <!-- FAQ Section -->
    {faqs.length > 0 && (
      <section class="blog-faq-section">
        <h2>Frequently Asked Questions</h2>
        {faqs.map((faq) => (
          <div class="blog-faq-item">
            <h3>{faq.question}</h3>
            <p>{faq.answer}</p>
          </div>
        ))}
      </section>
    )}

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="blog-tags">
        {tags.map(tag => (
          <span class="tag">#{tag}</span>
        ))}
      </div>
    )}

    <!-- Back to Blog -->
    <div style="margin-top: 2rem;">
      <a
        href="/admin/content-hub"
        class="inline-flex items-center text-primary-600 font-medium hover:text-primary-700"
        style="text-decoration: none;"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Content Hub
      </a>
    </div>
  </article>
</BaseLayout>
