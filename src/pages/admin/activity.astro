---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Activity Log">
  <div id="activity-root">
    <div style="display:flex; align-items:center; justify-content:center; height:200px;">
      <div style="width:32px; height:32px; border:3px solid #2563eb; border-top-color:transparent; border-radius:50%; animation:spin 1s linear infinite;"></div>
    </div>
  </div>

  <style>
    @keyframes spin { to { transform: rotate(360deg); } }
    .act-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 12px; }
    .act-filters { display: flex; gap: 8px; flex-wrap: wrap; }
    .act-filter-btn { padding: 6px 14px; font-size: 12px; font-weight: 500; border-radius: 6px; border: 1px solid #e2e8f0; background: #fff; color: #64748b; cursor: pointer; }
    .act-filter-btn.active { background: #2563eb; color: #fff; border-color: #2563eb; }
    .act-filter-btn:hover:not(.active) { background: #f8fafc; }
    .act-select { padding: 6px 10px; font-size: 12px; border-radius: 6px; border: 1px solid #e2e8f0; background: #fff; color: #334155; }
    .act-refresh { padding: 6px 14px; font-size: 12px; font-weight: 500; border-radius: 6px; border: 1px solid #e2e8f0; background: #fff; color: #64748b; cursor: pointer; display: flex; align-items: center; gap: 4px; }
    .act-refresh:hover { background: #f8fafc; }
    .timeline { background: #fff; border-radius: 12px; border: 1px solid #e2e8f0; overflow: hidden; }
    .timeline-item { display: flex; align-items: flex-start; gap: 12px; padding: 14px 20px; border-bottom: 1px solid #f1f5f9; }
    .timeline-item:last-child { border-bottom: none; }
    .timeline-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 14px; }
    .timeline-body { flex: 1; min-width: 0; }
    .timeline-text { font-size: 13px; color: #334155; line-height: 1.5; }
    .timeline-meta { font-size: 11px; color: #94a3b8; margin-top: 2px; display: flex; gap: 12px; }
    .empty-state { text-align: center; padding: 60px 20px; color: #94a3b8; }
  </style>

  <script is:inline>
    const TYPE_CONFIG = {
      lead_created:        { icon: '👤', bg: '#dcfce7', label: 'Lead Created' },
      lead_updated:        { icon: '✏️', bg: '#dbeafe', label: 'Lead Updated' },
      subscriber_added:    { icon: '📧', bg: '#dbeafe', label: 'Subscriber Added' },
      subscriber_unsubscribed: { icon: '📭', bg: '#fee2e2', label: 'Unsubscribed' },
      blog_published:      { icon: '📝', bg: '#ede9fe', label: 'Blog Published' },
      blog_unpublished:    { icon: '📄', bg: '#f1f5f9', label: 'Blog Unpublished' },
      blog_created:        { icon: '✍️', bg: '#ede9fe', label: 'Blog Created' },
      social_posted:       { icon: '📱', bg: '#fef3c7', label: 'Social Posted' },
      social_failed:       { icon: '⚠️', bg: '#fee2e2', label: 'Social Failed' },
      resource_downloaded: { icon: '📥', bg: '#ccfbf1', label: 'Resource Downloaded' },
      admin_login:         { icon: '🔐', bg: '#f1f5f9', label: 'Admin Login' },
      admin_logout:        { icon: '🔓', bg: '#f1f5f9', label: 'Admin Logout' },
      ai_research:         { icon: '🔬', bg: '#fce7f3', label: 'AI Research' },
      health_check:        { icon: '🩺', bg: '#cffafe', label: 'Health Check' },
      content_transition:  { icon: '🔄', bg: '#ede9fe', label: 'Content Transition' },
    };

    let currentPeriod = 'all';
    let currentType = '';

    async function loadActivities() {
      const root = document.getElementById('activity-root');
      try {
        const params = new URLSearchParams();
        if (currentPeriod !== 'all') params.set('period', currentPeriod);
        if (currentType) params.set('type', currentType);
        params.set('limit', '100');

        const res = await fetch('/api/admin/activity?' + params.toString());
        if (!res.ok) throw new Error('Failed');
        const data = await res.json();
        renderActivities(data.activities || []);
      } catch {
        root.innerHTML = '<div class="empty-state">Failed to load activities. <button onclick="loadActivities()" style="color:#2563eb; background:none; border:none; cursor:pointer;">Retry</button></div>';
      }
    }

    function renderActivities(activities) {
      const root = document.getElementById('activity-root');
      const typeOptions = Object.entries(TYPE_CONFIG).map(([k, v]) =>
        `<option value="${k}" ${currentType === k ? 'selected' : ''}>${v.label}</option>`
      ).join('');

      let html = `
        <div class="act-header">
          <h2 style="font-size:18px; font-weight:600; color:#0f172a; margin:0;">Activity Log</h2>
          <div class="act-filters">
            <button class="act-filter-btn ${currentPeriod === 'all' ? 'active' : ''}" onclick="setPeriod('all')">All</button>
            <button class="act-filter-btn ${currentPeriod === 'today' ? 'active' : ''}" onclick="setPeriod('today')">Today</button>
            <button class="act-filter-btn ${currentPeriod === 'week' ? 'active' : ''}" onclick="setPeriod('week')">This Week</button>
            <button class="act-filter-btn ${currentPeriod === 'month' ? 'active' : ''}" onclick="setPeriod('month')">This Month</button>
            <select class="act-select" onchange="setType(this.value)">
              <option value="">All Types</option>
              ${typeOptions}
            </select>
            <button class="act-refresh" onclick="loadActivities()">↻ Refresh</button>
          </div>
        </div>
      `;

      if (activities.length === 0) {
        html += '<div class="empty-state"><div style="font-size:36px; margin-bottom:12px;">📋</div><div>No activities found for this filter.</div></div>';
      } else {
        html += '<div class="timeline">';
        for (const a of activities) {
          const cfg = TYPE_CONFIG[a.type] || { icon: '📋', bg: '#f1f5f9', label: a.type };
          html += `
            <div class="timeline-item">
              <div class="timeline-icon" style="background:${cfg.bg}">${cfg.icon}</div>
              <div class="timeline-body">
                <div class="timeline-text">${escapeHtml(a.detail)}</div>
                <div class="timeline-meta">
                  <span>${cfg.label}</span>
                  <span>${timeAgo(a.created_at)}</span>
                  ${a.ip ? `<span>IP: ${escapeHtml(a.ip)}</span>` : ''}
                </div>
              </div>
            </div>`;
        }
        html += '</div>';
      }

      root.innerHTML = html;
    }

    function setPeriod(p) { currentPeriod = p; loadActivities(); }
    function setType(t) { currentType = t; loadActivities(); }

    function escapeHtml(str) {
      const d = document.createElement('div');
      d.textContent = str || '';
      return d.innerHTML;
    }

    function timeAgo(dateStr) {
      if (!dateStr) return '';
      const now = new Date();
      const date = new Date(dateStr + 'Z');
      const diff = Math.floor((now - date) / 1000);
      if (diff < 60) return 'just now';
      if (diff < 3600) return Math.floor(diff / 60) + 'm ago';
      if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
      const d = Math.floor(diff / 86400);
      return d === 1 ? 'yesterday' : d + 'd ago';
    }

    loadActivities();
  </script>
</AdminLayout>
