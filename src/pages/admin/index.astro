---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard">
  <div id="dashboard-root">
    <div style="display:flex; align-items:center; justify-content:center; height:200px;">
      <div class="dash-spinner"></div>
    </div>
  </div>

  <style is:global>
    @keyframes spin { to { transform: rotate(360deg); } }
    .dash-spinner { width:32px; height:32px; border:3px solid #2563eb; border-top-color:transparent; border-radius:50%; animation:spin 1s linear infinite; }

    .dash-kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
    .dash-kpi {
      background: #fff; border-radius: 12px; padding: 20px; border: 1px solid #e2e8f0;
      display: flex; align-items: flex-start; gap: 14px;
    }
    .dash-kpi-icon {
      width: 44px; height: 44px; border-radius: 10px; display: flex;
      align-items: center; justify-content: center; flex-shrink: 0;
    }
    .dash-kpi-label { font-size: 12px; color: #64748b; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; }
    .dash-kpi-value { font-size: 28px; font-weight: 700; color: #0f172a; line-height: 1.1; margin-top: 2px; }
    .dash-kpi-sub { font-size: 11px; color: #94a3b8; margin-top: 3px; }

    .dash-section { background: #fff; border-radius: 12px; padding: 20px; border: 1px solid #e2e8f0; margin-bottom: 16px; }
    .dash-section-title { font-size: 14px; font-weight: 600; color: #0f172a; margin-bottom: 14px; display: flex; align-items: center; gap: 8px; }

    .activity-item { display: flex; align-items: flex-start; gap: 10px; padding: 8px 0; border-bottom: 1px solid #f1f5f9; }
    .activity-item:last-child { border-bottom: none; }
    .activity-dot { width: 8px; height: 8px; border-radius: 50%; margin-top: 5px; flex-shrink: 0; }
    .activity-text { font-size: 13px; color: #334155; line-height: 1.4; }
    .activity-time { font-size: 11px; color: #94a3b8; }

    .health-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }

    .quick-btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 9px 16px; font-size: 13px; font-weight: 500;
      border-radius: 8px; text-decoration: none;
      border: 1px solid #e2e8f0; color: #334155; background: #fff; cursor: pointer;
      transition: all 0.15s;
    }
    .quick-btn:hover { background: #f8fafc; border-color: #cbd5e1; }

    .alert-banner {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 8px;
    }
    .alert-warning { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
    .alert-info { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }
    .alert-error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }

    .social-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
    .social-channel {
      display: flex; align-items: center; gap: 8px; padding: 8px 0;
      border-bottom: 1px solid #f1f5f9; font-size: 13px;
    }
    .social-channel:last-child { border-bottom: none; }

    .pipeline-bar { display: flex; gap: 2px; height: 6px; border-radius: 3px; overflow: hidden; margin-top: 8px; }
    .pipeline-seg { height: 100%; min-width: 2px; transition: width 0.3s; }

    @media (max-width: 1024px) { .dash-kpi-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 480px) { .dash-kpi-grid { grid-template-columns: 1fr; } }
  </style>

  <script is:inline>
    const ACTIVITY_COLORS = {
      lead_created: '#22c55e', lead_updated: '#22c55e',
      subscriber_added: '#3b82f6', blog_published: '#8b5cf6',
      social_posted: '#f59e0b', admin_login: '#64748b',
      health_check: '#06b6d4', ai_research: '#ec4899',
      resource_downloaded: '#14b8a6', content_transition: '#6366f1',
    };

    const STAGE_COLORS = {
      new: '#3b82f6', contacted: '#f59e0b', qualified: '#8b5cf6',
      proposal: '#6366f1', won: '#22c55e', lost: '#ef4444',
    };

    async function loadDashboard() {
      const root = document.getElementById('dashboard-root');
      try {
        const [dashRes, socialRes] = await Promise.all([
          fetch('/api/admin/dashboard'),
          fetch('/api/admin/social/status').catch(() => null),
        ]);

        if (!dashRes.ok) throw new Error('Failed');
        const data = await dashRes.json();

        let socialData = { channels: {} };
        if (socialRes?.ok) {
          socialData = await socialRes.json();
        }

        const channels = socialData.channels || {};
        const healthColor = data.lastHealthStatus === 'healthy' ? '#22c55e'
          : data.lastHealthStatus === 'warning' ? '#f59e0b' : '#94a3b8';
        const healthLabel = data.lastHealthStatus === 'healthy' ? 'All Systems OK'
          : data.lastHealthStatus === 'warning' ? 'Warnings'
          : data.lastHealthAt ? 'Issues' : 'Not Run';

        // Build alerts HTML
        const alertsHtml = (data.alerts || []).map(a => {
          const cls = a.severity === 'warning' ? 'alert-warning' : a.severity === 'error' ? 'alert-error' : 'alert-info';
          const icon = a.severity === 'warning' ? '\u26a0\ufe0f' : a.severity === 'error' ? '\u274c' : '\u2139\ufe0f';
          return `<div class="alert-banner ${cls}">${icon} ${escapeHtml(a.message)}</div>`;
        }).join('');

        // Pipeline bar
        const ls = data.leadsByStatus || {};
        const pipelineTotal = Object.values(ls).reduce((s, v) => s + v, 0) || 1;
        const pipelineHtml = Object.entries(STAGE_COLORS).map(([stage, color]) => {
          const count = ls[stage] || 0;
          const pct = Math.max((count / pipelineTotal) * 100, count > 0 ? 3 : 0);
          return `<div class="pipeline-seg" style="width:${pct}%;background:${color}" title="${stage}: ${count}"></div>`;
        }).join('');

        // Social channels
        const socialHtml = ['twitter', 'linkedin', 'instagram'].map(ch => {
          const st = channels[ch] || {};
          const names = { twitter: 'X (Twitter)', linkedin: 'LinkedIn', instagram: 'Instagram' };
          const dotColor = st.connected ? (st.status === 'expiring' ? '#f59e0b' : '#22c55e') : '#ef4444';
          const label = st.connected ? (st.account || 'Connected') : (st.error || 'Not connected');
          const expiry = st.expires_in_days != null ? ` (${st.expires_in_days}d left)` : '';
          return `
            <div class="social-channel">
              <span class="social-dot" style="background:${dotColor}"></span>
              <span style="font-weight:500;color:#334155;width:100px;">${names[ch]}</span>
              <span style="color:${st.connected ? '#16a34a' : '#dc2626'};font-size:12px;">${escapeHtml(label)}${expiry}</span>
            </div>`;
        }).join('');

        root.innerHTML = `
          ${alertsHtml ? `<div style="margin-bottom:16px;">${alertsHtml}</div>` : ''}

          <div class="dash-kpi-grid">
            <div class="dash-kpi">
              <div class="dash-kpi-icon" style="background:#dbeafe;">
                <svg width="22" height="22" fill="none" stroke="#2563eb" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <div class="dash-kpi-label">Total Leads</div>
                <div class="dash-kpi-value">${data.totalLeads ?? 0}</div>
                <div class="dash-kpi-sub">+${data.weeklyLeads ?? 0} this week</div>
              </div>
            </div>
            <div class="dash-kpi">
              <div class="dash-kpi-icon" style="background:#dcfce7;">
                <svg width="22" height="22" fill="none" stroke="#16a34a" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/></svg>
              </div>
              <div>
                <div class="dash-kpi-label">Hot Leads</div>
                <div class="dash-kpi-value" style="color:#dc2626;">${data.hotLeads ?? 0}</div>
                <div class="dash-kpi-sub">${data.overdueLeads > 0 ? data.overdueLeads + ' overdue' : 'A-grade'}</div>
              </div>
            </div>
            <div class="dash-kpi">
              <div class="dash-kpi-icon" style="background:#ede9fe;">
                <svg width="22" height="22" fill="none" stroke="#7c3aed" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
              </div>
              <div>
                <div class="dash-kpi-label">Content</div>
                <div class="dash-kpi-value">${data.contentItems ?? data.totalPosts ?? 0}</div>
                <div class="dash-kpi-sub">${data.contentPublished ?? data.publishedPosts ?? 0} published, ${data.contentDraft ?? 0} draft</div>
              </div>
            </div>
            <div class="dash-kpi">
              <div class="dash-kpi-icon" style="background:#e0f2fe;">
                <svg width="22" height="22" fill="none" stroke="#0284c7" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <div class="dash-kpi-label">Subscribers</div>
                <div class="dash-kpi-value">${data.totalSubscribers ?? 0}</div>
                <div class="dash-kpi-sub">+${data.weeklySubscribers ?? 0} this week</div>
              </div>
            </div>
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
            <div class="dash-section">
              <div class="dash-section-title">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Recent Activity
              </div>
              <div>
                ${(data.recentActivities || []).length === 0
                  ? '<div style="color:#94a3b8; font-size:13px; padding:12px 0;">No activities recorded yet.</div>'
                  : (data.recentActivities || []).map(a => `
                    <div class="activity-item">
                      <div class="activity-dot" style="background:${ACTIVITY_COLORS[a.type] || '#94a3b8'}"></div>
                      <div style="flex:1; min-width:0;">
                        <div class="activity-text">${escapeHtml(a.detail)}</div>
                        <div class="activity-time">${timeAgo(a.created_at)}</div>
                      </div>
                    </div>
                  `).join('')
                }
              </div>
            </div>

            <div style="display:flex; flex-direction:column; gap:16px;">
              <div class="dash-section" style="flex:1;">
                <div class="dash-section-title">
                  <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/></svg>
                  Leads Pipeline
                </div>
                <div style="display:flex; flex-wrap:wrap; gap:12px; font-size:12px; color:#64748b;">
                  ${Object.entries(STAGE_COLORS).map(([stage, color]) => {
                    const count = ls[stage] || 0;
                    return `<span style="display:flex; align-items:center; gap:4px;"><span style="width:8px; height:8px; border-radius:50%; background:${color};"></span>${stage}: <b style="color:#0f172a;">${count}</b></span>`;
                  }).join('')}
                </div>
                <div class="pipeline-bar">${pipelineHtml}</div>
              </div>

              <div class="dash-section" style="flex:1;">
                <div class="dash-section-title">
                  <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
                  Social Channels
                </div>
                ${socialHtml}
              </div>
            </div>
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
            <div class="dash-section">
              <div class="dash-section-title">
                <span class="health-dot" style="background:${healthColor}"></span>
                System Status
              </div>
              <div style="font-size:13px; color:#334155; margin-bottom:6px;">${healthLabel}</div>
              ${data.lastHealthAt ? `<div style="font-size:11px; color:#94a3b8;">Last check: ${timeAgo(data.lastHealthAt)}</div>` : ''}
              <a href="/admin/settings/system" style="display:inline-block; margin-top:10px; font-size:12px; color:#2563eb; text-decoration:none;">Run Health Check &rarr;</a>
            </div>

            <div class="dash-section">
              <div class="dash-section-title">Quick Actions</div>
              <div style="display:flex; flex-wrap:wrap; gap:8px;">
                <a href="/admin/content-hub" class="quick-btn">+ New Content</a>
                <a href="/admin/leads" class="quick-btn">View Leads</a>
                <a href="/admin/analytics" class="quick-btn">Analytics</a>
                <a href="/admin/social" class="quick-btn">Social Media</a>
              </div>
            </div>
          </div>
        `;
      } catch (err) {
        root.innerHTML = '<div style="color:#ef4444; padding:24px;">Failed to load dashboard data. <button onclick="loadDashboard()" style="color:#2563eb; background:none; border:none; cursor:pointer; text-decoration:underline;">Retry</button></div>';
      }
    }

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str || '';
      return div.innerHTML;
    }

    function timeAgo(dateStr) {
      if (!dateStr) return '';
      const now = new Date();
      const date = new Date(dateStr + (dateStr.endsWith('Z') ? '' : 'Z'));
      const diff = Math.floor((now - date) / 1000);
      if (diff < 60) return 'just now';
      if (diff < 3600) return Math.floor(diff / 60) + 'm ago';
      if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
      return Math.floor(diff / 86400) + 'd ago';
    }

    loadDashboard();
  </script>
</AdminLayout>
