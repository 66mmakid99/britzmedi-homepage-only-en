---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard">
  <div id="dashboard-root">
    <div style="display:flex; align-items:center; justify-content:center; height:200px;">
      <div style="width:32px; height:32px; border:3px solid #2563eb; border-top-color:transparent; border-radius:50%; animation:spin 1s linear infinite;"></div>
    </div>
  </div>

  <style>
    @keyframes spin { to { transform: rotate(360deg); } }
    .dash-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
    .dash-card { background: #fff; border-radius: 12px; padding: 20px; border: 1px solid #e2e8f0; }
    .dash-card-label { font-size: 13px; color: #64748b; font-weight: 500; margin-bottom: 4px; }
    .dash-card-value { font-size: 28px; font-weight: 700; color: #0f172a; }
    .dash-card-sub { font-size: 12px; color: #94a3b8; margin-top: 4px; }
    .dash-section { background: #fff; border-radius: 12px; padding: 20px; border: 1px solid #e2e8f0; margin-bottom: 16px; }
    .dash-section-title { font-size: 15px; font-weight: 600; color: #0f172a; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
    .activity-item { display: flex; align-items: flex-start; gap: 12px; padding: 10px 0; border-bottom: 1px solid #f1f5f9; }
    .activity-item:last-child { border-bottom: none; }
    .activity-dot { width: 8px; height: 8px; border-radius: 50%; margin-top: 5px; flex-shrink: 0; }
    .activity-text { font-size: 13px; color: #334155; }
    .activity-time { font-size: 11px; color: #94a3b8; }
    .health-indicator { width: 12px; height: 12px; border-radius: 50%; display: inline-block; }
    .quick-btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; font-size: 13px; font-weight: 500; border-radius: 8px; text-decoration: none; border: 1px solid #e2e8f0; color: #334155; background: #fff; cursor: pointer; transition: all 0.15s; }
    .quick-btn:hover { background: #f8fafc; border-color: #cbd5e1; }
    @media (max-width: 768px) { .dash-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 480px) { .dash-grid { grid-template-columns: 1fr; } }
  </style>

  <script is:inline>
    const ACTIVITY_COLORS = {
      lead_created: '#22c55e',
      subscriber_added: '#3b82f6',
      blog_published: '#8b5cf6',
      social_posted: '#f59e0b',
      admin_login: '#64748b',
      health_check: '#06b6d4',
      ai_research: '#ec4899',
      resource_downloaded: '#14b8a6',
    };

    async function loadDashboard() {
      const root = document.getElementById('dashboard-root');
      try {
        const res = await fetch('/api/admin/dashboard');
        if (!res.ok) throw new Error('Failed');
        const data = await res.json();

        const healthColor = data.lastHealthStatus === 'healthy' ? '#22c55e'
          : data.lastHealthStatus === 'warning' ? '#f59e0b' : '#94a3b8';
        const healthLabel = data.lastHealthStatus === 'healthy' ? 'All Systems OK'
          : data.lastHealthStatus === 'warning' ? 'Warnings Detected'
          : data.lastHealthAt ? 'Issues Found' : 'Not Run Yet';

        root.innerHTML = `
          <div class="dash-grid">
            <div class="dash-card">
              <div class="dash-card-label">Total Leads</div>
              <div class="dash-card-value">${data.totalLeads ?? 0}</div>
              <div class="dash-card-sub">+${data.weeklyLeads ?? 0} this week</div>
            </div>
            <div class="dash-card">
              <div class="dash-card-label">Hot Leads (A-grade)</div>
              <div class="dash-card-value" style="color:#dc2626;">${data.hotLeads ?? 0}</div>
              <div class="dash-card-sub">Score 75+</div>
            </div>
            <div class="dash-card">
              <div class="dash-card-label">Blog Posts</div>
              <div class="dash-card-value">${data.totalPosts ?? 0}</div>
              <div class="dash-card-sub">${data.publishedPosts ?? 0} published</div>
            </div>
            <div class="dash-card">
              <div class="dash-card-label">Subscribers</div>
              <div class="dash-card-value">${data.totalSubscribers ?? 0}</div>
              <div class="dash-card-sub">+${data.weeklySubscribers ?? 0} this week</div>
            </div>
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
            <div class="dash-section">
              <div class="dash-section-title">Recent Activity</div>
              <div id="recent-activities">
                ${(data.recentActivities || []).length === 0
                  ? '<div style="color:#94a3b8; font-size:13px;">No activities recorded yet.</div>'
                  : (data.recentActivities || []).map(a => `
                    <div class="activity-item">
                      <div class="activity-dot" style="background:${ACTIVITY_COLORS[a.type] || '#94a3b8'}"></div>
                      <div style="flex:1; min-width:0;">
                        <div class="activity-text">${escapeHtml(a.detail)}</div>
                        <div class="activity-time">${timeAgo(a.created_at)}</div>
                      </div>
                    </div>
                  `).join('')
                }
              </div>
              ${(data.recentActivities || []).length > 0 ? '<a href="/admin/activity" style="display:block; text-align:center; font-size:12px; color:#2563eb; margin-top:12px; text-decoration:none;">View all activity →</a>' : ''}
            </div>

            <div class="dash-section">
              <div class="dash-section-title">
                System Status
                <span class="health-indicator" style="background:${healthColor}"></span>
              </div>
              <div style="font-size:14px; color:#334155; margin-bottom:8px;">${healthLabel}</div>
              ${data.lastHealthAt ? `<div style="font-size:12px; color:#94a3b8;">Last check: ${timeAgo(data.lastHealthAt)}</div>` : ''}
              <a href="/admin/health" style="display:inline-block; margin-top:12px; font-size:12px; color:#2563eb; text-decoration:none;">Run Health Check →</a>
            </div>
          </div>

          <div class="dash-section">
            <div class="dash-section-title">Quick Actions</div>
            <div style="display:flex; flex-wrap:wrap; gap:10px;">
              <a href="/admin/youtube-to-blog" class="quick-btn">+ New Blog Post</a>
              <a href="/admin/leads" class="quick-btn">View Leads</a>
              <a href="/admin/health" class="quick-btn">Run Health Check</a>
              <a href="/admin/content-hub" class="quick-btn">Content Hub</a>
              <a href="/admin/social" class="quick-btn">Social Media</a>
            </div>
          </div>
        `;
      } catch (err) {
        root.innerHTML = '<div style="color:#ef4444; padding:24px;">Failed to load dashboard data. <button onclick="loadDashboard()" style="color:#2563eb; background:none; border:none; cursor:pointer; text-decoration:underline;">Retry</button></div>';
      }
    }

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str || '';
      return div.innerHTML;
    }

    function timeAgo(dateStr) {
      if (!dateStr) return '';
      const now = new Date();
      const date = new Date(dateStr + 'Z');
      const diff = Math.floor((now - date) / 1000);
      if (diff < 60) return 'just now';
      if (diff < 3600) return Math.floor(diff / 60) + 'm ago';
      if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
      return Math.floor(diff / 86400) + 'd ago';
    }

    loadDashboard();
  </script>
</AdminLayout>
