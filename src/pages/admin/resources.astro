---
// Server-side rendering for authentication
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Resource Downloads">
  <div class="min-h-screen bg-slate-100">
    <!-- Page Header -->
    <header class="bg-white border-b border-slate-200">
      <div class="container py-6">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-2xl font-bold text-slate-900">Resource Downloads</h1>
            <p class="text-sm text-slate-500">Track and analyze resource download activity</p>
          </div>
          <div class="flex items-center gap-3">
            <button
              id="refresh-btn"
              class="px-4 py-2 text-sm font-medium text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors"
            >
              <svg class="w-4 h-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              Refresh
            </button>
            <a
              href="/resources"
              target="_blank"
              class="px-4 py-2 text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 rounded-lg transition-colors"
            >
              View Resources Page
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Stats Cards -->
    <section class="container py-6">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card-premium p-6">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
            </div>
            <div>
              <p class="text-2xl font-bold text-slate-900" id="stat-total">0</p>
              <p class="text-sm text-slate-500">Total Downloads</p>
            </div>
          </div>
        </div>

        <div class="card-premium p-6">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center">
              <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="text-2xl font-bold text-slate-900" id="stat-today">0</p>
              <p class="text-sm text-slate-500">Today</p>
            </div>
          </div>
        </div>

        <div class="card-premium p-6">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-amber-100 flex items-center justify-center">
              <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <div>
              <p class="text-2xl font-bold text-slate-900" id="stat-week">0</p>
              <p class="text-sm text-slate-500">This Week</p>
            </div>
          </div>
        </div>

        <div class="card-premium p-6">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="text-2xl font-bold text-slate-900" id="stat-unique">0</p>
              <p class="text-sm text-slate-500">Unique Resources</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Tables Row -->
    <section class="container pb-6">
      <div class="grid lg:grid-cols-2 gap-6">
        <!-- Top Downloaded Resources -->
        <div class="card-premium overflow-hidden">
          <div class="px-6 py-4 border-b border-slate-200 bg-slate-50">
            <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wider">Top Downloaded Resources</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b border-slate-100">
                  <th class="text-left px-6 py-3 text-xs font-medium text-slate-500">#</th>
                  <th class="text-left px-6 py-3 text-xs font-medium text-slate-500">Resource</th>
                  <th class="text-right px-6 py-3 text-xs font-medium text-slate-500">Downloads</th>
                </tr>
              </thead>
              <tbody id="top-resources-body" class="divide-y divide-slate-100">
                <tr>
                  <td colspan="3" class="px-6 py-8 text-center text-sm text-slate-400">Loading...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Recent Downloads -->
        <div class="card-premium overflow-hidden">
          <div class="px-6 py-4 border-b border-slate-200 bg-slate-50">
            <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wider">Recent Downloads</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b border-slate-100">
                  <th class="text-left px-6 py-3 text-xs font-medium text-slate-500">Resource</th>
                  <th class="text-left px-6 py-3 text-xs font-medium text-slate-500">Country</th>
                  <th class="text-left px-6 py-3 text-xs font-medium text-slate-500">Time</th>
                </tr>
              </thead>
              <tbody id="recent-downloads-body" class="divide-y divide-slate-100">
                <tr>
                  <td colspan="3" class="px-6 py-8 text-center text-sm text-slate-400">Loading...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Downloads by Country -->
    <section class="container pb-12">
      <div class="card-premium overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-200 bg-slate-50">
          <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wider">Downloads by Country</h2>
        </div>
        <div class="p-6" id="country-chart">
          <p class="text-sm text-slate-400 text-center py-4">Loading...</p>
        </div>
      </div>
    </section>
  </div>
</AdminLayout>

<script>
  interface ResourceStats {
    totalDownloads: number;
    downloadsToday: number;
    downloadsThisWeek: number;
    uniqueResources: number;
    byResource: { resource_id: string; resource_title: string; count: number }[];
    byCountry: Record<string, number>;
    recentDownloads: { resource_title: string; country: string; created_at: string }[];
    dailyTrend: { date: string; count: number }[];
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text || '';
    return div.innerHTML;
  }

  function timeAgo(dateStr: string): string {
    const now = Date.now();
    const then = new Date(dateStr).getTime();
    const diff = now - then;

    const minutes = Math.floor(diff / 60000);
    if (minutes < 1) return 'Just now';
    if (minutes < 60) return `${minutes}m ago`;

    const hours = Math.floor(minutes / 60);
    if (hours < 24) return `${hours}h ago`;

    const days = Math.floor(hours / 24);
    if (days < 7) return `${days}d ago`;

    return new Date(dateStr).toLocaleDateString();
  }

  async function fetchStats(): Promise<ResourceStats | null> {
    try {
      const response = await fetch('/api/resources/stats');
      if (!response.ok) throw new Error('Failed to fetch stats');
      return await response.json();
    } catch (error) {
      console.error('Error fetching resource stats:', error);
      return null;
    }
  }

  function renderStats(stats: ResourceStats) {
    // Update stat cards
    const statTotal = document.getElementById('stat-total');
    const statToday = document.getElementById('stat-today');
    const statWeek = document.getElementById('stat-week');
    const statUnique = document.getElementById('stat-unique');

    if (statTotal) statTotal.textContent = stats.totalDownloads.toString();
    if (statToday) statToday.textContent = stats.downloadsToday.toString();
    if (statWeek) statWeek.textContent = stats.downloadsThisWeek.toString();
    if (statUnique) statUnique.textContent = stats.uniqueResources.toString();

    // Top resources table
    const topBody = document.getElementById('top-resources-body');
    if (topBody) {
      if (stats.byResource.length === 0) {
        topBody.innerHTML = `
          <tr>
            <td colspan="3" class="px-6 py-8 text-center text-sm text-slate-400">No downloads yet</td>
          </tr>
        `;
      } else {
        topBody.innerHTML = stats.byResource.map((r, i) => `
          <tr class="hover:bg-slate-50">
            <td class="px-6 py-3 text-sm text-slate-400">${i + 1}</td>
            <td class="px-6 py-3">
              <p class="text-sm font-medium text-slate-900 truncate max-w-[280px]">${escapeHtml(r.resource_title)}</p>
              <p class="text-xs text-slate-400">${escapeHtml(r.resource_id)}</p>
            </td>
            <td class="px-6 py-3 text-right">
              <span class="inline-flex items-center px-2.5 py-0.5 text-sm font-semibold text-primary-700 bg-primary-50 rounded-full">
                ${r.count}
              </span>
            </td>
          </tr>
        `).join('');
      }
    }

    // Recent downloads table
    const recentBody = document.getElementById('recent-downloads-body');
    if (recentBody) {
      if (stats.recentDownloads.length === 0) {
        recentBody.innerHTML = `
          <tr>
            <td colspan="3" class="px-6 py-8 text-center text-sm text-slate-400">No downloads yet</td>
          </tr>
        `;
      } else {
        recentBody.innerHTML = stats.recentDownloads.map(d => `
          <tr class="hover:bg-slate-50">
            <td class="px-6 py-3">
              <p class="text-sm font-medium text-slate-900 truncate max-w-[280px]">${escapeHtml(d.resource_title)}</p>
            </td>
            <td class="px-6 py-3">
              <span class="text-sm text-slate-600">${escapeHtml(d.country) || '-'}</span>
            </td>
            <td class="px-6 py-3">
              <span class="text-sm text-slate-400">${timeAgo(d.created_at)}</span>
            </td>
          </tr>
        `).join('');
      }
    }

    // Country chart (horizontal bar chart using HTML/CSS)
    const countryChart = document.getElementById('country-chart');
    if (countryChart) {
      const countries = Object.entries(stats.byCountry);
      if (countries.length === 0) {
        countryChart.innerHTML = '<p class="text-sm text-slate-400 text-center py-4">No data yet</p>';
      } else {
        const maxCount = Math.max(...countries.map(([, c]) => c));
        countryChart.innerHTML = `
          <div class="space-y-3">
            ${countries.map(([country, count]) => {
              const pct = maxCount > 0 ? (count / maxCount) * 100 : 0;
              return `
                <div class="flex items-center gap-3">
                  <span class="text-sm font-medium text-slate-700 w-8 shrink-0">${escapeHtml(country)}</span>
                  <div class="flex-1 bg-slate-100 rounded-full h-6 overflow-hidden">
                    <div class="bg-primary-500 h-full rounded-full transition-all duration-500 flex items-center justify-end pr-2" style="width: ${Math.max(pct, 8)}%">
                      <span class="text-xs font-semibold text-white">${count}</span>
                    </div>
                  </div>
                </div>
              `;
            }).join('')}
          </div>
        `;
      }
    }
  }

  async function loadData() {
    const stats = await fetchStats();
    if (stats) {
      renderStats(stats);
    }
  }

  // Refresh button
  document.getElementById('refresh-btn')?.addEventListener('click', loadData);

  // Initial load
  loadData();
</script>
