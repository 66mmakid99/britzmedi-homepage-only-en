---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogHero from '../../components/blog/BlogHero.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import CategoryFilter from '../../components/blog/CategoryFilter.astro';
import Pagination from '../../components/blog/Pagination.astro';

// Load dynamic blog posts from content/blog/*.json
const dynamicPostModules = import.meta.glob('../../content/blog/*.json', { eager: true });
const dynamicPosts = Object.values(dynamicPostModules)
  .map((mod: any) => {
    const data = mod.default || mod;
    return {
      slug: data.slug,
      title: data.title,
      description: data.excerpt || data.metaDescription || '',
      author: data.author || 'BRITZMEDI Team',
      publishedAt: data.publishedAt,
      category: data.category || 'medical-devices',
      tags: data.tags || [],
      featuredImage: data.featuredImage || null,
      status: data.status || 'published',
    };
  })
  .filter(post => post.status === 'published');

// Static blog posts (original hardcoded posts)
const staticPosts = [
  {
    slug: 'korean-beauty-device-market',
    title: 'Korean Aesthetic Device Market: Why Global Distributors Are Partnering with Korean Manufacturers',
    description: 'Market data, regulatory landscape, and partnership opportunities in the Korean aesthetic device industry. A strategic guide for international distributors evaluating Korean manufacturers.',
    author: 'BRITZMEDI Team',
    publishedAt: '2025-10-20',
    category: 'industry-news',
    tags: ['Korean Medical Devices', 'K-Beauty', 'Distribution Partnership'],
    featuredImage: '/images/blog/korean-market.jpg',
  },
];

// Merge and sort by date descending
const allPosts = [...staticPosts, ...dynamicPosts].sort(
  (a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime()
);

const POSTS_PER_PAGE = 9;
const heroPost = allPosts[0];
const remainingPosts = allPosts.slice(1);
const totalGridPages = Math.ceil(remainingPosts.length / POSTS_PER_PAGE);
const paginatedPosts = remainingPosts.slice(0, POSTS_PER_PAGE);

const categories = [
  { value: 'all', label: 'All Posts' },
  { value: 'industry-news', label: 'Industry News' },
  { value: 'product-updates', label: 'Product Updates' },
  { value: 'technology', label: 'Technology' },
  { value: 'clinical-studies', label: 'Clinical Studies' },
  { value: 'education', label: 'Education' },
];

const categoryLabels: Record<string, string> = {
  'industry-news': 'Industry News',
  'product-updates': 'Product Updates',
  'technology': 'Technology',
  'clinical-studies': 'Clinical Studies',
  'clinical-reviews': 'Clinical Reviews',
  'education': 'Education',
  'medical-devices': 'Medical Devices',
};
const getCategoryLabel = (cat: string) => categoryLabels[cat] || cat.replace('-', ' ');

// Structured data
const blogListSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  'name': 'BRITZMEDI Blog',
  'description': 'Industry insights, product updates, and educational content from BRITZMEDI',
  'url': 'https://britzmedi.com/blog',
  'publisher': {
    '@type': 'Organization',
    'name': 'BRITZMEDI Co., Ltd.',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://britzmedi.com/images/logos/britzmedi-logo.png'
    }
  },
  'blogPost': allPosts.map(post => ({
    '@type': 'BlogPosting',
    'headline': post.title,
    'description': post.description,
    'author': {
      '@type': 'Organization',
      'name': post.author
    },
    'datePublished': post.publishedAt,
    'url': `https://britzmedi.com/blog/${post.slug}`
  }))
};
---

<BaseLayout
  title="Blog - Medical Device Industry Insights & RF Technology"
  description="Expert insights on RF technology, FDA clearance process, and aesthetic medicine trends from BRITZMEDI. Stay informed with industry news and clinical updates."
  keywords={['medical device blog', 'RF technology insights', 'aesthetic medicine trends', 'FDA clearance process', 'K-beauty devices', 'TORR RF updates', 'medical device industry']}
>
  <script type="application/ld+json" set:html={JSON.stringify(blogListSchema)} />

  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-hero py-20 lg:py-28">
    <!-- Decorative blurred orbs -->
    <div class="absolute top-0 right-0 w-72 h-72 bg-primary-400/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-primary-600/5 rounded-full blur-3xl translate-y-1/2 -translate-x-1/3"></div>

    <div class="container relative">
      <div class="max-w-3xl">
        <span class="badge-premium mb-4 opacity-0 animate-fade-up">Blog & Insights</span>
        <h1 class="heading-1 mb-6 opacity-0 animate-fade-up stagger-1">
          Industry Insights & Updates
        </h1>
        <p class="body-large max-w-2xl opacity-0 animate-fade-up stagger-2">
          Stay informed with the latest news, technology insights, and educational content from the aesthetic medical device industry.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CategoryFilter categories={categories} />

      {/* Hero Card - Latest Post */}
      {heroPost && (
        <div class="mb-12" id="blog-hero-card" data-hero-category={heroPost.category}>
          <BlogHero
            slug={heroPost.slug}
            title={heroPost.title}
            description={heroPost.description}
            category={heroPost.category}
            categoryLabel={getCategoryLabel(heroPost.category)}
            publishedAt={heroPost.publishedAt}
            featuredImage={heroPost.featuredImage}
            readMoreText="Read More"
            basePath="/blog"
          />
        </div>
      )}

      {/* More Articles section label */}
      <div class="flex items-center gap-3 mb-8">
        <span class="text-sm font-semibold text-slate-500 uppercase tracking-wide whitespace-nowrap">More Articles</span>
        <div class="divider-gradient flex-1"></div>
      </div>

      {/* Post Grid */}
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {paginatedPosts.map((post, index) => (
          <BlogCard
            slug={post.slug}
            title={post.title}
            description={post.description}
            category={post.category}
            categoryLabel={getCategoryLabel(post.category)}
            publishedAt={post.publishedAt}
            featuredImage={post.featuredImage}
            readMoreText="Read More"
            basePath="/blog"
            staggerIndex={index % 3}
          />
        ))}
      </div>

      <Pagination
        currentPage={1}
        totalPages={totalGridPages}
        basePath="/blog"
        previousText="Previous"
        nextText="Next"
        pageText="Page"
      />
    </div>
  </section>
</BaseLayout>
