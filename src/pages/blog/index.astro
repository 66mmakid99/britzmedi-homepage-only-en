---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Blog posts data (will be replaced with Keystatic content)
const blogPosts = [
  {
    slug: 'fda-510k-clearance-process',
    title: 'Understanding FDA 510(k) Clearance for Medical Devices',
    description: 'A comprehensive guide to the FDA 510(k) clearance process for medical device manufacturers looking to enter the US market.',
    tldr: 'FDA 510(k) clearance requires demonstrating substantial equivalence to a predicate device. The process typically takes 3-6 months and involves quality system compliance, biocompatibility testing, and clinical data.',
    author: 'BRITZMEDI Team',
    publishedAt: '2025-12-15',
    category: 'education',
    tags: ['FDA', 'Regulatory', 'Medical Devices'],
    featuredImage: '/images/blog/fda-510k.jpg',
    featured: true,
  },
  {
    slug: 'rf-technology-aesthetic-medicine',
    title: 'RF Technology in Aesthetic Medicine: A 2025 Overview',
    description: 'Explore how radiofrequency technology is transforming aesthetic treatments with improved safety and efficacy.',
    tldr: 'Modern RF devices use multi-frequency technology for customized skin tightening treatments. Key innovations include real-time temperature monitoring and auto-circular motion for even energy delivery.',
    author: 'BRITZMEDI Team',
    publishedAt: '2025-11-28',
    category: 'technology',
    tags: ['RF Technology', 'Aesthetic Medicine', 'TORR RF'],
    featuredImage: '/images/blog/rf-technology.jpg',
    featured: true,
  },
  {
    slug: 'korean-beauty-device-market',
    title: 'Korean Beauty Device Market: Global Expansion Trends',
    description: 'How Korean medical device manufacturers are leading innovation in the global aesthetic market.',
    tldr: 'Korean beauty device exports grew 23% in 2024. Key success factors include FDA/CE certifications, advanced R&D, and focus on non-invasive treatments.',
    author: 'BRITZMEDI Team',
    publishedAt: '2025-10-20',
    category: 'industry-news',
    tags: ['K-Beauty', 'Market Trends', 'Export'],
    featuredImage: '/images/blog/korean-market.jpg',
    featured: false,
  },
];

const categories = [
  { value: 'all', label: 'All Posts' },
  { value: 'industry-news', label: 'Industry News' },
  { value: 'product-updates', label: 'Product Updates' },
  { value: 'technology', label: 'Technology' },
  { value: 'clinical-studies', label: 'Clinical Studies' },
  { value: 'education', label: 'Education' },
];

// Structured data for BlogPosting list
const blogListSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  'name': 'BRITZMEDI Blog',
  'description': 'Industry insights, product updates, and educational content from BRITZMEDI',
  'url': 'https://britzmedi.com/blog',
  'publisher': {
    '@type': 'Organization',
    'name': 'BRITZMEDI Co., Ltd.',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://britzmedi.com/logo.png'
    }
  },
  'blogPost': blogPosts.map(post => ({
    '@type': 'BlogPosting',
    'headline': post.title,
    'description': post.description,
    'author': {
      '@type': 'Organization',
      'name': post.author
    },
    'datePublished': post.publishedAt,
    'url': `https://britzmedi.com/blog/${post.slug}`
  }))
};
---

<BaseLayout
  title="Blog"
  description="Industry insights, product updates, and educational content about aesthetic medical devices from BRITZMEDI."
  keywords={['medical device blog', 'aesthetic medicine', 'RF technology', 'FDA clearance', 'K-beauty devices']}
>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(blogListSchema)} />

  <!-- Hero Section -->
  <section class="bg-gradient-hero py-16 lg:py-24">
    <div class="container">
      <div class="max-w-3xl">
        <span class="label mb-4">Blog & Insights</span>
        <h1 class="heading-1 mb-6">
          Industry Insights & Updates
        </h1>
        <p class="body-large max-w-2xl">
          Stay informed with the latest news, technology insights, and educational content from the aesthetic medical device industry.
        </p>
      </div>
    </div>
  </section>

  <!-- Blog Posts -->
  <section class="section">
    <div class="container">
      <!-- Category Filter -->
      <div class="flex flex-wrap gap-2 mb-12">
        {categories.map((cat) => (
          <button
            data-category={cat.value}
            class:list={[
              'px-4 py-2 rounded-full text-sm font-medium transition-all',
              cat.value === 'all'
                ? 'bg-primary-600 text-white'
                : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'
            ]}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Featured Posts -->
      <div class="mb-16">
        <h2 class="heading-3 mb-8">Featured Articles</h2>
        <div class="grid md:grid-cols-2 gap-8">
          {blogPosts.filter(p => p.featured).map((post) => (
            <article class="card-premium overflow-hidden group">
              <div class="aspect-video bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-900 relative">
                <div class="absolute inset-0 flex items-center justify-center">
                  <svg class="w-16 h-16 text-slate-300 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <span class="absolute top-4 left-4 badge-premium">Featured</span>
              </div>
              <div class="p-6">
                <div class="flex items-center gap-3 mb-3 text-sm text-slate-500 dark:text-slate-400">
                  <span class="capitalize">{post.category.replace('-', ' ')}</span>
                  <span>•</span>
                  <time datetime={post.publishedAt}>{new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
                </div>
                <h3 class="heading-3 mb-3 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                  <a href={`/blog/${post.slug}`} class="hover:underline">
                    {post.title}
                  </a>
                </h3>
                <p class="body-base mb-4 line-clamp-2">{post.description}</p>
                <div class="flex flex-wrap gap-2">
                  {post.tags.slice(0, 3).map(tag => (
                    <span class="text-xs px-2.5 py-1 bg-slate-100 dark:bg-slate-800 rounded-full text-slate-600 dark:text-slate-400">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- All Posts -->
      <div>
        <h2 class="heading-3 mb-8">All Articles</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {blogPosts.map((post) => (
            <article class="card-premium overflow-hidden group" data-category={post.category}>
              <div class="aspect-video bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-900 relative">
                <div class="absolute inset-0 flex items-center justify-center">
                  <svg class="w-12 h-12 text-slate-300 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
              </div>
              <div class="p-5">
                <div class="flex items-center gap-3 mb-2 text-sm text-slate-500 dark:text-slate-400">
                  <span class="capitalize">{post.category.replace('-', ' ')}</span>
                  <span>•</span>
                  <time datetime={post.publishedAt}>{new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</time>
                </div>
                <h3 class="text-lg font-semibold mb-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors line-clamp-2">
                  <a href={`/blog/${post.slug}`} class="hover:underline">
                    {post.title}
                  </a>
                </h3>
                <p class="body-small line-clamp-2 mb-3">{post.description}</p>
                <a
                  href={`/blog/${post.slug}`}
                  class="inline-flex items-center text-sm font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700"
                >
                  Read More
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
