---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TldrBox from '../../components/ui/TldrBox.astro';

export function getStaticPaths() {
  // Extract TL;DR text from HTML content
  function extractTldrFromContent(content: string): string {
    const match = content.match(/<h2>TL;DR<\/h2>\s*<p>([\s\S]*?)<\/p>/);
    return match ? match[1].replace(/<[^>]*>/g, '').trim() : '';
  }
  // Load dynamic blog posts from content/blog/*.json
  const dynamicPostModules = import.meta.glob('../../content/blog/*.json', { eager: true });
  const dynamicPosts = Object.values(dynamicPostModules)
    .map((mod: any) => {
      const data = mod.default || mod;
      return {
        slug: data.slug,
        title: data.title,
        description: data.excerpt || data.metaDescription || '',
        tldr: data.tldr || extractTldrFromContent(data.content || ''),
        author: data.author || 'BRITZMEDI Team',
        publishedAt: data.publishedAt,
        updatedAt: data.updatedAt || data.publishedAt,
        category: data.category || 'medical-devices',
        tags: data.tags || [],
        content: (data.content || '').replace(/<h1[^>]*>[\s\S]*?<\/h1>\s*/i, ''),
        faqs: (data.faqs || []) as { question: string; answer: string }[],
        featuredImage: data.featuredImage || null,
        youtubeEmbedUrl: data.youtubeEmbedUrl || null,
        doctor: data.doctor || null,
        relatedResources: data.relatedResources || [],
        isDynamic: true,
        status: data.status || 'published',
      };
    })
    .filter(post => post.status === 'published');

  const posts = [
    {
      slug: 'korean-beauty-device-market',
      title: 'Korean Aesthetic Device Market: Why Global Distributors Are Partnering with Korean Manufacturers',
      description: 'Market data, regulatory landscape, and partnership opportunities in the Korean aesthetic device industry. A strategic guide for international distributors evaluating Korean manufacturers.',
      tldr: 'South Korea is the world\'s 4th largest medical device exporter with beauty device exports growing 23% in 2024. Korean manufacturers combine competitive R&D, multi-market regulatory clearances (FDA, CE, MFDS), and strong OEM/ODM capabilities. For distributors, Korean partnerships offer high-margin products with proven technology.',
      author: 'BRITZMEDI Team',
      publishedAt: '2025-10-20',
      updatedAt: '2026-01-20',
      category: 'industry-news',
      tags: ['Korean Medical Devices', 'K-Beauty', 'Market Analysis', 'Distribution Partnership', 'Aesthetic Industry', 'Global Trade'],
      content: `
## Korea's Position in the Global Aesthetic Device Market

South Korea has established itself as a powerhouse in the global aesthetic medical device industry. The numbers reflect a market that has moved well beyond the "emerging" label:

- South Korea is the **4th largest medical device exporter** globally, behind the US, Germany, and Japan
- Korean medical device exports reached **$9.7 billion in 2024**, with aesthetic devices representing a rapidly growing segment
- Korean beauty and aesthetic device exports grew **23% year-over-year** in 2024
- The domestic Korean aesthetic market is valued at approximately **$4.2 billion**, serving as a sophisticated testing ground for global products
- Over **6,000 medical device manufacturers** operate in South Korea, with hundreds specializing in aesthetic devices

For international distributors, the Korean aesthetic device market represents a unique combination of innovation, quality, regulatory compliance, and value that is difficult to find elsewhere.

## Why Korean Manufacturers Lead Innovation

Several structural factors explain Korea's competitive position in aesthetic device manufacturing:

**Massive R&D Investment**: South Korea invests approximately 4.9% of GDP in research and development — one of the highest rates globally. The medical device sector benefits from this broader R&D ecosystem, including materials science, electronics, and software engineering expertise.

**Government Support**: The Korean government actively supports medical device exports through programs including:
- KOTRA (Korea Trade-Investment Promotion Agency) export support
- KGMP (Korea Good Manufacturing Practice) compliance infrastructure
- Tax incentives for medical device R&D
- Trade mission and exhibition support programs

**Sophisticated Domestic Market**: Korea has one of the highest per-capita rates of aesthetic procedures globally. Korean manufacturers develop products for a demanding domestic market first, then adapt them for global distribution. This means products are clinically validated and market-tested before they reach international partners.

**Manufacturing Excellence**: Korea's electronics and precision manufacturing heritage translates directly to medical device production. Korean manufacturers deliver consistent quality with competitive production costs, enabling attractive margins for distributors.

**Speed to Market**: Korean manufacturers are known for rapid product development cycles. From concept to market-ready product, Korean companies often deliver in 12-18 months — significantly faster than many Western competitors.

## Regulatory Excellence

One of the strongest arguments for partnering with Korean manufacturers is their regulatory track record across multiple markets:

**MFDS (Ministry of Food and Drug Safety)**: Korea's domestic regulatory body maintains standards that are recognized internationally. MFDS approval demonstrates compliance with rigorous safety and efficacy requirements.

**FDA 510(k) Clearance**: Leading Korean manufacturers invest in FDA clearance to access the US market. Companies like BRITZMEDI hold active 510(k) clearances, enabling immediate distribution in the United States.

**CE Marking (EU MDR)**: Korean manufacturers increasingly hold CE marking under the new EU Medical Device Regulation (MDR 2017/745), demonstrating compliance with the EU's enhanced safety requirements.

**Multi-Market Certifications**: Top-tier Korean manufacturers maintain certifications across 20 or more countries, reducing the regulatory burden for distributors entering new markets.

**ISO 13485 Compliance**: Korean medical device manufacturers overwhelmingly maintain ISO 13485 quality management systems, providing a documented quality foundation that meets international distributor requirements.

## Key Product Categories

Korean manufacturers lead innovation across several aesthetic device categories:

**Radiofrequency (RF) Devices**: Multi-wave RF systems, RF microneedling, and combination RF platforms. Korean manufacturers have pioneered advanced temperature control and multi-frequency capabilities in this space.

**High-Intensity Focused Ultrasound (HIFU)**: Korea is a global leader in HIFU device manufacturing for non-invasive face lifting and body contouring. Korean HIFU devices are widely used across Asia, Europe, and the Middle East.

**LED and Light Therapy**: Korean manufacturers produce a wide range of LED panels, masks, and targeted light therapy devices for skin rejuvenation, acne treatment, and wound healing.

**Laser Systems**: From fractional CO2 to Nd:YAG and diode lasers, Korean manufacturers offer comprehensive laser portfolios at competitive price points without compromising on performance.

**Combination Platforms**: Increasingly, Korean manufacturers are developing multi-modality platforms that combine RF, ultrasound, LED, and other technologies in a single device, maximizing clinic versatility and reducing capital equipment costs.

## The Distributor Opportunity

For international distributors, Korean aesthetic devices offer compelling business advantages:

**Competitive Margins**: Korean manufacturers' efficient production costs translate to attractive wholesale pricing. Distributors typically achieve **50-70% gross margins** on Korean aesthetic devices, compared to 30-50% on devices from Western manufacturers.

**Product Differentiation**: Korean innovation in areas like multi-wave RF technology provides genuine technical differentiation that supports premium positioning in your market.

**OEM and ODM Options**: Many Korean manufacturers offer OEM (Original Equipment Manufacturing) and ODM (Original Design Manufacturing) options, allowing distributors to build their own branded device portfolios.

**Comprehensive Support**: Leading Korean manufacturers provide distributors with clinical training, marketing materials, technical support, and regulatory documentation. This turnkey approach reduces the barrier to entry for new distributors.

**Growing Brand Recognition**: K-beauty's global reputation creates natural consumer awareness and curiosity about Korean aesthetic technology. This brand halo effect benefits distributors marketing Korean-manufactured devices.

## How to Evaluate a Korean Manufacturer

Not all Korean manufacturers are equal. Use this checklist to identify the right manufacturing partner:

**Regulatory Portfolio**
- Does the manufacturer hold FDA 510(k) clearance for the products you want to distribute?
- Is CE marking available for European markets?
- What country-specific certifications are maintained?
- Is the manufacturer ISO 13485 certified?

**R&D Capabilities**
- Does the company invest in proprietary technology development?
- How many patents does the manufacturer hold?
- What is the product development pipeline?
- Are clinical studies available to support marketing claims?

**Manufacturing Quality**
- Is the production facility KGMP (Korea GMP) certified?
- What quality control processes are in place?
- Can the manufacturer scale production to meet your volume requirements?
- What is the track record for product reliability and defect rates?

**Distributor Support**
- Does the manufacturer provide clinical training programs?
- Are marketing materials and patient education resources available?
- What warranty and after-sales service support is offered?
- Is there a dedicated international sales team?

**Business Stability**
- How long has the company been manufacturing medical devices?
- What is the financial stability of the company?
- How many international distribution partners does the manufacturer currently support?
- What is the company's reputation among existing distributors?

## BRITZMEDI: Your Gateway to Korean Innovation

BRITZMEDI exemplifies the advantages of partnering with a Korean aesthetic device manufacturer:

**Proven Technology**: The TORR RF Multi-Wave Radiofrequency System represents Korean innovation at its best — multi-frequency capability (1, 2, 4 MHz), real-time temperature control, patented auto circular motion, and broad clinical applications from a single platform.

**Global Regulatory Compliance**: FDA 510(k) cleared (K212561), CE marked, MFDS approved, with certifications in over 20 countries. Your regulatory pathway is already established.

**Distributor-Focused Approach**: BRITZMEDI provides comprehensive support including clinical training, marketing materials, technical documentation, and dedicated account management for distribution partners.

**Manufacturing Excellence**: ISO 13485 certified facility with rigorous quality control and the capacity to support distributors across global markets.

**Partnership Model**: BRITZMEDI seeks long-term distribution partnerships built on mutual success. The company provides exclusive territory options, co-marketing support, and ongoing product training to ensure distributor success.

Ready to explore a distribution partnership? [Contact BRITZMEDI](/contact) to discuss territory availability, pricing, and partnership terms.
      `,
      faqs: [
        {
          question: 'What is the minimum order quantity for BRITZMEDI distribution partnerships?',
          answer: 'BRITZMEDI offers flexible order quantities based on market size and territory agreements. Initial orders typically start from 5-10 units for new markets, with volume pricing available for larger commitments. Contact our international sales team for specific territory pricing.'
        },
        {
          question: 'Does BRITZMEDI offer exclusive distribution territories?',
          answer: 'Yes, BRITZMEDI offers exclusive territory agreements for qualified distribution partners. Exclusivity terms are based on market potential, distributor capabilities, and mutual commitment to sales targets. This ensures your investment in the brand is protected.'
        },
        {
          question: 'What regulatory support does BRITZMEDI provide for new market entry?',
          answer: 'BRITZMEDI provides comprehensive regulatory support including technical documentation packages, clinical data summaries, and guidance on country-specific registration requirements. The company has successfully registered products in over 20 countries and can leverage this experience to support your market entry process.'
        },
        {
          question: 'How does BRITZMEDI support distributor marketing efforts?',
          answer: 'BRITZMEDI provides a complete marketing toolkit including product brochures, clinical before-and-after photography, treatment protocol guides, social media content assets, and KOL (Key Opinion Leader) introduction support. Materials are available in multiple languages and can be customized with distributor branding.'
        }
      ]
    }
  ];

  const allPosts = [...posts, ...dynamicPosts];

  return allPosts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;

// Reading time calculation
const wordCount = post.content.replace(/<[^>]*>/g, '').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// Extract TOC headings from content
function extractTocHeadings(content: string, isDynamic: boolean): { id: string; text: string }[] {
  const headings: { id: string; text: string }[] = [];
  if (isDynamic) {
    const matches = content.matchAll(/<h2[^>]*>(.*?)<\/h2>/gi);
    for (const match of matches) {
      const text = match[1].replace(/<[^>]*>/g, '').trim();
      const id = text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      headings.push({ id, text });
    }
  } else {
    const lines = content.split('\n');
    for (const line of lines) {
      if (line.startsWith('## ')) {
        const text = line.slice(3).trim();
        const id = text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
        headings.push({ id, text });
      }
    }
  }
  return headings;
}

const tocHeadings = extractTocHeadings(post.content, post.isDynamic);

// Add id attributes to h2 headings in content for anchor links
function addHeadingIds(content: string, isDynamic: boolean): string {
  if (isDynamic) {
    return content.replace(/<h2([^>]*)>(.*?)<\/h2>/gi, (_match, attrs, text) => {
      const plainText = text.replace(/<[^>]*>/g, '').trim();
      const id = plainText.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      return `<h2${attrs} id="${id}">${text}</h2>`;
    });
  }
  return content;
}

// Strip first <h1> from content (already shown in hero area)
function stripFirstH1(html: string): string {
  return html.replace(/<h1[^>]*>[\s\S]*?<\/h1>\s*/, '');
}

const processedContent = stripFirstH1(addHeadingIds(post.content, post.isDynamic));

// Category-based OG image fallback
const categoryOgImages: Record<string, string> = {
  'technology-guide': '/images/blog/placeholder-technology.svg',
  'clinical-reviews': '/images/blog/placeholder-clinical-studies.svg',
  'industry-news': '/images/blog/placeholder-industry-news.svg',
  'industry-trends': '/images/blog/placeholder-industry-news.svg',
  'buyer-guide': '/images/blog/placeholder-product-updates.svg',
  'product-updates': '/images/blog/placeholder-product-updates.svg',
  'medical-devices': '/images/blog/placeholder-medical-devices.svg',
  'aesthetic-technology': '/images/blog/placeholder-aesthetic-technology.svg',
  'body-contouring': '/images/blog/placeholder-body-contouring.svg',
  'education': '/images/blog/placeholder-education.svg',
};
const ogImage = post.featuredImage || categoryOgImages[post.category] || '/og-image.jpg';

// Related posts - re-load all posts for the related section
const relatedPostModules = import.meta.glob('../../content/blog/*.json', { eager: true });
const relatedDynamic = Object.values(relatedPostModules)
  .map((mod: any) => {
    const data = mod.default || mod;
    return {
      slug: data.slug,
      title: data.title,
      description: data.excerpt || data.metaDescription || '',
      category: data.category || 'medical-devices',
      publishedAt: data.publishedAt,
      featuredImage: data.featuredImage || null,
      status: data.status || 'published',
      content: data.content || '',
    };
  })
  .filter(p => p.status === 'published' && p.slug !== post.slug);

const relatedStatic = post.slug !== 'korean-beauty-device-market' ? [{
  slug: 'korean-beauty-device-market',
  title: 'Korean Aesthetic Device Market: Why Global Distributors Are Partnering with Korean Manufacturers',
  description: 'Market data, regulatory landscape, and partnership opportunities in the Korean aesthetic device industry.',
  category: 'industry-news',
  publishedAt: '2025-10-20',
  featuredImage: '/images/blog/korean-market.svg',
  content: '',
}] : [];

const allRelatable = [...relatedStatic, ...relatedDynamic]
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime());

// Same category first, then fill with others
const sameCategory = allRelatable.filter(p => p.category === post.category);
const otherPosts = allRelatable.filter(p => p.category !== post.category);
const relatedPosts = [...sameCategory, ...otherPosts].slice(0, 3);

// Article structured data
const articleSchema: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  'headline': post.title,
  'description': post.description,
  'author': {
    '@type': 'Organization',
    'name': post.author,
    'url': 'https://britzmedi.com'
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'BRITZMEDI Co., Ltd.',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://britzmedi.com/images/logos/britzmedi-logo.png'
    }
  },
  'datePublished': post.publishedAt,
  'dateModified': post.updatedAt || post.publishedAt,
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': `https://britzmedi.com/blog/${post.slug}`
  }
};

// Add doctor as author.image if available
if (post.doctor) {
  articleSchema['author'] = {
    '@type': 'Person',
    'name': post.doctor.name,
    'jobTitle': post.doctor.title || undefined,
    'image': post.doctor.image || undefined,
  };
}

// FAQ structured data (if post has FAQs)
const faqSchema = post.faqs?.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': post.faqs.map(faq => ({
    '@type': 'Question',
    'name': faq.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.answer
    }
  }))
} : null;

// Breadcrumb structured data
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Home',
      'item': 'https://britzmedi.com'
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Blog',
      'item': 'https://britzmedi.com/blog'
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': post.title,
      'item': `https://britzmedi.com/blog/${post.slug}`
    }
  ]
};
---

<BaseLayout
  title={post.title}
  description={post.description}
  keywords={post.tags}
  ogType="article"
  ogImage={ogImage}
  publishedTime={post.publishedAt}
  modifiedTime={post.updatedAt || post.publishedAt}
  author={post.author}
>
  <!-- Article Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <!-- FAQ Structured Data (if applicable) -->
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

  <!-- Breadcrumb Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Breadcrumb -->
  <nav class="container py-4 text-sm">
    <ol class="flex items-center gap-2 text-slate-500">
      <li><a href="/" class="hover:text-primary-600">Home</a></li>
      <li>/</li>
      <li><a href="/blog" class="hover:text-primary-600">Blog</a></li>
      <li>/</li>
      <li class="text-slate-700 truncate max-w-[250px]">{post.title}</li>
    </ol>
  </nav>

  <article class="blog-article">
    <!-- Category & Date -->
    <div class="blog-meta">
      <span class="category-badge">{post.category.replace('-', ' ')}</span>
      <time datetime={post.publishedAt}>
        {new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
      </time>
      {post.updatedAt && post.updatedAt !== post.publishedAt && (
        <span class="text-slate-400">
          (Updated {new Date(post.updatedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })})
        </span>
      )}
      <span class="reading-time">{readingTime} min read</span>
    </div>

    <!-- Title -->
    <h1>{post.title}</h1>

    <!-- Description -->
    <p class="text-lg" style="color: var(--color-slate-600); line-height: 1.75; margin-bottom: 1.5rem;">
      {post.description}
    </p>

    <!-- Featured Image -->
    {post.featuredImage && (
      <div class="blog-featured-image">
        <img src={post.featuredImage} alt={`Featured image for: ${post.title}`} width="800" height="450" />
      </div>
    )}

    <!-- TL;DR Box -->
    {post.tldr && (
      <TldrBox summary={post.tldr} />
    )}

    <!-- Doctor Profile (for dynamic posts) -->
    {post.doctor && (
      <div class="blog-doctor-card">
        {post.doctor.image ? (
          <img src={post.doctor.image} alt={post.doctor.name} class="doctor-avatar" />
        ) : (
          <div class="doctor-avatar-placeholder">
            {post.doctor.name?.charAt(0) || 'D'}
          </div>
        )}
        <div class="doctor-info">
          <h4>{post.doctor.name}</h4>
          {post.doctor.title && <p class="doctor-title">{post.doctor.title}</p>}
          {post.doctor.credentials && <p class="doctor-credentials">{post.doctor.credentials}</p>}
          {post.doctor.bio && <p class="doctor-bio">{post.doctor.bio}</p>}
        </div>
      </div>
    )}

    <!-- Author and Share -->
    <div class="blog-author-bar">
      <div class="author-info">
        <div class="author-avatar">B</div>
        <div>
          <p class="author-name">{post.author}</p>
          <p class="author-org">BRITZMEDI Co., Ltd.</p>
        </div>
      </div>
      <div class="share-links">
        <span>Share:</span>
        <a
          href={`https://www.linkedin.com/shareArticle?mini=true&url=https://britzmedi.com/blog/${post.slug}&title=${encodeURIComponent(post.title)}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on LinkedIn"
        >
          <svg fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=https://britzmedi.com/blog/${post.slug}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on Twitter"
        >
          <svg fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Table of Contents -->
    {tocHeadings.length > 2 && (
      <nav class="blog-toc">
        <details open>
          <summary class="blog-toc-title">Table of Contents</summary>
          <ol class="blog-toc-list">
            {tocHeadings.map(h => (
              <li><a href={`#${h.id}`}>{h.text}</a></li>
            ))}
          </ol>
        </details>
      </nav>
    )}

    <!-- Article Content -->
    <div class="blog-content">
      {post.isDynamic ? (
        <Fragment set:html={processedContent} />
      ) : (
        <Fragment set:html={post.content.split('\n').map(line => {
          if (line.startsWith('## ')) {
            const text = line.slice(3).trim();
            const id = text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
            return `<h2 id="${id}">${text}</h2>`;
          }
          if (line.startsWith('### ')) return `<h3>${line.slice(4)}</h3>`;
          if (line.startsWith('**Q:')) return `<p class="font-semibold">${line}</p>`;
          if (line.startsWith('**A:')) return `<p>${line}</p>`;
          if (line.startsWith('- **')) return `<li><strong>${line.slice(4).split('**')[0]}</strong>: ${line.split('**')[2] || ''}</li>`;
          if (line.startsWith('- ')) return `<li>${line.slice(2)}</li>`;
          if (line.match(/^\d+\./)) return `<li>${line.slice(line.indexOf(' ') + 1)}</li>`;
          if (line.trim() === '') return '<br />';
          return `<p>${line}</p>`;
        }).join('')} />
      )}
    </div>

    <!-- Related Resources -->
    {post.relatedResources?.length > 0 && (
      <section class="blog-related-resources">
        <h2>Related Resources</h2>
        <div class="resources-grid">
          {post.relatedResources.map((resource: { type: string; title: string; url: string; source: string }) => (
            <a href={resource.url} target="_blank" rel="noopener noreferrer" class="resource-card">
              <span class="resource-icon">
                {resource.type === 'video' ? '\uD83C\uDFAC' : resource.type === 'paper' ? '\uD83D\uDCC4' : '\uD83D\uDCF0'}
              </span>
              <div class="resource-info">
                <h3>{resource.title}</h3>
                <span class="resource-source">{resource.source}</span>
              </div>
              <svg class="resource-external-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- FAQ Section -->
    {post.faqs?.length > 0 && (
      <section class="blog-faq-section">
        <h2>Frequently Asked Questions</h2>
        {post.faqs.map((faq) => (
          <details class="blog-faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </section>
    )}

    <!-- Tags -->
    <div class="blog-tags">
      {post.tags.map(tag => (
        <span class="tag">#{tag}</span>
      ))}
    </div>

    <!-- Related Posts -->
    {relatedPosts.length > 0 && (
      <section class="blog-related-posts">
        <h2>Related Articles</h2>
        <div class="related-posts-grid">
          {relatedPosts.map(rp => (
            <a href={`/blog/${rp.slug}`} class="related-post-card">
              {rp.featuredImage ? (
                <img src={rp.featuredImage} alt={`Featured image for: ${rp.title}`} width="320" height="180" loading="lazy" />
              ) : (
                <div class="related-post-placeholder" style="width:320px;height:180px;background:linear-gradient(135deg,#e8f4f8,#d1e7f0);display:flex;align-items:center;justify-content:center;border-radius:8px;">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                </div>
              )}
              <div class="related-post-info">
                <h3>{rp.title}</h3>
                <p>{rp.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Back to Blog -->
    <div style="margin-top: 2rem;">
      <a
        href="/blog"
        class="inline-flex items-center text-primary-600 font-medium hover:text-primary-700"
        style="text-decoration: none;"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Blog
      </a>
    </div>
  </article>
</BaseLayout>
