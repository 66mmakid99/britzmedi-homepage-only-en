---
import BaseLayout from '../layouts/BaseLayout.astro';
import { faqItems, faqCategories, getFAQsByCategory } from '../content/faq';

const pageDescription = "Frequently asked questions about BRITZMEDI products, company, ordering, technical support, and certifications. Find answers to common questions about TORR RF, ULBLANC, and more.";

// Generate FAQ Schema for SEO
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<BaseLayout
  title="FAQ"
  description={pageDescription}
  keywords={["BRITZMEDI FAQ", "medical device questions", "TORR RF FAQ", "aesthetic device FAQ", "distributor FAQ"]}
>
  <!-- FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-hero py-16 lg:py-24">
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-primary-500/5 rounded-full blur-3xl"></div>
    <div class="container relative">
      <div class="max-w-3xl">
        <span class="label mb-4">Support</span>
        <h1 class="heading-1 mb-6">
          Frequently Asked<br />
          <span class="bg-gradient-to-r from-primary-600 to-primary-500 bg-clip-text text-transparent">Questions</span>
        </h1>
        <p class="body-large">
          Find answers to common questions about our products, company, ordering process,
          technical support, and certifications.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ Categories Navigation -->
  <section class="sticky top-16 lg:top-20 z-50 bg-white/95 backdrop-blur-lg border-b border-slate-200/50">
    <div class="container">
      <nav class="flex gap-2 py-4 overflow-x-auto scrollbar-hide">
        {faqCategories.map((category) => (
          <a
            href={`#${category.id}`}
            class="shrink-0 px-4 py-2 text-sm font-medium text-slate-600 hover:text-primary-600 hover:bg-primary-50 rounded-lg transition-colors"
          >
            {category.name}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- FAQ Content -->
  <section class="section bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        {faqCategories.map((category) => {
          const categoryFaqs = getFAQsByCategory(category.id);
          return (
            <div id={category.id} class="mb-16 scroll-mt-32">
              <h2 class="heading-3 mb-8 flex items-center gap-3">
                <span class="w-10 h-10 bg-gradient-to-br from-primary-50 to-primary-100 rounded-xl flex items-center justify-center">
                  <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    {category.id === 'products' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />}
                    {category.id === 'company' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />}
                    {category.id === 'ordering' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />}
                    {category.id === 'technical' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z" />}
                    {category.id === 'certifications' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />}
                  </svg>
                </span>
                {category.name}
              </h2>

              <div class="space-y-4">
                {categoryFaqs.map((faq) => (
                  <details class="group card-premium overflow-hidden" id={faq.id}>
                    <summary class="flex items-center justify-between gap-4 p-6 cursor-pointer list-none">
                      <h3 class="text-base font-semibold text-slate-900 group-hover:text-primary-600 transition-colors pr-4">
                        {faq.question}
                      </h3>
                      <span class="shrink-0 w-8 h-8 bg-slate-100 rounded-lg flex items-center justify-center group-open:bg-primary-100 transition-colors">
                        <svg class="w-4 h-4 text-slate-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                      </span>
                    </summary>
                    <div class="px-6 pb-6 pt-0">
                      <div class="prose prose-slate max-w-none">
                        <p class="text-slate-600 leading-relaxed">
                          {faq.answer}
                        </p>
                      </div>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Still Have Questions CTA -->
  <section class="section bg-gradient-section">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="heading-2 mb-4">Still Have Questions?</h2>
        <p class="body-large mb-8">
          Can't find what you're looking for? Our team is here to help.
          Contact us and we'll get back to you within 1-2 business days.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="btn-primary">
            Contact Us
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a href="mailto:contact@britzmedi.co.kr" class="btn-secondary">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Email Us Directly
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hide scrollbar but allow scrolling */
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }

  /* Smooth details animation */
  details[open] summary ~ * {
    animation: sweep 0.3s ease-out;
  }

  @keyframes sweep {
    0% {
      opacity: 0;
      transform: translateY(-10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
