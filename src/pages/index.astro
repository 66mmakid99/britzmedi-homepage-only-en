---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company, milestones, coreTechnologies } from '../content/company';
import { products, getFeaturedProducts } from '../content/products';
import { certifications, qualitySummary } from '../content/certifications';
import homepageConfig from '../data/homepage.json';
import type { HomepageConfig } from '../data/homepage.types';
import newsData from '../data/news.json';

const config = homepageConfig as HomepageConfig;
const featuredProducts = products.filter(p => p.status === 'available').slice(0, config.featuredProducts.displayCount);

// Latest news
const latestNews = (newsData as any[])
  .filter(n => n.published)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, config.latestNews?.displayCount || 3);

const NEWS_CATEGORY_COLORS: Record<string, string> = {
  event: 'bg-blue-100 text-blue-700',
  product: 'bg-green-100 text-green-700',
  partnership: 'bg-purple-100 text-purple-700',
  award: 'bg-amber-100 text-amber-700',
  media: 'bg-pink-100 text-pink-700',
};

function formatNewsDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

// Map appliedTo text to product page URLs
const techProductLinks: Record<string, { href: string; label: string }> = {
  'LUMINO WAVE': { href: '/products/lumino-wave', label: 'LUMINO WAVE' },
  'TORR RF': { href: '/products/torr-rf', label: 'TORR RF' },
  'ULBLANC (i-Booster)': { href: '/products/ulblanc', label: 'ULBLANC (i-Booster)' },
};
---

<BaseLayout
  title="Home"
  description="BRITZMEDI manufactures FDA 510(k) cleared aesthetic medical devices in Korea. Explore TORR RF multi-wave RF and innovative skin tightening technology. Request a demo today."
  keywords={["BRITZMEDI", "medical aesthetic device manufacturer", "RF technology", "Korean medical device", "TORR RF", "FDA cleared", "skin tightening device", "body contouring"]}
>
  {config.hero.backgroundType === 'image' && config.hero.backgroundImage && (
    <link slot="head" rel="preload" as="image" href={config.hero.backgroundImage} />
  )}
  {config.hero.backgroundType === 'split' && config.hero.heroImage && (
    <link slot="head" rel="preload" as="image" href={config.hero.heroImage} />
  )}
  <!-- WebSite Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "BRITZMEDI",
    "alternateName": "브리츠메디",
    "url": "https://britzmedi.com",
    "description": "BRITZMEDI is a South Korean medical aesthetic device manufacturer specializing in innovative RF technology for skin tightening and body contouring.",
    "publisher": {
      "@type": "Organization",
      "name": "BRITZMEDI Co., Ltd.",
      "logo": { "@type": "ImageObject", "url": "https://britzmedi.com/images/logos/britzmedi-logo.png" }
    },
    "inLanguage": ["en", "ja", "zh", "th", "vi", "es", "fr", "ru", "ar"]
  })} />

  <!-- Hero Section with Video/Image/Gradient/Split Background Support -->
  {config.hero.backgroundType === 'split' ? (
    <!-- Hero: Full-bleed background image + gradient overlay -->
    <section id="section-hero" class="relative overflow-hidden min-h-[60vh] lg:min-h-[70vh]">
      <!-- Background image: right-aligned on desktop, centered on mobile -->
      {config.hero.heroImage && (
        <img
          src={config.hero.heroImage}
          alt={config.hero.heroImageAlt || 'BRITZMEDI'}
          width="1076"
          height="1920"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover object-[center_top] lg:object-[right_top]"
        />
      )}

      <!-- Gradient overlay: desktop (left navy → right transparent) -->
      <div class="absolute inset-0 hidden lg:block" style="background: linear-gradient(to right, rgb(15 23 42) 0%, rgb(15 23 42 / 0.95) 25%, rgb(15 23 42 / 0.7) 45%, rgb(15 23 42 / 0.3) 65%, transparent 100%)"></div>
      <!-- Gradient overlay: mobile (full dark) -->
      <div class="absolute inset-0 lg:hidden" style="background: rgb(15 23 42 / 0.8)"></div>

      <!-- Text content -->
      <div class="container relative z-10">
        <div class="py-12 sm:py-20 lg:py-28 xl:py-32 max-w-2xl">
          <div class="badge-premium mb-6 sm:mb-8 opacity-0 animate-fade-up inline-flex !bg-white/20 !border-white/30 !text-white backdrop-blur-sm">
            {config.hero.badge}
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold leading-tight mb-4 sm:mb-6 opacity-0 animate-fade-up stagger-1 !text-white drop-shadow-lg">
            {config.hero.headline}<br />
            <span class="text-primary-400">{config.hero.highlightText}</span><br />
            {config.hero.subheadline}
          </h1>

          <p class="text-base sm:text-lg lg:text-xl max-w-xl mb-5 sm:mb-8 lg:mb-10 opacity-0 animate-fade-up stagger-2 !text-slate-200 drop-shadow-md">
            {config.hero.description}
          </p>

          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 opacity-0 animate-fade-up stagger-3">
            <a href={config.hero.primaryCTA.href} class="btn-primary group justify-center sm:justify-start">
              {config.hero.primaryCTA.text}
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href={config.hero.secondaryCTA.href} class="btn-secondary justify-center sm:justify-start !bg-white/10 !border-white/30 !text-white hover:!bg-white/20 backdrop-blur-sm">
              {config.hero.secondaryCTA.text}
            </a>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section id="section-hero" class="relative overflow-hidden min-h-[600px] lg:min-h-[700px] flex items-center">
      <!-- Background Layer -->
      {config.hero.backgroundType === 'video' && config.hero.backgroundVideo && (
        <div class="absolute inset-0 z-0">
          <video
            autoplay
            muted
            loop
            playsinline
            poster={config.hero.backgroundVideoPoster}
            class="w-full h-full object-cover"
          >
            <source src={config.hero.backgroundVideo} type="video/mp4" />
          </video>
        </div>
      )}

      {config.hero.backgroundType === 'image' && config.hero.backgroundImage && (
        <div class="absolute inset-0 z-0">
          <img
            src={config.hero.backgroundImage}
            alt={config.hero.backgroundImageAlt || 'Hero background'}
            width="1920"
            height="1080"
            fetchpriority="high"
            loading="eager"
            decoding="async"
            class="w-full h-full object-cover object-[center_20%] sm:object-[center_30%] lg:object-[center_25%]"
          />
        </div>
      )}

      {config.hero.backgroundType === 'gradient' && (
        <div class="absolute inset-0 z-0 bg-gradient-hero">
          <div class="absolute -top-40 -right-40 w-80 h-80 bg-primary-500/5 rounded-full blur-3xl"></div>
          <div class="absolute top-1/2 -left-20 w-60 h-60 bg-primary-500/5 rounded-full blur-3xl"></div>
          <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-accent-500/5 rounded-full blur-3xl"></div>
        </div>
      )}

      <!-- Overlay (for image/video backgrounds) -->
      {config.hero.backgroundType !== 'gradient' && (
        <div
          class:list={[
            "absolute inset-0 z-10",
            config.hero.overlayColor === 'dark' && "bg-slate-900",
            config.hero.overlayColor === 'light' && "bg-white",
            config.hero.overlayColor === 'primary' && "bg-primary-900"
          ]}
          style={`opacity: ${config.hero.overlayOpacity / 100}`}
        />
      )}

      <!-- Content -->
      <div class="container relative z-20">
        <div class="py-20 sm:py-24 lg:py-28 xl:py-32">
          <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
            <div class="order-2 lg:order-1">
              <!-- Premium Badge -->
              <div class:list={[
                "badge-premium mb-6 sm:mb-8 opacity-0 animate-fade-up inline-flex",
                config.hero.backgroundType !== 'gradient' && "!bg-white/20 !border-white/30 !text-white backdrop-blur-sm"
              ]}>
                {config.hero.badge}
              </div>

              <!-- Heading -->
              <h1 class:list={[
                "text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold leading-tight mb-4 sm:mb-6 opacity-0 animate-fade-up stagger-1",
                config.hero.backgroundType !== 'gradient' && "!text-white drop-shadow-lg"
              ]}>
                {config.hero.headline}<br />
                <span class:list={[
                  config.hero.backgroundType === 'gradient'
                    ? "bg-gradient-to-r from-primary-600 via-primary-500 to-primary-600 bg-clip-text text-transparent"
                    : "text-primary-400"
                ]}>{config.hero.highlightText}</span><br />
                {config.hero.subheadline}
              </h1>

              <!-- Description -->
              <p class:list={[
                "text-base sm:text-lg lg:text-xl max-w-xl mb-8 sm:mb-10 opacity-0 animate-fade-up stagger-2",
                config.hero.backgroundType !== 'gradient' && "!text-slate-200 drop-shadow-md"
              ]}>
                {config.hero.description}
              </p>

              <!-- CTAs -->
              <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 opacity-0 animate-fade-up stagger-3">
                <a href={config.hero.primaryCTA.href} class="btn-primary group justify-center sm:justify-start">
                  {config.hero.primaryCTA.text}
                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
                <a href={config.hero.secondaryCTA.href} class:list={[
                  "btn-secondary justify-center sm:justify-start",
                  config.hero.backgroundType !== 'gradient' && "!bg-white/10 !border-white/30 !text-white hover:!bg-white/20 backdrop-blur-sm"
                ]}>
                  {config.hero.secondaryCTA.text}
                </a>
              </div>
            </div>

            <div class="order-1 lg:order-2 hidden lg:block"></div>
          </div>
        </div>
      </div>

      <!-- Bottom gradient fade -->
      <div class:list={[
        "absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t z-20",
        config.hero.backgroundType === 'gradient' ? "from-white to-transparent" : "from-slate-900/50 to-transparent"
      ]}></div>
    </section>
  )}

  <!-- Trust Badges Section -->
  <section id="section-badges" class="py-6 sm:py-10 lg:py-20 bg-white relative">
    <div class="container">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-5 sm:gap-8 lg:gap-12">
        {config.trustBadges.badges.map((badge) => (
          <a href="/certifications" class="text-center group block">
            <div class="inline-flex items-center justify-center w-16 h-16 mb-4 bg-gradient-to-br from-primary-50 to-primary-100 rounded-2xl group-hover:shadow-lg group-hover:shadow-primary-500/10 transition-shadow">
              <span class="text-2xl font-bold bg-gradient-to-br from-primary-600 to-primary-700 bg-clip-text text-transparent">{badge.label}</span>
            </div>
            <div class="text-sm font-medium text-slate-900">{badge.title}</div>
            <div class="text-xs text-slate-500 mt-1">{badge.subtitle}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Products Section -->
  <section id="section-products" class="py-8 sm:py-12 lg:py-20 bg-gradient-section">
    <div class="container">
      <!-- Section Header -->
      <div class="max-w-2xl mb-8 lg:mb-14">
        <span class="label mb-4">{config.featuredProducts.label}</span>
        <h2 class="heading-2 mb-3 lg:mb-5">{config.featuredProducts.title}</h2>
        <p class="body-large">
          {config.featuredProducts.description}
        </p>
      </div>

      <!-- Products Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {featuredProducts.map((product, index) => (
          <a
            href={`/products/${product.id}`}
            class="group card-premium p-5 sm:p-6 lg:p-7"
          >
            <!-- Product Image -->
            <div class="aspect-[4/3] rounded-xl mb-4 sm:mb-6 overflow-hidden bg-slate-100">
              <img
                src={product.images?.main || ''}
                alt={product.name}
                width="800"
                height="600"
                loading="eager"
                decoding="async"
                style="width:100%;height:100%;object-fit:cover;"
              />
            </div>

            <!-- Badge -->
            {product.featured && (
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 mb-4 text-xs font-semibold bg-gradient-to-r from-primary-50 to-primary-100 text-primary-700 rounded-full border border-primary-200/50">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                Flagship Product
              </span>
            )}

            <!-- Content -->
            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <h3 class="text-xl font-bold text-slate-900 group-hover:text-primary-600 transition-colors">{product.name}</h3>
                <p class="text-sm text-primary-600 font-medium mt-1">{product.tagline}</p>
              </div>
              <div class="w-10 h-10 rounded-xl bg-slate-100 group-hover:bg-primary-100 flex items-center justify-center shrink-0 transition-colors">
                <svg class="w-5 h-5 text-slate-400 group-hover:text-primary-600 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>

            <p class="body-small line-clamp-2 mb-5">{product.overview}</p>

            <!-- Certifications -->
            {product.certifications && product.certifications.length > 0 && (
              <div class="flex flex-wrap gap-2 pt-5 border-t border-slate-100">
                {product.certifications.slice(0, 2).map((cert) => (
                  <span class="inline-flex items-center gap-1 text-xs font-medium text-slate-600 bg-slate-50 px-2.5 py-1 rounded-lg">
                    <svg class="w-3 h-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    {cert.name}
                  </span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>

      <!-- View All Link -->
      <div class="mt-8 lg:mt-12 text-center">
        <a href="/products" class="inline-flex items-center gap-2 text-primary-600 font-semibold hover:text-primary-700 transition-colors link-underline">
          View all products
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Why BRITZMEDI Section -->
  <section id="section-why" class="py-8 sm:py-12 lg:py-20 bg-white">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-20 items-center">
        <!-- Content -->
        <div>
          <span class="label mb-4">{config.whyBritzMedi.label}</span>
          <h2 class="heading-2 mb-4 lg:mb-6">
            {config.whyBritzMedi.title.split('\n').map((line, i) => (
              <>{i > 0 && <br />}{line}</>
            ))}
          </h2>
          <p class="body-large mb-6 lg:mb-10">
            {config.whyBritzMedi.description || company.philosophy}
          </p>

          <!-- Features List -->
          <div class="space-y-4 lg:space-y-6">
            {config.whyBritzMedi.features.map((feature) => (
              <div class="flex gap-5 group">
                <div class="shrink-0 w-14 h-14 bg-gradient-to-br from-primary-50 to-primary-100 rounded-2xl flex items-center justify-center group-hover:shadow-lg group-hover:shadow-primary-500/10 transition-shadow">
                  <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={feature.iconPath} />
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-slate-900 mb-1.5">{feature.title}</h3>
                  <p class="body-small">{feature.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Stats Card -->
        <div class="relative">
          <div class="absolute -inset-4 bg-gradient-to-br from-primary-500/5 to-accent-500/5 rounded-3xl blur-2xl"></div>
          <div class="relative bg-white rounded-2xl border border-slate-200/80 p-5 sm:p-8 lg:p-10 shadow-xl shadow-slate-200/50">
            <h3 class="text-lg font-bold text-slate-900 mb-6 sm:mb-8">{config.whyBritzMedi.statsTitle}</h3>

            <div class="space-y-4 sm:space-y-6">
              {config.whyBritzMedi.stats.map((stat, i) => (
                <div class:list={["flex items-center justify-between gap-4", i < config.whyBritzMedi.stats.length - 1 && "pb-4 sm:pb-6 border-b border-slate-100"]}>
                  <span class="text-sm sm:text-base text-slate-600">{stat.label}</span>
                  {stat.type === 'badge' ? (
                    <span class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1 sm:py-1.5 text-xs sm:text-sm font-semibold bg-gradient-to-r from-green-50 to-emerald-50 text-green-700 rounded-full border border-green-200/50 shrink-0">
                      <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
                      {stat.badgeText || stat.value}
                    </span>
                  ) : (
                    <span class="text-2xl sm:text-3xl font-bold bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent shrink-0">{stat.value}</span>
                  )}
                </div>
              ))}
            </div>

            <div class="mt-8 pt-8 border-t border-slate-100">
              <a href={config.whyBritzMedi.learnMoreHref} class="inline-flex items-center gap-2 text-primary-600 font-semibold hover:text-primary-700 transition-colors link-underline">
                {config.whyBritzMedi.learnMoreText}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Technologies Section -->
  <section id="section-tech" class="py-8 sm:py-12 lg:py-20 bg-gradient-section">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-8 lg:mb-14">
        <span class="label mb-4 justify-center">{config.coreTechnologies.label}</span>
        <h2 class="heading-2 mb-3 lg:mb-5">{config.coreTechnologies.title}</h2>
        <p class="body-large">
          {config.coreTechnologies.description}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 lg:gap-8">
        {coreTechnologies.map((tech, index) => (
          <div class="card-premium p-5 sm:p-7 lg:p-8 group">
            <div class="w-14 h-14 bg-gradient-to-br from-primary-100 to-primary-50 rounded-2xl flex items-center justify-center mb-4 sm:mb-6 group-hover:shadow-lg group-hover:shadow-primary-500/10 transition-shadow">
              <svg class="w-7 h-7 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3">{tech.name}</h3>
            <p class="body-base mb-5">{tech.description}</p>
            {techProductLinks[tech.appliedTo] ? (
              <a href={techProductLinks[tech.appliedTo].href} class="inline-flex items-center gap-2 text-sm font-semibold text-primary-600 bg-primary-50 hover:bg-primary-100 px-3 py-1.5 rounded-lg transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                {techProductLinks[tech.appliedTo].label}
              </a>
            ) : (
              <div class="inline-flex items-center gap-2 text-sm font-semibold text-primary-600 bg-primary-50 px-3 py-1.5 rounded-lg">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                {tech.appliedTo}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest News Section -->
  {config.latestNews?.enabled && latestNews.length > 0 && (
    <section id="section-news" class="py-8 sm:py-12 lg:py-20 bg-white">
      <div class="container">
        <div class="flex items-end justify-between mb-8 lg:mb-14">
          <div class="max-w-2xl">
            <span class="label mb-4">{config.latestNews.label}</span>
            <h2 class="heading-2 mb-3 lg:mb-5">{config.latestNews.title}</h2>
            <p class="body-large">{config.latestNews.description}</p>
          </div>
          <a href="/news" class="hidden sm:inline-flex items-center gap-2 text-primary-600 font-semibold hover:text-primary-700 transition-colors link-underline shrink-0">
            View All
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
          {latestNews.map((item: any) => (
            <a href={`/news/${item.id}`} class="group card-premium overflow-hidden">
              <div class="aspect-[16/9] bg-slate-100 overflow-hidden">
                {item.image ? (
                  <img
                    src={item.image}
                    alt={item.title}
                    width="600"
                    height="338"
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-slate-100 to-slate-200">
                    <svg class="w-12 h-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                    </svg>
                  </div>
                )}
              </div>
              <div class="p-5 sm:p-6">
                <div class="flex items-center gap-3 mb-3">
                  <span class:list={['inline-block text-xs font-medium px-2.5 py-1 rounded-full', NEWS_CATEGORY_COLORS[item.category] || 'bg-slate-100 text-slate-600']}>
                    {item.category.charAt(0).toUpperCase() + item.category.slice(1)}
                  </span>
                  <span class="text-xs text-slate-400">{formatNewsDate(item.date)}</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-primary-600 transition-colors line-clamp-2">
                  {item.title}
                </h3>
                <p class="body-small line-clamp-2">{item.summary}</p>
              </div>
            </a>
          ))}
        </div>

        <div class="mt-8 text-center sm:hidden">
          <a href="/news" class="inline-flex items-center gap-2 text-primary-600 font-semibold hover:text-primary-700 transition-colors">
            View All News
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section id="section-cta" class="py-8 sm:py-12 lg:py-20 relative overflow-hidden">
    <!-- Background -->
    <div class="absolute inset-0 bg-gradient-to-br from-primary-600 via-primary-700 to-primary-800"></div>
    <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'0.03\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')]"></div>

    <div class="container relative">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-3xl lg:text-4xl xl:text-5xl font-bold text-white mb-3 lg:mb-5">
          {config.cta.title}
        </h2>
        <p class="text-lg text-primary-100 mb-6 lg:mb-10 leading-relaxed">
          {config.cta.description}
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href={config.cta.primaryCTA.href}
            class="group inline-flex items-center gap-2 px-7 py-4 text-base font-semibold text-primary-700 bg-white hover:bg-primary-50 rounded-xl shadow-lg shadow-black/10 transition-all"
          >
            {config.cta.primaryCTA.text}
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href={config.cta.secondaryCTA.href}
            class="inline-flex items-center gap-2 px-7 py-4 text-base font-semibold text-white border-2 border-white/20 hover:bg-white/10 rounded-xl transition-all"
          >
            {config.cta.secondaryCTA.text}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Product image fallback script -->
  <script>
    document.querySelectorAll('.product-img').forEach((img) => {
      img.addEventListener('error', () => {
        img.style.display = 'none';
        const fallback = img.closest('[data-product]')?.querySelector('.product-fallback');
        if (fallback) fallback.classList.remove('hidden');
      });
    });
  </script>
</BaseLayout>
