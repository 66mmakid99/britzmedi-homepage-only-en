---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company, milestones, coreTechnologies } from '../content/company';
import { products, getFeaturedProducts } from '../content/products';
import { certifications, qualitySummary } from '../content/certifications';

const featuredProducts = products.filter(p => p.status === 'available').slice(0, 3);
---

<BaseLayout 
  title="Home"
  description="BRITZMEDI is a leading Korean manufacturer of FDA-cleared aesthetic medical devices. Discover TORR RF and innovative skincare technology."
  keywords={["BRITZMEDI", "aesthetic medical device", "TORR RF", "FDA cleared", "Korean medical device", "RF technology", "skin tightening"]}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-hero">
    <!-- Decorative Elements -->
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute -top-40 -right-40 w-80 h-80 bg-primary-500/5 rounded-full blur-3xl"></div>
      <div class="absolute top-1/2 -left-20 w-60 h-60 bg-primary-500/5 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-accent-500/5 rounded-full blur-3xl"></div>
    </div>
    
    <div class="container relative">
      <div class="py-16 lg:py-28 xl:py-32">
        <div class="max-w-3xl">
          <!-- Premium Badge -->
          <div class="badge-premium mb-8 opacity-0 animate-fade-up">
            FDA 510(k) Cleared Medical Devices
          </div>
          
          <!-- Heading -->
          <h1 class="heading-1 mb-6 opacity-0 animate-fade-up stagger-1">
            Innovative Aesthetic<br />
            <span class="bg-gradient-to-r from-primary-600 via-primary-500 to-primary-600 bg-clip-text text-transparent">Medical Technology</span><br />
            from Korea
          </h1>
          
          <!-- Description -->
          <p class="body-large max-w-xl mb-10 opacity-0 animate-fade-up stagger-2">
            Since 2017, BRITZMEDI has been pioneering advanced RF technology and skincare solutions. 
            Our FDA-cleared devices deliver safe, effective treatments trusted by clinics worldwide.
          </p>
          
          <!-- CTAs -->
          <div class="flex flex-wrap gap-4 opacity-0 animate-fade-up stagger-3">
            <a href="/products" class="btn-primary group">
              Explore Products
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href="/contact" class="btn-secondary">
              Contact Sales
            </a>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Bottom gradient fade -->
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-white to-transparent"></div>
  </section>

  <!-- Trust Badges Section -->
  <section class="py-16 lg:py-20 bg-white relative">
    <div class="container">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 lg:gap-12">
        <div class="text-center group">
          <div class="inline-flex items-center justify-center w-16 h-16 mb-4 bg-gradient-to-br from-primary-50 to-primary-100 rounded-2xl group-hover:shadow-lg group-hover:shadow-primary-500/10 transition-shadow">
            <span class="text-2xl font-bold bg-gradient-to-br from-primary-600 to-primary-700 bg-clip-text text-transparent">FDA</span>
          </div>
          <div class="text-sm font-medium text-slate-900">510(k) Cleared</div>
          <div class="text-xs text-slate-500 mt-1">U.S. Regulatory</div>
        </div>
        <div class="text-center group">
          <div class="inline-flex items-center justify-center w-16 h-16 mb-4 bg-gradient-to-br from-primary-50 to-primary-100 rounded-2xl group-hover:shadow-lg group-hover:shadow-primary-500/10 transition-shadow">
            <span class="text-2xl font-bold bg-gradient-to-br from-primary-600 to-primary-700 bg-clip-text text-transparent">ISO</span>
          </div>
          <div class="text-sm font-medium text-slate-900">13485:2016</div>
          <div class="text-xs text-slate-500 mt-1">Quality Management</div>
        </div>
        <div class="text-center group">
          <div class="inline-flex items-center justify-center w-16 h-16 mb-4 bg-gradient-to-br from-primary-50 to-primary-100 rounded-2xl group-hover:shadow-lg group-hover:shadow-primary-500/10 transition-shadow">
            <span class="text-2xl font-bold bg-gradient-to-br from-primary-600 to-primary-700 bg-clip-text text-transparent">GMP</span>
          </div>
          <div class="text-sm font-medium text-slate-900">Certified</div>
          <div class="text-xs text-slate-500 mt-1">Manufacturing</div>
        </div>
        <div class="text-center group">
          <div class="inline-flex items-center justify-center w-16 h-16 mb-4 bg-gradient-to-br from-primary-50 to-primary-100 rounded-2xl group-hover:shadow-lg group-hover:shadow-primary-500/10 transition-shadow">
            <span class="text-2xl font-bold bg-gradient-to-br from-primary-600 to-primary-700 bg-clip-text text-transparent">11+</span>
          </div>
          <div class="text-sm font-medium text-slate-900">Patents</div>
          <div class="text-xs text-slate-500 mt-1">Registered</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Products Section -->
  <section class="section bg-gradient-section">
    <div class="container">
      <!-- Section Header -->
      <div class="max-w-2xl mb-14">
        <span class="label mb-4">Our Products</span>
        <h2 class="heading-2 mb-5">Medical Device Excellence</h2>
        <p class="body-large">
          From our flagship FDA-cleared TORR RF to innovative ultrasound solutions, 
          discover technology designed for superior clinical outcomes.
        </p>
      </div>
      
      <!-- Products Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {featuredProducts.map((product, index) => (
          <a 
            href={`/products/${product.id}`}
            class="group card-premium p-6 lg:p-7"
          >
            <!-- Product Image Placeholder -->
            <div class="aspect-[4/3] bg-gradient-to-br from-slate-100 via-slate-50 to-slate-100 rounded-xl mb-6 flex items-center justify-center relative overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-br from-primary-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
              <span class="text-5xl font-light text-slate-300 group-hover:text-primary-300 transition-colors">{product.name.charAt(0)}</span>
            </div>
            
            <!-- Badge -->
            {product.featured && (
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 mb-4 text-xs font-semibold bg-gradient-to-r from-primary-50 to-primary-100 text-primary-700 rounded-full border border-primary-200/50">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                Flagship Product
              </span>
            )}
            
            <!-- Content -->
            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <h3 class="text-xl font-bold text-slate-900 group-hover:text-primary-600 transition-colors">{product.name}</h3>
                <p class="text-sm text-primary-600 font-medium mt-1">{product.tagline}</p>
              </div>
              <div class="w-10 h-10 rounded-xl bg-slate-100 group-hover:bg-primary-100 flex items-center justify-center shrink-0 transition-colors">
                <svg class="w-5 h-5 text-slate-400 group-hover:text-primary-600 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>
            
            <p class="body-small line-clamp-2 mb-5">{product.overview}</p>
            
            <!-- Certifications -->
            {product.certifications && product.certifications.length > 0 && (
              <div class="flex flex-wrap gap-2 pt-5 border-t border-slate-100">
                {product.certifications.slice(0, 2).map((cert) => (
                  <span class="inline-flex items-center gap-1 text-xs font-medium text-slate-600 bg-slate-50 px-2.5 py-1 rounded-lg">
                    <svg class="w-3 h-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    {cert.name}
                  </span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
      
      <!-- View All Link -->
      <div class="mt-12 text-center">
        <a href="/products" class="inline-flex items-center gap-2 text-primary-600 font-semibold hover:text-primary-700 transition-colors link-underline">
          View all products
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Why BRITZMEDI Section -->
  <section class="section bg-white">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <!-- Content -->
        <div>
          <span class="label mb-4">Why Choose Us</span>
          <h2 class="heading-2 mb-6">
            Technology-Driven<br />Medical Device Excellence
          </h2>
          <p class="body-large mb-10">
            {company.philosophy}
          </p>
          
          <!-- Features List -->
          <div class="space-y-6">
            {[
              {
                icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
                title: "FDA 510(k) Cleared",
                desc: "Our flagship TORR RF is FDA-cleared for safety and efficacy, meeting rigorous U.S. regulatory standards."
              },
              {
                icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />`,
                title: "In-House R&D Center",
                desc: "Company-affiliated research institute developing proprietary technologies with 11+ registered patents."
              },
              {
                icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />`,
                title: "Global Quality Standards",
                desc: "ISO 13485 certified quality management and GMP manufacturing for consistent, reliable products."
              },
              {
                icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />`,
                title: "OEM/ODM Partner",
                desc: "FDA-registered contract manufacturer offering end-to-end development services for global partners."
              }
            ].map((feature) => (
              <div class="flex gap-5 group">
                <div class="shrink-0 w-14 h-14 bg-gradient-to-br from-primary-50 to-primary-100 rounded-2xl flex items-center justify-center group-hover:shadow-lg group-hover:shadow-primary-500/10 transition-shadow">
                  <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={feature.icon} />
                </div>
                <div>
                  <h3 class="font-semibold text-slate-900 mb-1.5">{feature.title}</h3>
                  <p class="body-small">{feature.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        
        <!-- Stats Card -->
        <div class="relative">
          <div class="absolute -inset-4 bg-gradient-to-br from-primary-500/5 to-accent-500/5 rounded-3xl blur-2xl"></div>
          <div class="relative bg-white rounded-2xl border border-slate-200/80 p-8 lg:p-10 shadow-xl shadow-slate-200/50">
            <h3 class="text-lg font-bold text-slate-900 mb-8">Company at a Glance</h3>
            
            <div class="space-y-6">
              <div class="flex items-center justify-between pb-6 border-b border-slate-100">
                <span class="text-slate-600">Established</span>
                <span class="text-3xl font-bold bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent">2017</span>
              </div>
              <div class="flex items-center justify-between pb-6 border-b border-slate-100">
                <span class="text-slate-600">Registered Patents</span>
                <span class="text-3xl font-bold bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent">{company.intellectualProperty.registeredPatents}+</span>
              </div>
              <div class="flex items-center justify-between pb-6 border-b border-slate-100">
                <span class="text-slate-600">Product Lines</span>
                <span class="text-3xl font-bold bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent">4</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-600">Venture Enterprise</span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-semibold bg-gradient-to-r from-green-50 to-emerald-50 text-green-700 rounded-full border border-green-200/50">
                  <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
                  R&D Type
                </span>
              </div>
            </div>
            
            <div class="mt-8 pt-8 border-t border-slate-100">
              <a href="/about" class="inline-flex items-center gap-2 text-primary-600 font-semibold hover:text-primary-700 transition-colors link-underline">
                Learn more about us
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Technologies Section -->
  <section class="section bg-gradient-section">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="label mb-4 justify-center">Innovation</span>
        <h2 class="heading-2 mb-5">Core Technologies</h2>
        <p class="body-large">
          Our proprietary technologies power the next generation of aesthetic treatments.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
        {coreTechnologies.map((tech, index) => (
          <div class="card-premium p-7 lg:p-8 group">
            <div class="w-14 h-14 bg-gradient-to-br from-primary-100 to-primary-50 rounded-2xl flex items-center justify-center mb-6 group-hover:shadow-lg group-hover:shadow-primary-500/10 transition-shadow">
              <svg class="w-7 h-7 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3">{tech.name}</h3>
            <p class="body-base mb-5">{tech.description}</p>
            <div class="inline-flex items-center gap-2 text-sm font-semibold text-primary-600 bg-primary-50 px-3 py-1.5 rounded-lg">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              {tech.appliedTo}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section relative overflow-hidden">
    <!-- Background -->
    <div class="absolute inset-0 bg-gradient-to-br from-primary-600 via-primary-700 to-primary-800"></div>
    <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'0.03\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')]"></div>
    
    <div class="container relative">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-3xl lg:text-4xl xl:text-5xl font-bold text-white mb-5">
          Ready to Partner with BRITZMEDI?
        </h2>
        <p class="text-lg text-primary-100 mb-10 leading-relaxed">
          Whether you're a distributor, clinic, or OEM partner, we're here to help you bring 
          world-class aesthetic technology to your market.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a 
            href="/contact" 
            class="group inline-flex items-center gap-2 px-7 py-4 text-base font-semibold text-primary-700 bg-white hover:bg-primary-50 rounded-xl shadow-lg shadow-black/10 transition-all"
          >
            Contact Sales Team
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a 
            href="/products" 
            class="inline-flex items-center gap-2 px-7 py-4 text-base font-semibold text-white border-2 border-white/20 hover:bg-white/10 rounded-xl transition-all"
          >
            View Products
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
