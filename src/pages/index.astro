---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company, milestones, coreTechnologies } from '../content/company';
import { products, getFeaturedProducts } from '../content/products';
import { certifications, qualitySummary } from '../content/certifications';

const featuredProducts = products.filter(p => p.status === 'available').slice(0, 3);
---

<BaseLayout 
  title="Home"
  description="BRITZMEDI is a leading Korean manufacturer of FDA-cleared aesthetic medical devices. Discover TORR RF and innovative skincare technology."
  keywords={["BRITZMEDI", "aesthetic medical device", "TORR RF", "FDA cleared", "Korean medical device", "RF technology", "skin tightening"]}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-slate-50 to-white overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-40">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, rgb(226 232 240) 1px, transparent 0); background-size: 40px 40px;"></div>
    </div>
    
    <div class="container relative">
      <div class="py-20 lg:py-32">
        <div class="max-w-3xl">
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1.5 mb-6 bg-primary-50 border border-primary-100 rounded-full">
            <span class="w-2 h-2 bg-primary-500 rounded-full animate-pulse"></span>
            <span class="text-xs font-medium text-primary-700">FDA 510(k) Cleared Medical Devices</span>
          </div>
          
          <!-- Heading -->
          <h1 class="heading-1 mb-6">
            Innovative Aesthetic<br />
            <span class="text-primary-600">Medical Technology</span><br />
            from Korea
          </h1>
          
          <!-- Description -->
          <p class="body-large max-w-xl mb-8">
            Since 2017, BRITZMEDI has been pioneering advanced RF technology and skincare solutions. 
            Our FDA-cleared devices deliver safe, effective treatments trusted by clinics worldwide.
          </p>
          
          <!-- CTAs -->
          <div class="flex flex-wrap gap-4">
            <a 
              href="/products" 
              class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white bg-primary-600 hover:bg-primary-700 rounded-lg transition-colors"
            >
              Explore Products
              <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
            <a 
              href="/contact" 
              class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-slate-700 bg-white border border-slate-200 hover:border-slate-300 hover:bg-slate-50 rounded-lg transition-colors"
            >
              Contact Sales
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badges Section -->
  <section class="py-12 bg-white border-y border-slate-100">
    <div class="container">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 items-center">
        <div class="text-center">
          <div class="text-3xl lg:text-4xl font-bold text-primary-600 mb-1">FDA</div>
          <div class="text-sm text-slate-500">510(k) Cleared</div>
        </div>
        <div class="text-center">
          <div class="text-3xl lg:text-4xl font-bold text-primary-600 mb-1">ISO</div>
          <div class="text-sm text-slate-500">13485:2016</div>
        </div>
        <div class="text-center">
          <div class="text-3xl lg:text-4xl font-bold text-primary-600 mb-1">GMP</div>
          <div class="text-sm text-slate-500">Certified</div>
        </div>
        <div class="text-center">
          <div class="text-3xl lg:text-4xl font-bold text-primary-600 mb-1">11+</div>
          <div class="text-sm text-slate-500">Patents Registered</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Products Section -->
  <section class="section bg-white">
    <div class="container">
      <!-- Section Header -->
      <div class="max-w-2xl mb-12">
        <span class="label mb-3 block">Our Products</span>
        <h2 class="heading-2 mb-4">Medical Device Excellence</h2>
        <p class="body-large">
          From our flagship FDA-cleared TORR RF to innovative ultrasound solutions, 
          discover technology designed for superior clinical outcomes.
        </p>
      </div>
      
      <!-- Products Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {featuredProducts.map((product) => (
          <a 
            href={`/products/${product.id}`}
            class="group block bg-slate-50 border border-slate-100 rounded-xl p-6 hover:border-primary-200 hover:shadow-lg transition-all duration-300"
          >
            <!-- Product Image Placeholder -->
            <div class="aspect-[4/3] bg-gradient-to-br from-slate-100 to-slate-200 rounded-lg mb-6 flex items-center justify-center">
              <span class="text-4xl font-light text-slate-300">{product.name.charAt(0)}</span>
            </div>
            
            <!-- Badge -->
            {product.featured && (
              <span class="inline-flex items-center px-2.5 py-1 mb-3 text-xs font-medium bg-primary-100 text-primary-700 rounded-full">
                Flagship Product
              </span>
            )}
            
            <!-- Content -->
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="heading-3 group-hover:text-primary-600 transition-colors">{product.name}</h3>
                <p class="text-sm text-slate-500 mt-1">{product.tagline}</p>
              </div>
              <svg class="w-5 h-5 text-slate-400 group-hover:text-primary-600 group-hover:translate-x-1 transition-all shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
            
            <p class="body-small mt-3 line-clamp-2">{product.overview}</p>
            
            <!-- Certifications -->
            {product.certifications && product.certifications.length > 0 && (
              <div class="flex flex-wrap gap-2 mt-4 pt-4 border-t border-slate-200">
                {product.certifications.slice(0, 2).map((cert) => (
                  <span class="text-xs font-medium text-slate-500 bg-white px-2 py-1 rounded border border-slate-200">
                    {cert.name}
                  </span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
      
      <!-- View All Link -->
      <div class="mt-10 text-center">
        <a 
          href="/products" 
          class="inline-flex items-center text-primary-600 font-medium hover:text-primary-700 transition-colors"
        >
          View all products
          <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Why BRITZMEDI Section -->
  <section class="section bg-slate-50">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Content -->
        <div>
          <span class="label mb-3 block">Why Choose Us</span>
          <h2 class="heading-2 mb-6">
            Technology-Driven<br />Medical Device Excellence
          </h2>
          <p class="body-large mb-8">
            {company.philosophy}
          </p>
          
          <!-- Features List -->
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="shrink-0 w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-900 mb-1">FDA 510(k) Cleared</h3>
                <p class="body-small">Our flagship TORR RF is FDA-cleared for safety and efficacy, meeting rigorous U.S. regulatory standards.</p>
              </div>
            </div>
            
            <div class="flex gap-4">
              <div class="shrink-0 w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-900 mb-1">In-House R&D Center</h3>
                <p class="body-small">Company-affiliated research institute developing proprietary technologies with 11+ registered patents.</p>
              </div>
            </div>
            
            <div class="flex gap-4">
              <div class="shrink-0 w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-900 mb-1">Global Quality Standards</h3>
                <p class="body-small">ISO 13485 certified quality management and GMP manufacturing for consistent, reliable products.</p>
              </div>
            </div>
            
            <div class="flex gap-4">
              <div class="shrink-0 w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-900 mb-1">OEM/ODM Partner</h3>
                <p class="body-small">FDA-registered contract manufacturer offering end-to-end development services for global partners.</p>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Stats Card -->
        <div class="bg-white rounded-2xl border border-slate-200 p-8 lg:p-10 shadow-sm">
          <h3 class="text-lg font-semibold text-slate-900 mb-8">Company at a Glance</h3>
          
          <div class="space-y-6">
            <div class="flex items-center justify-between pb-6 border-b border-slate-100">
              <span class="text-slate-600">Established</span>
              <span class="text-2xl font-semibold text-slate-900">2017</span>
            </div>
            <div class="flex items-center justify-between pb-6 border-b border-slate-100">
              <span class="text-slate-600">Registered Patents</span>
              <span class="text-2xl font-semibold text-slate-900">{company.intellectualProperty.registeredPatents}+</span>
            </div>
            <div class="flex items-center justify-between pb-6 border-b border-slate-100">
              <span class="text-slate-600">Product Lines</span>
              <span class="text-2xl font-semibold text-slate-900">4</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-600">Venture Enterprise</span>
              <span class="inline-flex items-center px-3 py-1 text-sm font-medium bg-green-50 text-green-700 rounded-full">
                R&D Type
              </span>
            </div>
          </div>
          
          <div class="mt-8 pt-8 border-t border-slate-100">
            <a 
              href="/about" 
              class="inline-flex items-center text-primary-600 font-medium hover:text-primary-700 transition-colors"
            >
              Learn more about us
              <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Technologies Section -->
  <section class="section bg-white">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="label mb-3 block">Innovation</span>
        <h2 class="heading-2 mb-4">Core Technologies</h2>
        <p class="body-large">
          Our proprietary technologies power the next generation of aesthetic treatments.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
        {coreTechnologies.map((tech) => (
          <div class="bg-slate-50 border border-slate-100 rounded-xl p-6 lg:p-8">
            <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-6">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="heading-3 mb-3">{tech.name}</h3>
            <p class="body-base mb-4">{tech.description}</p>
            <div class="inline-flex items-center text-sm text-primary-600 font-medium">
              Applied to: {tech.appliedTo}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section bg-primary-600">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">
          Ready to Partner with BRITZMEDI?
        </h2>
        <p class="text-lg text-primary-100 mb-8">
          Whether you're a distributor, clinic, or OEM partner, we're here to help you bring 
          world-class aesthetic technology to your market.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a 
            href="/contact" 
            class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-primary-600 bg-white hover:bg-primary-50 rounded-lg transition-colors"
          >
            Contact Sales Team
          </a>
          <a 
            href="/products" 
            class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white border border-white/30 hover:bg-white/10 rounded-lg transition-colors"
          >
            View Products
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
