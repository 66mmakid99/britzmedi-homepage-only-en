---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/features/LeadForm.astro';
import { company } from '../content/company';

const pageDescription = "Contact BRITZMEDI for sales inquiries, partnership opportunities, or product information. Get in touch with our team.";
---

<BaseLayout
  title="Contact"
  description={pageDescription}
  keywords={["BRITZMEDI contact", "sales inquiry", "distributor", "partnership", "medical device Korea"]}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-hero py-16 lg:py-24">
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-primary-500/5 rounded-full blur-3xl"></div>
    <div class="container relative">
      <div class="max-w-3xl">
        <span class="label mb-4">Contact Us</span>
        <h1 class="heading-1 mb-6">
          Let's Start a<br />
          <span class="bg-gradient-to-r from-primary-600 to-primary-500 bg-clip-text text-transparent">Conversation</span>
        </h1>
        <p class="body-large">
          Whether you're interested in our products, exploring partnership opportunities,
          or need technical support, our team is here to help.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section bg-white dark:bg-slate-900">
    <div class="container">
      <div class="grid lg:grid-cols-5 gap-12 lg:gap-16">
        <!-- Contact Info -->
        <div class="lg:col-span-2">
          <h2 class="heading-3 mb-8">Get in Touch</h2>

          <div class="space-y-6 mb-8">
            <!-- Address -->
            <div class="flex gap-4 group">
              <div class="w-14 h-14 bg-gradient-to-br from-primary-50 to-primary-100 dark:from-primary-900/50 dark:to-primary-800/50 rounded-2xl flex items-center justify-center shrink-0 group-hover:shadow-lg group-hover:shadow-primary-500/10 transition-shadow">
                <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-900 dark:text-slate-100 mb-1">Headquarters & Factory</h3>
                <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">{company.address.full}</p>
              </div>
            </div>

            <!-- Phone -->
            <div class="flex gap-4 group">
              <div class="w-14 h-14 bg-gradient-to-br from-primary-50 to-primary-100 dark:from-primary-900/50 dark:to-primary-800/50 rounded-2xl flex items-center justify-center shrink-0 group-hover:shadow-lg group-hover:shadow-primary-500/10 transition-shadow">
                <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-900 dark:text-slate-100 mb-1">Phone</h3>
                <a href={`tel:${company.contact.phone}`} class="text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-medium transition-colors">
                  {company.contact.phone}
                </a>
              </div>
            </div>

            <!-- Email -->
            <div class="flex gap-4 group">
              <div class="w-14 h-14 bg-gradient-to-br from-primary-50 to-primary-100 dark:from-primary-900/50 dark:to-primary-800/50 rounded-2xl flex items-center justify-center shrink-0 group-hover:shadow-lg group-hover:shadow-primary-500/10 transition-shadow">
                <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-900 dark:text-slate-100 mb-1">Email</h3>
                <a href={`mailto:${company.contact.email}`} class="text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-medium transition-colors">
                  {company.contact.email}
                </a>
              </div>
            </div>

            <!-- Website -->
            <div class="flex gap-4 group">
              <div class="w-14 h-14 bg-gradient-to-br from-primary-50 to-primary-100 dark:from-primary-900/50 dark:to-primary-800/50 rounded-2xl flex items-center justify-center shrink-0 group-hover:shadow-lg group-hover:shadow-primary-500/10 transition-shadow">
                <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-900 dark:text-slate-100 mb-1">Website</h3>
                <a href={`https://${company.contact.website}`} target="_blank" rel="noopener noreferrer" class="text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-medium transition-colors">
                  {company.contact.website}
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Lead Form -->
        <div class="lg:col-span-3">
          <LeadForm />
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="py-12 bg-gradient-section">
    <div class="container">
      <div class="aspect-[21/9] bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-700 rounded-2xl flex items-center justify-center relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%2394a3b8\' fill-opacity=\'0.1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')]"></div>
        <div class="text-center relative">
          <div class="w-16 h-16 bg-white dark:bg-slate-800 rounded-2xl shadow-lg flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <p class="text-slate-600 dark:text-slate-300 font-medium">Hwaseong-si, Gyeonggi-do, Republic of Korea</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
