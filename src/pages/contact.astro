---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company } from '../content/company';

const pageDescription = "Contact BRITZMEDI for sales inquiries, partnership opportunities, or technical support. Get in touch with our team in Korea.";

const inquiryTypes = [
  { value: 'sales', label: 'Sales Inquiry' },
  { value: 'distributor', label: 'Distributor/Partnership' },
  { value: 'oem', label: 'OEM/ODM Inquiry' },
  { value: 'technical', label: 'Technical Support' },
  { value: 'other', label: 'Other' },
];

const productOptions = [
  { value: 'torr-rf', label: 'TORR RF' },
  { value: 'ulblanc', label: 'ULBLANC' },
  { value: 'newchae-shot', label: 'NEWCHAE SHOT' },
  { value: 'lumino-wave', label: 'LUMINO WAVE' },
  { value: 'multiple', label: 'Multiple Products' },
];
---

<BaseLayout 
  title="Contact"
  description={pageDescription}
  keywords={["BRITZMEDI contact", "sales inquiry", "distributor", "partnership", "medical device Korea"]}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-slate-50 to-white py-16 lg:py-24">
    <div class="container">
      <div class="max-w-3xl">
        <span class="label mb-3 block">Contact Us</span>
        <h1 class="heading-1 mb-6">
          Let's Start a<br />
          <span class="text-primary-600">Conversation</span>
        </h1>
        <p class="body-large">
          Whether you're interested in our products, exploring partnership opportunities, 
          or need technical support, our team is here to help.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section bg-white">
    <div class="container">
      <div class="grid lg:grid-cols-5 gap-12 lg:gap-16">
        <!-- Contact Info -->
        <div class="lg:col-span-2">
          <h2 class="heading-3 mb-6">Get in Touch</h2>
          
          <div class="space-y-6 mb-8">
            <!-- Address -->
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-primary-50 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-900 mb-1">Headquarters & Factory</h3>
                <p class="text-slate-600 text-sm">{company.address.full}</p>
              </div>
            </div>
            
            <!-- Phone -->
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-primary-50 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-900 mb-1">Phone</h3>
                <a href={`tel:${company.contact.phone}`} class="text-primary-600 hover:text-primary-700 transition-colors">
                  {company.contact.phone}
                </a>
              </div>
            </div>
            
            <!-- Email -->
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-primary-50 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-900 mb-1">Email</h3>
                <a href={`mailto:${company.contact.email}`} class="text-primary-600 hover:text-primary-700 transition-colors">
                  {company.contact.email}
                </a>
              </div>
            </div>
            
            <!-- Website -->
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-primary-50 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-900 mb-1">Website</h3>
                <a href={`https://${company.contact.website}`} target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:text-primary-700 transition-colors">
                  {company.contact.website}
                </a>
              </div>
            </div>
          </div>
          
          <!-- Business Hours -->
          <div class="bg-slate-50 rounded-xl p-6">
            <h3 class="font-semibold text-slate-900 mb-3">Business Hours</h3>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between">
                <span class="text-slate-600">Monday - Friday</span>
                <span class="text-slate-900">9:00 AM - 6:00 PM (KST)</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-600">Saturday - Sunday</span>
                <span class="text-slate-500">Closed</span>
              </div>
            </div>
            <p class="text-xs text-slate-500 mt-4">
              * KST = Korea Standard Time (UTC+9)
            </p>
          </div>
        </div>
        
        <!-- Contact Form -->
        <div class="lg:col-span-3">
          <div class="bg-slate-50 rounded-2xl p-6 lg:p-8">
            <h2 class="heading-3 mb-6">Send Us a Message</h2>
            
            <form id="contactForm" class="space-y-6">
              <!-- Inquiry Type -->
              <div>
                <label for="inquiryType" class="block text-sm font-medium text-slate-700 mb-2">
                  Inquiry Type <span class="text-red-500">*</span>
                </label>
                <select 
                  id="inquiryType" 
                  name="inquiryType" 
                  required
                  class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-white text-slate-900"
                >
                  <option value="">Select inquiry type</option>
                  {inquiryTypes.map((type) => (
                    <option value={type.value}>{type.label}</option>
                  ))}
                </select>
              </div>
              
              <!-- Name & Company -->
              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label for="name" class="block text-sm font-medium text-slate-700 mb-2">
                    Your Name <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    required
                    placeholder="John Doe"
                    class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-white text-slate-900 placeholder-slate-400"
                  />
                </div>
                <div>
                  <label for="company" class="block text-sm font-medium text-slate-700 mb-2">
                    Company / Organization <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="text" 
                    id="company" 
                    name="company" 
                    required
                    placeholder="Company Name"
                    class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-white text-slate-900 placeholder-slate-400"
                  />
                </div>
              </div>
              
              <!-- Email & Phone -->
              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label for="email" class="block text-sm font-medium text-slate-700 mb-2">
                    Email Address <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    required
                    placeholder="you@company.com"
                    class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-white text-slate-900 placeholder-slate-400"
                  />
                </div>
                <div>
                  <label for="phone" class="block text-sm font-medium text-slate-700 mb-2">
                    Phone Number
                  </label>
                  <input 
                    type="tel" 
                    id="phone" 
                    name="phone"
                    placeholder="+1 (555) 000-0000"
                    class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-white text-slate-900 placeholder-slate-400"
                  />
                </div>
              </div>
              
              <!-- Country & Product Interest -->
              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label for="country" class="block text-sm font-medium text-slate-700 mb-2">
                    Country <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="text" 
                    id="country" 
                    name="country" 
                    required
                    placeholder="Your Country"
                    class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-white text-slate-900 placeholder-slate-400"
                  />
                </div>
                <div>
                  <label for="product" class="block text-sm font-medium text-slate-700 mb-2">
                    Product Interest
                  </label>
                  <select 
                    id="product" 
                    name="product"
                    class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-white text-slate-900"
                  >
                    <option value="">Select a product</option>
                    {productOptions.map((product) => (
                      <option value={product.value}>{product.label}</option>
                    ))}
                  </select>
                </div>
              </div>
              
              <!-- Message -->
              <div>
                <label for="message" class="block text-sm font-medium text-slate-700 mb-2">
                  Message <span class="text-red-500">*</span>
                </label>
                <textarea 
                  id="message" 
                  name="message" 
                  required
                  rows="5"
                  placeholder="Please describe your inquiry in detail..."
                  class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-white text-slate-900 placeholder-slate-400 resize-y"
                ></textarea>
              </div>
              
              <!-- Privacy Notice -->
              <div class="flex items-start gap-3">
                <input 
                  type="checkbox" 
                  id="privacy" 
                  name="privacy"
                  required
                  class="mt-1 w-4 h-4 text-primary-600 border-slate-300 rounded focus:ring-primary-500"
                />
                <label for="privacy" class="text-sm text-slate-600">
                  I agree to the collection and use of my personal information for the purpose of responding to my inquiry. 
                  <span class="text-red-500">*</span>
                </label>
              </div>
              
              <!-- Submit Button -->
              <button 
                type="submit"
                class="w-full px-6 py-4 text-base font-medium text-white bg-primary-600 hover:bg-primary-700 rounded-lg transition-colors flex items-center justify-center gap-2"
              >
                Send Message
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </button>
            </form>
            
            <!-- Form Status Message -->
            <div id="formStatus" class="hidden mt-6 p-4 rounded-lg"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section (Placeholder) -->
  <section class="py-12 bg-slate-50">
    <div class="container">
      <div class="aspect-[21/9] bg-slate-200 rounded-2xl flex items-center justify-center">
        <div class="text-center">
          <svg class="w-12 h-12 text-slate-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <p class="text-slate-500">Hwaseong-si, Gyeonggi-do, Republic of Korea</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contactForm');
  const formStatus = document.getElementById('formStatus');
  
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form as HTMLFormElement);
    const data = Object.fromEntries(formData.entries());
    
    // Show loading state
    const submitBtn = form.querySelector('button[type="submit"]');
    if (submitBtn) {
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.innerHTML = `
        <svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Sending...
      `;
    }
    
    // Simulate form submission (replace with actual API call)
    setTimeout(() => {
      if (formStatus) {
        formStatus.classList.remove('hidden');
        formStatus.classList.add('bg-green-50', 'text-green-800');
        formStatus.innerHTML = `
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Thank you for your inquiry. We'll get back to you within 1-2 business days.</span>
          </div>
        `;
      }
      
      // Reset form
      (form as HTMLFormElement).reset();
      
      // Reset button
      if (submitBtn) {
        submitBtn.removeAttribute('disabled');
        submitBtn.innerHTML = `
          Send Message
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        `;
      }
    }, 1500);
  });
</script>
