---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/features/LeadForm.astro';
import { company } from '../content/company';
import { useTranslations } from '../i18n';

const t = useTranslations('en');
---

<BaseLayout
  title="Contact Us - Sales & Distributor Partnership Inquiries"
  description="Contact BRITZMEDI for product inquiries, distributor partnerships, and demo requests. Korean medical device manufacturer with global support. Get a response within 24h."
  keywords={["contact BRITZMEDI", "medical device inquiry", "distributor partnership", "sales inquiry", "demo request", "Korean medical device", "aesthetic device partnership"]}
>
  <!-- ContactPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contact BRITZMEDI",
    "description": "Contact BRITZMEDI for sales inquiries, distributor partnerships, and product information. Professional aesthetic medical devices from Korea.",
    "url": "https://britzmedi.com/contact",
    "mainEntity": {
      "@type": "Organization",
      "name": "BRITZMEDI Co., Ltd.",
      "telephone": "+82-70-4348-7244",
      "email": "sh.lee@britzmedi.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "1211, 388, Dunchon-daero, Jungwon-gu",
        "addressLocality": "Seongnam-si",
        "addressRegion": "Gyeonggi-do",
        "postalCode": "13403",
        "addressCountry": "KR"
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "09:00",
        "closes": "18:00"
      }
    }
  })} />

  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-hero py-16 lg:py-24">
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-primary-500/5 rounded-full blur-3xl"></div>
    <div class="container relative">
      <div class="max-w-3xl">
        <span class="label mb-4">{t('contact.hero.label')}</span>
        <h1 class="heading-1 mb-6">
          {t('contact.hero.title1')}<br />
          <span class="bg-gradient-to-r from-primary-600 to-primary-500 bg-clip-text text-transparent">{t('contact.hero.title2')}</span>
        </h1>
        <p class="body-large">
          {t('contact.hero.description')}
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section bg-white">
    <div class="container">
      <div class="grid lg:grid-cols-5 gap-12 lg:gap-16">
        <!-- Contact Info -->
        <div class="lg:col-span-2">
          <h2 class="heading-3 mb-8">{t('contact.getInTouch')}</h2>

          <div class="space-y-6 mb-8">
            <!-- Address -->
            <div class="flex gap-4 group">
              <div class="w-14 h-14 bg-gradient-to-br from-primary-50 to-primary-100 rounded-2xl flex items-center justify-center shrink-0 group-hover:shadow-lg group-hover:shadow-primary-500/10 transition-shadow">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-900 mb-1">{t('contact.info.headquarters')}</h3>
                <p class="text-slate-600 text-sm leading-relaxed">{company.address.full}</p>
              </div>
            </div>

            <!-- Phone -->
            <div class="flex gap-4 group">
              <div class="w-14 h-14 bg-gradient-to-br from-primary-50 to-primary-100 rounded-2xl flex items-center justify-center shrink-0 group-hover:shadow-lg group-hover:shadow-primary-500/10 transition-shadow">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-900 mb-1">{t('contact.info.phone')}</h3>
                <a href={`tel:${company.contact.phone}`} class="text-primary-600 hover:text-primary-700 font-medium transition-colors">
                  {company.contact.phone}
                </a>
              </div>
            </div>

            <!-- Email -->
            <div class="flex gap-4 group">
              <div class="w-14 h-14 bg-gradient-to-br from-primary-50 to-primary-100 rounded-2xl flex items-center justify-center shrink-0 group-hover:shadow-lg group-hover:shadow-primary-500/10 transition-shadow">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-900 mb-1">{t('contact.info.email')}</h3>
                <a href={`mailto:${company.contact.email}`} class="text-primary-600 hover:text-primary-700 font-medium transition-colors">
                  {company.contact.email}
                </a>
              </div>
            </div>

          </div>
        </div>

        <!-- Lead Form -->
        <div class="lg:col-span-3">
          <LeadForm />
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="py-12 bg-gradient-section">
    <div class="container">
      <a
        href="https://maps.google.com/?q=37.4326369,127.1591639"
        target="_blank"
        rel="noopener noreferrer"
        class="block relative group"
      >
        <div class="bg-gray-100 rounded-2xl p-8 text-center hover:bg-gray-200 transition shadow-lg border border-slate-200">
          <div class="text-4xl mb-3">📍</div>
          <p class="font-semibold text-lg text-slate-900">BRITZMEDI Headquarters</p>
          <p class="text-slate-600 mt-1">크란츠테크노, 388 Dunchon-daero, Jungwon-gu</p>
          <p class="text-slate-600">Seongnam-si, Gyeonggi-do, Republic of Korea</p>
          <p class="text-primary-600 mt-3 group-hover:underline font-medium">View on Google Maps →</p>
        </div>
      </a>
    </div>
  </section>
</BaseLayout>
