---
import BaseLayout from '../../layouts/BaseLayout.astro';
import newsData from '../../data/news.json';

interface NewsItem {
  id: string;
  title: string;
  category: string;
  date: string;
  summary: string;
  content: string;
  image: string | null;
  featured: boolean;
  published: boolean;
}

const allNews = (newsData as NewsItem[]).filter(n => n.published).sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const categories = [
  { value: 'all', label: 'All' },
  { value: 'event', label: 'Events' },
  { value: 'product', label: 'Products' },
  { value: 'partnership', label: 'Partnerships' },
  { value: 'award', label: 'Awards' },
  { value: 'media', label: 'Media' },
];

const CATEGORY_COLORS: Record<string, string> = {
  event: 'bg-blue-100 text-blue-700',
  product: 'bg-green-100 text-green-700',
  partnership: 'bg-purple-100 text-purple-700',
  award: 'bg-amber-100 text-amber-700',
  media: 'bg-pink-100 text-pink-700',
};

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric', month: 'long', day: 'numeric',
  });
}
---

<BaseLayout
  title="News"
  description="Stay up to date with the latest news from BRITZMEDI — product launches, events, partnerships, awards, and media coverage."
  keywords={["BRITZMEDI news", "medical device news", "aesthetic device events", "TORR RF updates"]}
>
  <!-- News Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white py-16 lg:py-20">
    <div class="container">
      <div class="max-w-2xl">
        <span class="label mb-4">News & Updates</span>
        <h1 class="heading-1 mb-5">Latest from BRITZMEDI</h1>
        <p class="body-large">
          Stay informed about our latest product launches, industry events, partnerships, and company milestones.
        </p>
      </div>
    </div>
  </section>

  <!-- Category Filter + News Grid -->
  <section class="section bg-white">
    <div class="container">
      {allNews.length > 0 ? (
        <!-- Category Tabs -->
        <div class="flex flex-wrap items-center gap-2 mb-10" id="news-filters">
          {categories.map(cat => (
            <button
              data-category={cat.value}
              class:list={[
                'news-filter-btn px-4 py-2 text-sm font-medium rounded-full border transition-colors',
                cat.value === 'all'
                  ? 'bg-slate-900 text-white border-slate-900'
                  : 'bg-white text-slate-600 border-slate-200 hover:border-slate-400'
              ]}
            >
              {cat.label}
            </button>
          ))}
        </div>

        <!-- News Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8" id="news-grid">
          {allNews.map(item => (
            <a
              href={`/news/${item.id}`}
              class="news-card group card-premium overflow-hidden"
              data-category={item.category}
            >
              {/* Image */}
              <div class="aspect-[16/9] bg-slate-100 overflow-hidden">
                {item.image ? (
                  <img
                    src={item.image}
                    alt={item.title}
                    width="600"
                    height="338"
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-slate-100 to-slate-200">
                    <svg class="w-12 h-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                    </svg>
                  </div>
                )}
              </div>

              {/* Content */}
              <div class="p-5 sm:p-6">
                <div class="flex items-center gap-3 mb-3">
                  <span class:list={['inline-block text-xs font-medium px-2.5 py-1 rounded-full', CATEGORY_COLORS[item.category] || 'bg-slate-100 text-slate-600']}>
                    {item.category.charAt(0).toUpperCase() + item.category.slice(1)}
                  </span>
                  <span class="text-xs text-slate-400">{formatDate(item.date)}</span>
                </div>

                <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-primary-600 transition-colors line-clamp-2">
                  {item.title}
                </h3>

                <p class="body-small line-clamp-3">
                  {item.summary}
                </p>

                <div class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary-600 group-hover:gap-2.5 transition-all">
                  Read more
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </div>
            </a>
          ))}
        </div>

        <!-- Empty state (category filter) -->
        <div id="news-empty" class="hidden text-center py-16">
          <p class="text-slate-400">No news found in this category.</p>
        </div>
      ) : (
        <!-- Coming Soon state -->
        <div class="text-center py-20">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-100 mb-6">
            <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-slate-700 mb-2">Coming Soon</h3>
          <p class="text-slate-400 max-w-md mx-auto">
            We're preparing exciting news and updates. Check back soon for the latest from BRITZMEDI.
          </p>
        </div>
      )}
    </div>
  </section>

  {allNews.length > 0 && (
    <!-- Client-side category filter -->
    <script>
      const filterBtns = document.querySelectorAll('.news-filter-btn');
      const cards = document.querySelectorAll('.news-card');
      const emptyState = document.getElementById('news-empty');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const category = btn.getAttribute('data-category');

          // Update active button
          filterBtns.forEach(b => {
            b.classList.remove('bg-slate-900', 'text-white', 'border-slate-900');
            b.classList.add('bg-white', 'text-slate-600', 'border-slate-200');
          });
          btn.classList.remove('bg-white', 'text-slate-600', 'border-slate-200');
          btn.classList.add('bg-slate-900', 'text-white', 'border-slate-900');

          // Filter cards
          let visibleCount = 0;
          cards.forEach(card => {
            const cardCategory = card.getAttribute('data-category');
            const show = category === 'all' || cardCategory === category;
            (card as HTMLElement).style.display = show ? '' : 'none';
            if (show) visibleCount++;
          });

          if (emptyState) {
            emptyState.classList.toggle('hidden', visibleCount > 0);
          }
        });
      });
    </script>
  )}
</BaseLayout>
