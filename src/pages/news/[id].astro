---
import BaseLayout from '../../layouts/BaseLayout.astro';
import newsData from '../../data/news.json';

interface NewsItem {
  id: string;
  title: string;
  category: string;
  date: string;
  summary: string;
  content: string;
  image: string | null;
  featured: boolean;
  published: boolean;
}

const allNews = newsData as NewsItem[];

export function getStaticPaths() {
  return (newsData as NewsItem[]).filter(n => n.published).map(item => ({
    params: { id: item.id },
  }));
}

const { id } = Astro.params;
const item = allNews.find(n => n.id === id && n.published);

if (!item) {
  return Astro.redirect('/news');
}

const CATEGORY_COLORS: Record<string, string> = {
  event: 'bg-blue-100 text-blue-700',
  product: 'bg-green-100 text-green-700',
  partnership: 'bg-purple-100 text-purple-700',
  award: 'bg-amber-100 text-amber-700',
  media: 'bg-pink-100 text-pink-700',
};

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric', month: 'long', day: 'numeric',
  });
}

// Related news: same category, excluding current, max 3
const relatedNews = allNews
  .filter(n => n.published && n.id !== id && n.category === item.category)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

// If not enough from same category, fill with recent
if (relatedNews.length < 3) {
  const moreNews = allNews
    .filter(n => n.published && n.id !== id && !relatedNews.some(r => r.id === n.id))
    .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
    .slice(0, 3 - relatedNews.length);
  relatedNews.push(...moreNews);
}

const shareUrl = `https://britzmedi.com/news/${item.id}`;
const shareTitle = encodeURIComponent(item.title);
const shareSummary = encodeURIComponent(item.summary);
---

<BaseLayout
  title={item.title}
  description={item.summary}
  keywords={["BRITZMEDI", "news", item.category]}
  ogType="article"
  publishedTime={item.date}
>
  <!-- Article Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    "headline": item.title,
    "description": item.summary,
    "image": item.image ? `https://britzmedi.com${item.image}` : undefined,
    "datePublished": item.date,
    "author": {
      "@type": "Organization",
      "name": "BRITZMEDI Co., Ltd.",
      "url": "https://britzmedi.com"
    },
    "publisher": {
      "@type": "Organization",
      "name": "BRITZMEDI Co., Ltd.",
      "logo": {
        "@type": "ImageObject",
        "url": "https://britzmedi.com/images/logos/britzmedi-logo.png"
      }
    }
  })} />

  <!-- Breadcrumb -->
  <section class="bg-slate-50 border-b border-slate-200">
    <div class="container py-3">
      <nav class="flex items-center gap-2 text-sm text-slate-500">
        <a href="/" class="hover:text-primary-600 transition-colors">Home</a>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <a href="/news" class="hover:text-primary-600 transition-colors">News</a>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-slate-700 font-medium truncate max-w-xs">{item.title}</span>
      </nav>
    </div>
  </section>

  <!-- Article -->
  <article class="section bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        {/* Meta */}
        <div class="flex items-center gap-3 mb-6">
          <span class:list={['inline-block text-xs font-medium px-2.5 py-1 rounded-full', CATEGORY_COLORS[item.category] || 'bg-slate-100 text-slate-600']}>
            {item.category.charAt(0).toUpperCase() + item.category.slice(1)}
          </span>
          <span class="text-sm text-slate-400">{formatDate(item.date)}</span>
        </div>

        {/* Title */}
        <h1 class="text-3xl lg:text-4xl font-bold text-slate-900 mb-6 leading-tight">
          {item.title}
        </h1>

        {/* Summary */}
        <p class="text-lg text-slate-600 mb-8 leading-relaxed border-l-4 border-primary-500 pl-5">
          {item.summary}
        </p>

        {/* Featured Image */}
        {item.image && (
          <div class="mb-10 rounded-2xl overflow-hidden">
            <img
              src={item.image}
              alt={item.title}
              width="800"
              height="450"
              class="w-full"
              loading="eager"
            />
          </div>
        )}

        {/* Content */}
        <div class="prose prose-lg prose-slate max-w-none mb-10" set:html={item.content} />

        {/* Share Buttons */}
        <div class="flex items-center gap-4 pt-8 border-t border-slate-200">
          <span class="text-sm font-medium text-slate-700">Share:</span>
          <a
            href={`https://twitter.com/intent/tweet?text=${shareTitle}&url=${encodeURIComponent(shareUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center transition-colors"
            aria-label="Share on X"
          >
            <svg class="w-4 h-4 text-slate-600" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </a>
          <a
            href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(shareUrl)}&title=${shareTitle}&summary=${shareSummary}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center transition-colors"
            aria-label="Share on LinkedIn"
          >
            <svg class="w-4 h-4 text-slate-600" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          </a>
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center transition-colors"
            aria-label="Share on Facebook"
          >
            <svg class="w-4 h-4 text-slate-600" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </article>

  {/* Related News */}
  {relatedNews.length > 0 && (
    <section class="section bg-gradient-section">
      <div class="container">
        <h2 class="heading-3 mb-8">Related News</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedNews.map(related => (
            <a href={`/news/${related.id}`} class="group card-premium overflow-hidden">
              <div class="aspect-[16/9] bg-slate-100 overflow-hidden">
                {related.image ? (
                  <img
                    src={related.image}
                    alt={related.title}
                    width="400"
                    height="225"
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-slate-100 to-slate-200">
                    <svg class="w-10 h-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                    </svg>
                  </div>
                )}
              </div>
              <div class="p-5">
                <div class="flex items-center gap-2 mb-2">
                  <span class:list={['text-[10px] font-medium px-2 py-0.5 rounded-full', CATEGORY_COLORS[related.category] || 'bg-slate-100 text-slate-600']}>
                    {related.category.charAt(0).toUpperCase() + related.category.slice(1)}
                  </span>
                  <span class="text-[10px] text-slate-400">{formatDate(related.date)}</span>
                </div>
                <h3 class="text-sm font-bold text-slate-900 group-hover:text-primary-600 transition-colors line-clamp-2">
                  {related.title}
                </h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
