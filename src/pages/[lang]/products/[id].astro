---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { products, getProductById } from '../../../content/products';
import { supportedLanguages, defaultLang, type Language } from '../../../i18n/config';
import { useTranslations } from '../../../i18n';
import { getProductTranslation } from '../../../i18n/product-translations';

export function getStaticPaths() {
  const paths: { params: { lang: string; id: string } }[] = [];

  // Generate paths for all non-default languages and all products
  supportedLanguages
    .filter(lang => lang !== defaultLang)
    .forEach(lang => {
      products.forEach(product => {
        paths.push({ params: { lang, id: product.id } });
      });
    });

  return paths;
}

const { lang, id } = Astro.params as { lang: Language; id: string };
const t = useTranslations(lang);
const product = getProductById(id);

if (!product) {
  return Astro.redirect(`/${lang}/products`);
}

// Get product-level translations (returns undefined for English → fallback to original)
const pt = getProductTranslation(lang, id);

// Helper: get translated product content with English fallback
const tagline = pt?.tagline ?? product.tagline;
const overview = pt?.overview ?? product.overview;
const description = pt?.description ?? product.description;

const keyTechnologies = product.keyTechnologies.map((tech, i) => ({
  name: pt?.keyTechnologies?.[i]?.name ?? tech.name,
  description: pt?.keyTechnologies?.[i]?.description ?? tech.description,
}));

const indications = pt?.indications ?? product.indications;

const specifications = product.specifications?.map((spec) => ({
  label: pt?.specLabels?.[spec.label] ?? spec.label,
  value: spec.value, // keep numeric values as-is
  note: spec.note ? (pt?.specNotes?.[spec.note] ?? spec.note) : undefined,
}));

// Map handpiece names to image keys for lookup
const handpieceImageKeys: Record<string, string> = {
  'Large Handpiece (Body)': 'body-super',
  'Small Handpiece (Face)': 'face-super',
  'Micro Handpiece (Eye/Delicate)': 'eye',
  'Body Handpiece - Deep': 'body-deep',
  'Body Handpiece - Super': 'body-super',
  'Body Handpiece - Vibe': 'body-vibe',
  'Face Handpiece - Deep': 'face-deep',
  'Face Handpiece - Super': 'face-super',
  'Eye Handpiece': 'eye',
};

const handpieces = product.handpieces?.map((hp, i) => {
  const imageKey = handpieceImageKeys[hp.name];
  return {
    name: pt?.handpieces?.[i]?.name ?? hp.name,
    tipSize: hp.tipSize,
    depth: pt?.handpieces?.[i]?.depth ?? hp.depth,
    feature: pt?.handpieces?.[i]?.feature ?? hp.feature,
    imageSrc: imageKey ? product.images?.handpieces?.[imageKey] : undefined,
  };
});

const clinicalBenefits = pt?.clinicalBenefits ?? product.clinicalBenefits;

const differentiators = product.differentiators?.map((diff, i) => ({
  feature: pt?.differentiators?.[i]?.feature ?? diff.feature,
  description: pt?.differentiators?.[i]?.description ?? diff.description,
}));

const pageDescription = `${product.name} - ${tagline}. ${overview}`;

// 허가 전 의료기기(예: LUMINO WAVE): MFDS 허가·인증이 없는 coming-soon 제품.
// ko 페이지에서는 의료기기법상 허가 전 판매·거래 유인(견적/데모 CTA) 금지 — 문의 버튼만 노출.
const isPreApproval = product.status === 'coming-soon'
  && !product.certifications?.some((c: any) => c.name.includes('MFDS') && ['Approved', 'Certified', 'Cleared'].includes(c.status));
const hidePurchaseCta = lang === 'ko' && isPreApproval;

// Product JSON-LD Schema
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  'name': product.name,
  'description': pageDescription,
  'image': product.images?.main ? `https://britzmedi.com${product.images.main}` : undefined,
  'brand': {
    '@type': 'Brand',
    'name': 'BRITZMEDI'
  },
  'manufacturer': {
    '@type': 'Organization',
    'name': 'BRITZMEDI Co., Ltd.',
    'url': 'https://britzmedi.com'
  },
  'model': product.model,
  'category': product.category === 'medical-device' ? 'Medical Device' : 'Home Beauty Device',
  'url': `https://britzmedi.com/${lang}/products/${product.id}`,
  ...(product.certifications?.some((c: any) => c.name === 'FDA' && c.status === 'Cleared') ? {
    'additionalProperty': [{
      '@type': 'PropertyValue',
      'name': 'FDA Status',
      'value': 'FDA 510(k) Cleared'
    }]
  } : {}),
  // 허가 전(coming-soon) 제품은 offers 자체를 비노출 — 사전주문(PreOrder) 표기는 허가 전 판매 유인으로 해석될 소지.
  ...(product.status !== 'coming-soon' ? {
    'offers': {
      '@type': 'Offer',
      'availability': 'https://schema.org/InStock',
      'priceCurrency': 'USD',
      'price': '0',
      'priceValidUntil': '2027-12-31',
      'url': `https://britzmedi.com/${lang}/contact?product=${product.id}`
    }
  } : {})
};
---

<BaseLayout
  title={`${product.name} | ${t('products.title')}`}
  description={pageDescription}
  ogType="product"
  ogImage={product.images?.main}
>
  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-slate-50 to-white py-12 lg:py-20">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="mb-8">
        <ol class="flex items-center gap-2 text-sm">
          <li>
            <a href={`/${lang}`} class="text-slate-500 hover:text-primary-600 transition-colors">{t('products.details.home')}</a>
          </li>
          <li class="text-slate-400">/</li>
          <li>
            <a href={`/${lang}/products`} class="text-slate-500 hover:text-primary-600 transition-colors">{t('products.title')}</a>
          </li>
          <li class="text-slate-400">/</li>
          <li class="text-slate-900 font-medium">{product.name}</li>
        </ol>
      </nav>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <!-- Product Image -->
        <div class="aspect-square bg-gradient-to-br from-slate-100 to-slate-200 rounded-2xl relative overflow-hidden">
          {product.images?.main ? (
            <img
              src={product.images.main}
              alt={product.name}
              width="800"
              height="800"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full h-full object-cover"
            />
          ) : (
            <div class="w-full h-full flex items-center justify-center">
              <span class="text-8xl font-light text-slate-300">{product.name.charAt(0)}</span>
            </div>
          )}

          <!-- Badges -->
          <div class="absolute top-6 left-6 flex flex-col gap-2">
            {product.featured && (
              <span class="inline-flex items-center px-3 py-1.5 text-xs font-medium bg-primary-600 text-white rounded-full">
                {t('products.details.flagshipProduct')}
              </span>
            )}
            {product.status === 'coming-soon' && (
              <span class="inline-flex items-center px-3 py-1.5 text-xs font-medium bg-accent-500 text-white rounded-full">
                {t('products.details.comingH22026')}
              </span>
            )}
          </div>
        </div>

        <!-- Product Info -->
        <div>
          <!-- Category Badge -->
          <span class="inline-flex items-center px-3 py-1 mb-4 text-xs font-medium bg-primary-50 text-primary-700 rounded-full uppercase tracking-wider">
            {product.category === 'medical-device' ? t('products.details.medicalDevice') : t('products.details.medicalCosmetic')}
          </span>

          <h1 class="heading-1 mb-2">{product.name}</h1>
          <p class="text-lg text-slate-500 mb-4">{t('products.details.model')}: {product.model}</p>

          <p class="text-xl text-primary-600 font-medium mb-6">{tagline}</p>

          <p class="body-large mb-8">{description}</p>

          <!-- Certifications -->
          {product.certifications && product.certifications.length > 0 && (
            <div class="mb-8">
              <h2 class="text-sm font-semibold text-slate-900 uppercase tracking-wider mb-3">{t('products.details.certifications')}</h2>
              <div class="flex flex-wrap gap-2">
                {product.certifications.map((cert) => (
                  <div class:list={[
                    "inline-flex items-center gap-2 px-3 py-2 rounded-lg border",
                    cert.status === 'Cleared' || cert.status === 'Approved' || cert.status === 'Certified'
                      ? "bg-green-50 border-green-200 text-green-800"
                      : cert.status === 'Under Review'
                        ? "bg-amber-50 border-amber-200 text-amber-800"
                        : "bg-slate-50 border-slate-200 text-slate-700"
                  ]}>
                    {(cert.status === 'Cleared' || cert.status === 'Approved' || cert.status === 'Certified') && (
                      <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                    )}
                    <span class="text-sm font-medium">{lang === 'ko' && cert.name === 'KC (EMC)' ? 'KC 전파법 적합등록(EMC)' : cert.name}</span>
                    {cert.detail && <span class="text-xs opacity-75">({lang === 'ko' && cert.status === 'Under Review' ? '허가 심사 진행 중 · 일정은 심사 결과에 따라 변동될 수 있음' : cert.detail})</span>}
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- CTA -->
          <div class="flex flex-wrap gap-4">
            {hidePurchaseCta ? (
              <a
                href={`/${lang}/contact`}
                class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white bg-primary-600 hover:bg-primary-700 rounded-lg transition-colors"
              >
                {t('nav.contact')}
              </a>
            ) : (
              <>
                <a
                  href={`/${lang}/contact`}
                  class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white bg-primary-600 hover:bg-primary-700 rounded-lg transition-colors"
                >
                  {t('products.details.requestQuote')}
                </a>
                <a
                  href={`/${lang}/contact`}
                  class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-slate-700 bg-white border border-slate-200 hover:border-slate-300 hover:bg-slate-50 rounded-lg transition-colors"
                >
                  {t('products.details.requestDemo')}
                </a>
              </>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product Gallery Section -->
  {product.images?.gallery && product.images.gallery.length > 0 && (
    <section class="section bg-slate-50">
      <div class="container">
        <div class="max-w-2xl mb-12">
          <span class="label mb-3 block">{t('products.details.gallery')}</span>
          <h2 class="heading-2 mb-4">{t('products.details.productImages')}</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {product.images.gallery.map((img: string) => (
            <div class="aspect-[4/3] rounded-xl overflow-hidden bg-white border border-slate-200 group cursor-pointer hover:shadow-xl transition-all duration-300">
              <img
                src={img}
                alt={product.name}
                width="800"
                height="600"
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                loading="lazy"
                decoding="async"
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Key Technologies Section -->
  <section class="section bg-white">
    <div class="container">
      <div class="max-w-2xl mb-12">
        <span class="label mb-3 block">{t('products.details.technology')}</span>
        <h2 class="heading-2 mb-4">{t('products.details.keyTechnologies')}</h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {keyTechnologies.map((tech) => (
          <div class="bg-slate-50 border border-slate-100 rounded-xl p-6">
            <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="font-semibold text-slate-900 mb-2">{tech.name}</h3>
            <p class="body-small">{tech.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Clinical Applications Section -->
  {indications && indications.length > 0 && (
    <section class="section bg-slate-50">
      <div class="container">
        <div class="max-w-2xl mb-12">
          <span class="label mb-3 block">{t('products.details.clinicalUse')}</span>
          <h2 class="heading-2 mb-4">{t('products.details.indications')}</h2>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          {indications.map((indication) => {
            const [title, desc] = indication.includes(' - ')
              ? indication.split(' - ')
              : [indication, null];
            return (
              <div class="bg-white rounded-xl p-6 border border-slate-100 hover:border-primary-200 hover:shadow-lg transition-all duration-300">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-slate-900 mb-1">{title}</h3>
                    {desc && <p class="text-sm text-slate-600">{desc}</p>}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Specifications Section -->
  {specifications && specifications.length > 0 && (
    <section class="section bg-white">
      <div class="container">
        <div class="max-w-2xl mb-12">
          <span class="label mb-3 block">{t('products.details.technicalData')}</span>
          <h2 class="heading-2 mb-4">{t('products.details.specifications')}</h2>
        </div>

        <div class="bg-slate-50 rounded-2xl border border-slate-100 overflow-hidden">
          <table class="w-full">
            <tbody>
              {specifications.map((spec, index) => (
                <tr class:list={[
                  "border-b border-slate-100 last:border-0",
                  index % 2 === 0 ? "bg-white" : "bg-slate-50"
                ]}>
                  <td class="p-4 lg:p-6 w-1/3">
                    <span class="font-medium text-slate-900">{spec.label}</span>
                  </td>
                  <td class="p-4 lg:p-6">
                    <span class="text-slate-700">{spec.value}</span>
                    {spec.note && (
                      <span class="block text-sm text-slate-500 mt-1">{spec.note}</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <!-- Handpieces Section -->
  {handpieces && handpieces.length > 0 && (
    <section class="section bg-slate-50">
      <div class="container">
        <div class="max-w-2xl mb-12">
          <span class="label mb-3 block">{t('products.details.accessories')}</span>
          <h2 class="heading-2 mb-4">{t('products.details.handpieceConfig')}</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {handpieces.map((handpiece) => (
            <div class="bg-white rounded-xl p-6 border border-slate-100 hover:border-primary-200 hover:shadow-lg transition-all duration-300 group">
              <div class="aspect-[4/3] bg-gradient-to-br from-slate-100 to-slate-200 rounded-lg mb-4 overflow-hidden">
                {handpiece.imageSrc ? (
                  <img
                    src={handpiece.imageSrc}
                    alt={handpiece.name}
                    width="800"
                    height="600"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center">
                    <svg class="w-12 h-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                    </svg>
                  </div>
                )}
              </div>
              <h3 class="font-semibold text-slate-900 mb-3">{handpiece.name}</h3>
              <div class="space-y-2 text-sm">
                <div class="flex justify-between">
                  <span class="text-slate-500">{t('products.details.tipSize')}</span>
                  <span class="text-slate-900 font-medium">{handpiece.tipSize}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">{t('products.details.depth')}</span>
                  <span class="text-slate-900 font-medium">{handpiece.depth}</span>
                </div>
              </div>
              <p class="body-small mt-4 pt-4 border-t border-slate-100">{handpiece.feature}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Why [Product] Section (USP) -->
  {differentiators && differentiators.length > 0 && (
    <section class="section bg-gradient-to-br from-primary-600 via-primary-700 to-primary-800 text-white">
      <div class="container">
        <div class="max-w-2xl mb-12">
          <span class="inline-flex items-center gap-2 px-3 py-1 text-xs font-semibold bg-white/20 text-white rounded-full mb-4">
            {t('products.details.whyChoose')}
          </span>
          <h2 class="text-3xl lg:text-4xl font-bold mb-4">{t('products.details.whyProduct', { name: product.name })}</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {differentiators.map((diff, index) => (
            <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-white/20">
              <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center mb-4">
                <span class="text-2xl font-bold">{index + 1}</span>
              </div>
              <h3 class="text-xl font-semibold mb-3">{diff.feature}</h3>
              <p class="text-primary-100">{diff.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Clinical Benefits Section -->
  {clinicalBenefits && clinicalBenefits.length > 0 && (
    <section class="section bg-white">
      <div class="container">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <span class="label mb-3 justify-center">{t('products.details.benefits')}</span>
            <h2 class="heading-2 mb-4">{t('products.details.clinicalBenefits')}</h2>
          </div>

          <div class="grid md:grid-cols-2 gap-6">
            {clinicalBenefits.map((benefit) => (
              <div class="flex items-start gap-4 bg-slate-50 rounded-xl p-5 border border-slate-100">
                <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="text-slate-700 font-medium">{benefit}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section class="section bg-slate-900">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">
          {t('products.details.interestedIn')}
        </h2>
        <p class="text-lg text-slate-300 mb-8">
          {t('products.details.contactCta')}
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href={`/${lang}/contact?product=${product.id}&type=demo`}
            class="inline-flex items-center gap-2 px-7 py-4 text-base font-semibold text-slate-900 bg-white hover:bg-slate-100 rounded-xl transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            {hidePurchaseCta ? t('nav.contact') : t('products.details.requestDemo')}
          </a>
          <a
            href={`/${lang}/resources`}
            class="inline-flex items-center gap-2 px-7 py-4 text-base font-semibold text-white border-2 border-white/30 hover:bg-white/10 rounded-xl transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            {t('resources.download')}
          </a>
        </div>
      </div>
    </div>
  </section>

<script>
  // Handle lazy-loaded images fade-in
  function handleImageLoad() {
    const lazyImages = document.querySelectorAll('img[loading="lazy"]');

    lazyImages.forEach((img) => {
      if (img.complete) {
        img.classList.add('loaded');
      } else {
        img.addEventListener('load', () => {
          img.classList.add('loaded');
        });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', handleImageLoad);
  } else {
    handleImageLoad();
  }
</script>
{pt?.regulatoryNotice && pt.regulatoryNotice.length > 0 && (
  <section class="py-6 bg-slate-100 border-t border-slate-200">
    <div class="container">
      <div class="max-w-4xl mx-auto space-y-1 text-center">
        {pt.regulatoryNotice.map((line) => (
          <p class="text-xs text-slate-500">{line}</p>
        ))}
      </div>
    </div>
  </section>
)}

</BaseLayout>
