---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { products, getProductById } from '../../../content/products';
import { supportedLanguages, defaultLang, type Language } from '../../../i18n/config';
import { useTranslations } from '../../../i18n';

export function getStaticPaths() {
  const paths: { params: { lang: string; id: string } }[] = [];

  // Generate paths for all non-default languages and all products
  supportedLanguages
    .filter(lang => lang !== defaultLang)
    .forEach(lang => {
      products.forEach(product => {
        paths.push({ params: { lang, id: product.id } });
      });
    });

  return paths;
}

const { lang, id } = Astro.params as { lang: Language; id: string };
const t = useTranslations(lang);
const product = getProductById(id);

if (!product) {
  return Astro.redirect(`/${lang}/products`);
}
---

<BaseLayout
  title={`${product.name} | ${t('products.title')}`}
  description={product.overview}
  ogType="product"
>
  <!-- Hero Section -->
  <section class="relative py-16 lg:py-24 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-50 via-white to-primary-50/30"></div>
    <div class="container relative">
      <nav class="flex items-center gap-2 text-sm text-slate-500 mb-8">
        <a href={`/${lang}`} class="hover:text-primary-600">{lang === 'ko' ? '홈' : 'Home'}</a>
        <span>/</span>
        <a href={`/${lang}/products`} class="hover:text-primary-600">{t('products.title')}</a>
        <span>/</span>
        <span class="text-slate-900">{product.name}</span>
      </nav>

      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Product Image -->
        <div class="aspect-square bg-gradient-to-br from-slate-100 via-slate-50 to-slate-100 rounded-2xl overflow-hidden">
          {product.images?.main ? (
            <img
              src={product.images.main}
              alt={product.name}
              class="w-full h-full object-cover"
            />
          ) : (
            <div class="w-full h-full flex items-center justify-center">
              <span class="text-8xl font-light text-slate-300">{product.name.charAt(0)}</span>
            </div>
          )}
        </div>

        <!-- Product Info -->
        <div>
          {product.featured && (
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 mb-4 text-xs font-semibold bg-gradient-to-r from-primary-50 to-primary-100 text-primary-700 rounded-full">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
              Flagship Product
            </span>
          )}

          <h1 class="text-4xl lg:text-5xl font-bold text-slate-900 mb-2">{product.name}</h1>
          {product.model && <p class="text-lg text-slate-500 mb-4">{product.model}</p>}
          <p class="text-xl text-primary-600 font-medium mb-6">{product.tagline}</p>
          <p class="body-large mb-8">{product.overview}</p>

          {product.certifications && product.certifications.length > 0 && (
            <div class="flex flex-wrap gap-3 mb-8">
              {product.certifications.map((cert) => (
                <span class="inline-flex items-center gap-2 px-4 py-2 bg-green-50 text-green-700 rounded-lg text-sm font-medium">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  {cert.name}
                </span>
              ))}
            </div>
          )}

          <div class="flex flex-wrap gap-4">
            <a href={`/${lang}/contact`} class="btn-primary">
              {t('common.getQuote')}
            </a>
            <a href={`/${lang}/contact`} class="btn-secondary">
              {t('common.contactSales')}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Technologies -->
  {product.technologies && product.technologies.length > 0 && (
    <section class="section bg-white">
      <div class="container">
        <h2 class="heading-2 mb-10">{t('products.details.keyTechnologies')}</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {product.technologies.map((tech) => (
            <div class="card-premium p-6">
              <h3 class="text-lg font-bold text-slate-900 mb-2">{tech.name}</h3>
              <p class="body-small">{tech.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Specifications -->
  {product.specifications && Object.keys(product.specifications).length > 0 && (
    <section class="section bg-gradient-section">
      <div class="container">
        <h2 class="heading-2 mb-10">{t('products.details.specifications')}</h2>
        <div class="card-premium overflow-hidden">
          <table class="w-full">
            <tbody>
              {Object.entries(product.specifications).map(([key, value], index) => (
                <tr class={index % 2 === 0 ? 'bg-white' : 'bg-slate-50'}>
                  <td class="px-6 py-4 font-medium text-slate-900 w-1/3">{key}</td>
                  <td class="px-6 py-4 text-slate-600">{value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <!-- Indications -->
  {product.indications && product.indications.length > 0 && (
    <section class="section bg-white">
      <div class="container">
        <h2 class="heading-2 mb-10">{t('products.details.indications')}</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
          {product.indications.map((indication) => (
            <div class="flex items-center gap-3 p-4 bg-slate-50 rounded-xl">
              <svg class="w-5 h-5 text-primary-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="text-slate-700">{indication}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="section bg-gradient-section">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="heading-2 mb-5">
          {lang === 'ko' ? '이 제품에 관심이 있으신가요?' :
           lang === 'ja' ? 'この製品にご興味がありますか？' :
           lang === 'zh' ? '对这个产品感兴趣吗？' :
           'Interested in this product?'}
        </h2>
        <p class="body-large mb-8">{t('contact.subtitle')}</p>
        <a href={`/${lang}/contact`} class="btn-primary">
          {t('common.contactSales')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
