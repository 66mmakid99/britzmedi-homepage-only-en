---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { products, type Product } from '../../../content/products';
import { supportedLanguages, defaultLang, type Language } from '../../../i18n/config';
import { useTranslations } from '../../../i18n';
import { getProductTranslation } from '../../../i18n/product-translations';

export function getStaticPaths() {
  return supportedLanguages
    .filter(lang => lang !== defaultLang)
    .map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);

// Use translated tagline/overview where available (English fallback)
const withTranslatedCopy = (list: Product[]) =>
  list.map((product) => {
    const pt = getProductTranslation(lang, product.id);
    return {
      ...product,
      tagline: pt?.tagline ?? product.tagline,
      overview: pt?.overview ?? product.overview,
    };
  });

const availableProducts = withTranslatedCopy(products.filter(p => p.status === 'available'));
const comingSoonProducts = withTranslatedCopy(products.filter(p => p.status === 'coming-soon'));
---

<BaseLayout
  title={t('products.title')}
  description={t('products.subtitle')}
>
  <!-- Hero Section -->
  <section class="relative py-16 lg:py-24 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-50 via-white to-primary-50/30"></div>
    <div class="container relative">
      <div class="max-w-2xl">
        <span class="label mb-4">{t('products.title')}</span>
        <h1 class="heading-1 mb-6">{t('products.subtitle')}</h1>
        <p class="body-large">
          {t('products.heroDescription')}
        </p>
      </div>
    </div>
  </section>

  <!-- Available Products -->
  <section class="section bg-white">
    <div class="container">
      <div class="mb-10">
        <span class="label mb-2">{t('products.status.available')}</span>
        <h2 class="heading-2">{t('products.category.medicalDevice')}</h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {availableProducts.map((product) => (
          <a
            href={`/${lang}/products/${product.id}`}
            class="group card-premium p-6 lg:p-7"
          >
            <div class="aspect-[4/3] bg-gradient-to-br from-slate-100 via-slate-50 to-slate-100 rounded-xl mb-6 relative overflow-hidden">
              {product.images?.main ? (
                <img
                  src={product.images.main}
                  alt={product.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center">
                  <span class="text-5xl font-light text-slate-300">{product.name.charAt(0)}</span>
                </div>
              )}
            </div>

            {product.featured && (
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 mb-4 text-xs font-semibold bg-gradient-to-r from-primary-50 to-primary-100 text-primary-700 rounded-full border border-primary-200/50">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                {t('products.details.flagshipProduct')}
              </span>
            )}

            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <h3 class="text-xl font-bold text-slate-900 group-hover:text-primary-600 transition-colors">{product.name}</h3>
                <p class="text-sm text-primary-600 font-medium mt-1">{product.tagline}</p>
              </div>
              <div class="w-10 h-10 rounded-xl bg-slate-100 group-hover:bg-primary-100 flex items-center justify-center shrink-0 transition-colors">
                <svg class="w-5 h-5 text-slate-400 group-hover:text-primary-600 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>

            <p class="body-small line-clamp-2 mb-5">{product.overview}</p>

            {product.certifications && product.certifications.length > 0 && (
              <div class="flex flex-wrap gap-2 pt-5 border-t border-slate-100">
                {product.certifications.slice(0, 2).map((cert) => (
                  <span class="inline-flex items-center gap-1 text-xs font-medium text-slate-600 bg-slate-50 px-2.5 py-1 rounded-lg">
                    <svg class="w-3 h-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    {cert.name}
                  </span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Coming Soon Products -->
  {comingSoonProducts.length > 0 && (
    <section class="section bg-gradient-section">
      <div class="container">
        <div class="mb-10">
          <span class="label mb-2">{t('products.status.comingSoon')}</span>
          <h2 class="heading-2">{t('products.upcomingProducts')}</h2>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {comingSoonProducts.map((product) => (
            <div class="card-premium p-6 lg:p-7 opacity-75">
              <div class="aspect-[4/3] bg-gradient-to-br from-slate-100 via-slate-50 to-slate-100 rounded-xl mb-6 relative overflow-hidden">
                <div class="w-full h-full flex items-center justify-center">
                  <span class="text-5xl font-light text-slate-300">{product.name.charAt(0)}</span>
                </div>
                <div class="absolute inset-0 flex items-center justify-center bg-slate-900/50">
                  <span class="px-4 py-2 bg-white/90 text-slate-900 font-semibold rounded-lg text-sm">
                    {t('products.status.comingSoon')}
                  </span>
                </div>
              </div>

              <h3 class="text-xl font-bold text-slate-900 mb-2">{product.name}</h3>
              <p class="text-sm text-primary-600 font-medium mb-3">{product.tagline}</p>
              <p class="body-small line-clamp-2">{product.overview}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="section bg-white">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="heading-2 mb-5">{t('nav.contactUs')}</h2>
        <p class="body-large mb-8">{t('contact.subtitle')}</p>
        <a href={`/${lang}/contact`} class="btn-primary">
          {t('common.contactSales')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
