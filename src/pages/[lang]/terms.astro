        </div>

        <!-- Use License -->
        <div class="mb-12">
          <h2 class="heading-2 mb-4">2. {lang === 'ko' ? '사용 라이선스' :
            lang === 'ja' ? '使用ライセンス' :
            lang === 'zh' ? '使用许可' :
            lang === 'th' ? 'ใบอนุญาตการใช้งาน' :
            lang === 'vi' ? 'Giấy phép sử dụng' :
            lang === 'es' ? 'Licencia de Uso' :
            lang === 'ar' ? 'رخصة الاستخدام' :
            'Use License'}</h2>
