---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supportedLanguages, defaultLang, type Language } from '../../i18n/config';
import { useTranslations } from '../../i18n';

export function getStaticPaths() {
  return supportedLanguages
    .filter(lang => lang !== defaultLang)
    .map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);

const pageDescription = t('terms.intro.p1');
---

<BaseLayout
  title={t('terms.title')}
  description={pageDescription}
  keywords={["terms of service", "terms and conditions", "BRITZMEDI", "legal", "user agreement"]}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-slate-50 to-white py-16 lg:py-24">
    <div class="container">
      <div class="max-w-3xl">
        <span class="label mb-3 block">{t('terms.heroLabel')}</span>
        <h1 class="heading-1 mb-6">
          {t('terms.title').split(' ').slice(0, -1).join(' ')}<br />
          <span class="text-primary-600">{t('terms.title').split(' ').slice(-1)[0]}</span>
        </h1>
        <p class="body-large text-slate-600">
          {t('terms.lastUpdated')}
        </p>
      </div>
    </div>
  </section>

  <!-- Terms of Service Content -->
  <section class="section bg-white">
    <div class="container">
      <div class="max-w-3xl">
        <!-- Introduction -->
        <div class="mb-12">
          <h2 class="heading-2 mb-4">{t('terms.intro.title')}</h2>
          <p class="body-base mb-4">
            {t('terms.intro.p1')}
          </p>
          <p class="body-base">
            {t('terms.intro.p2')}
          </p>
        </div>

        <!-- Acceptance of Terms -->
        <div class="mb-12">
          <h2 class="heading-2 mb-4">1. {lang === 'ja' ? '利用規約への同意' :
            lang === 'zh' ? '条款的接受' :
            lang === 'th' ? 'การยอมรับข้อกำหนด' :
            lang === 'vi' ? 'Chấp nhận điều khoản' :
            lang === 'es' ? 'Aceptación de Términos' :
            lang === 'fr' ? 'Acceptation des conditions' :
            lang === 'ru' ? 'Принятие условий' :
            lang === 'ar' ? 'قبول الشروط' :
            'Acceptance of Terms'}</h2>
          <p class="body-base mb-4">
            {lang === 'ja' ? 'ウェブサイトにアクセスすることで、お客様は本利用規約およびプライバシーポリシーを読み、理解し、同意したものとみなされます。本規約のいずれかの部分に同意されない場合は、直ちにウェブサイトの使用を中止してください。' :
             lang === 'zh' ? '通过访问我们的网站，即表示您确认已阅读、理解并同意受本服务条款和隐私政策的约束。如果您不同意本条款的任何部分，您必须立即停止使用我们的网站。' :
             lang === 'th' ? 'โดยการเข้าถึงเว็บไซต์ของเรา คุณยอมรับว่าคุณได้อ่าน เข้าใจ และยอมรับที่จะผูกพันตามข้อกำหนดในการให้บริการเหล่านี้และนโยบายความเป็นส่วนตัวของเรา หากคุณไม่เห็นด้วยกับส่วนใดส่วนหนึ่งของข้อกำหนดเหล่านี้ คุณต้องหยุดใช้งานเว็บไซต์ของเราทันที' :
             lang === 'vi' ? 'Bằng cách truy cập trang web của chúng tôi, bạn xác nhận rằng bạn đã đọc, hiểu và đồng ý bị ràng buộc bởi các Điều khoản dịch vụ này và Chính sách bảo mật của chúng tôi. Nếu bạn không đồng ý với bất kỳ phần nào của các điều khoản này, bạn phải ngừng sử dụng trang web của chúng tôi ngay lập tức.' :
             lang === 'es' ? 'Al acceder a nuestro sitio web, reconoce que ha leído, entendido y acepta estar obligado por estos Términos de Servicio y nuestra Política de Privacidad. Si no está de acuerdo con alguna parte de estos términos, debe dejar de usar nuestro sitio web inmediatamente.' :
             lang === 'fr' ? 'En accédant à notre site web, vous reconnaissez avoir lu, compris et accepté d\'être lié par les présentes Conditions d\'utilisation et notre Politique de confidentialité. Si vous n\'acceptez pas une partie de ces conditions, vous devez cesser immédiatement d\'utiliser notre site web.' :
             lang === 'ru' ? 'Получая доступ к нашему веб-сайту, вы подтверждаете, что прочитали, поняли и согласны соблюдать настоящие Условия использования и нашу Политику конфиденциальности. Если вы не согласны с какой-либо частью этих условий, вы должны немедленно прекратить использование нашего веб-сайта.' :
             lang === 'ar' ? 'بالوصول إلى موقعنا الإلكتروني، فإنك تقر بأنك قد قرأت وفهمت ووافقت على الالتزام بشروط الخدمة هذه وسياسة الخصوصية الخاصة بنا. إذا كنت لا توافق على أي جزء من هذه الشروط، يجب عليك التوقف عن استخدام موقعنا على الفور.' :
             'By accessing our website, you acknowledge that you have read, understood, and agree to be bound by these Terms of Service and our Privacy Policy. If you do not agree with any part of these terms, you must discontinue use of our website immediately.'}
          </p>
        </div>

        <!-- Use License -->
        <div class="mb-12">
