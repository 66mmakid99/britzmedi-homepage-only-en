              lang === 'zh' ? '传输病毒、恶意软件或任何具有破坏性的代码' :
              lang === 'th' ? 'ส่งไวรัส มัลแวร์ หรือโค้ดใดๆ ที่มีลักษณะทำลาย' :
              lang === 'vi' ? 'Truyền virus, phần mềm độc hại hoặc bất kỳ mã nào có tính chất phá hoại' :
              lang === 'es' ? 'Transmitir virus, malware o cualquier código de naturaleza destructiva' :
              lang === 'fr' ? 'Transmettre des virus, logiciels malveillants ou tout code de nature destructrice' :
              lang === 'ru' ? 'Передавать вирусы, вредоносное ПО или любой код деструктивного характера' :
              lang === 'ar' ? 'نقل الفيروسات أو البرامج الضارة أو أي رمز ذي طبيعة مدمرة' :
              'Transmit viruses, malware, or any code of destructive nature'}</li>
            <li>{lang === 'ja' ? '適用される法律または規制に違反しない' :
              lang === 'zh' ? '违反任何适用的法律或法规' :
              lang === 'th' ? 'ละเมิดกฎหมายหรือระเบียบข้อบังคับที่บังคับใช้' :
              lang === 'vi' ? 'Vi phạm bất kỳ luật hoặc quy định hiện hành nào' :
              lang === 'es' ? 'Violar cualquier ley o regulación aplicable' :
              lang === 'fr' ? 'Violer toute loi ou réglementation applicable' :
              lang === 'ru' ? 'Нарушать любые применимые законы или нормативные акты' :
              lang === 'ar' ? 'انتهاك أي قوانين أو لوائح سارية' :
              'Violate any applicable laws or regulations'}</li>
          </ul>
        </div>

        <!-- Intellectual Property -->
        <div class="mb-12">
          <h2 class="heading-2 mb-4">3. {lang === 'ja' ? '知的財産権' :
            lang === 'zh' ? '知识产权' :
            lang === 'th' ? 'สิทธิ์ในทรัพย์สินทางปัญญา' :
            lang === 'vi' ? 'Quyền sở hữu trí tuệ' :
            lang === 'es' ? 'Derechos de Propiedad Intelectual' :
            lang === 'fr' ? 'Droits de propriété intellectuelle' :
            lang === 'ru' ? 'Права интеллектуальной собственности' :
            lang === 'ar' ? 'حقوق الملكية الفكرية' :
