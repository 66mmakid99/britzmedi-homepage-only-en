---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { company, milestones, coreTechnologies } from '../../content/company';
import { supportedLanguages, languages, defaultLang, type Language } from '../../i18n/config';
import { useTranslations } from '../../i18n';

export function getStaticPaths() {
  return supportedLanguages
    .filter(lang => lang !== defaultLang)
    .map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);

// Get milestone translation keys
const getMilestoneTitle = (year: string) => {
  const key = `about.milestones.${year}.title` as const;
  return t(key as any) || year;
};

const getMilestoneDescription = (year: string) => {
  const key = `about.milestones.${year}.description` as const;
  return t(key as any) || '';
};
---

<BaseLayout
  title={t('about.title')}
  description={t('about.subtitle')}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-slate-50 to-white py-16 lg:py-24">
    <div class="container">
      <div class="max-w-3xl">
        <span class="label mb-3 block">{t('about.hero.label')}</span>
        <h1 class="heading-1 mb-6">
          {t('about.hero.title1')}<br />
          <span class="text-primary-600">{t('about.hero.title2')}</span>
        </h1>
        <p class="body-large">
          {t('about.philosophy.text')}
        </p>
      </div>
    </div>
  </section>

  <!-- Company Overview Section -->
  <section class="section bg-white">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
        <!-- Company Info -->
        <div>
          <h2 class="heading-2 mb-8">{t('about.overview.title')}</h2>

          <div class="space-y-6">
            <div class="flex gap-4 pb-6 border-b border-slate-100">
              <div class="shrink-0 w-10 h-10 bg-primary-50 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
              </div>
              <div>
                <span class="text-sm text-slate-500">{t('about.overview.companyName')}</span>
                <p class="font-semibold text-slate-900">{company.name}</p>
                <p class="text-sm text-slate-500">{company.nameKo}</p>
              </div>
            </div>

            <div class="flex gap-4 pb-6 border-b border-slate-100">
              <div class="shrink-0 w-10 h-10 bg-primary-50 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <div>
                <span class="text-sm text-slate-500">{t('about.overview.ceo')}</span>
                <p class="font-semibold text-slate-900">{company.ceo}</p>
                <p class="text-sm text-slate-500">{t('about.overview.appointed')} {company.ceoAppointment}</p>
              </div>
            </div>

            <div class="flex gap-4 pb-6 border-b border-slate-100">
              <div class="shrink-0 w-10 h-10 bg-primary-50 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <span class="text-sm text-slate-500">{t('about.overview.established')}</span>
                <p class="font-semibold text-slate-900">{company.establishment}</p>
              </div>
            </div>

            <div class="flex gap-4 pb-6 border-b border-slate-100">
              <div class="shrink-0 w-10 h-10 bg-primary-50 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <span class="text-sm text-slate-500">{t('about.overview.headquarters')}</span>
                <p class="font-semibold text-slate-900">{company.address.full}</p>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="shrink-0 w-10 h-10 bg-primary-50 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <span class="text-sm text-slate-500">{t('about.overview.businessType')}</span>
                <p class="font-semibold text-slate-900">{company.businessType}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Philosophy & IP -->
        <div class="space-y-8">
          <div class="bg-primary-50 rounded-2xl p-8">
            <h3 class="heading-3 text-primary-900 mb-4">{t('about.philosophy.title')}</h3>
            <p class="text-lg text-primary-800 leading-relaxed">
              "{t('about.philosophy.text')}"
            </p>
          </div>

          <div class="bg-slate-50 rounded-2xl p-8">
            <h3 class="heading-3 mb-6">{t('about.ip.title')}</h3>
            <div class="grid grid-cols-2 gap-6">
              <div class="text-center p-4 bg-white rounded-xl">
                <div class="text-3xl font-bold text-primary-600 mb-1">{company.intellectualProperty.registeredPatents}</div>
                <div class="text-sm text-slate-600">{t('about.ip.registeredPatents')}</div>
              </div>
              <div class="text-center p-4 bg-white rounded-xl">
                <div class="text-3xl font-bold text-primary-600 mb-1">{company.intellectualProperty.trademarks}</div>
                <div class="text-sm text-slate-600">{t('about.ip.trademarks')}</div>
              </div>
              <div class="text-center p-4 bg-white rounded-xl">
                <div class="text-3xl font-bold text-primary-600 mb-1">{company.intellectualProperty.domesticPatents}</div>
                <div class="text-sm text-slate-600">{t('about.ip.domesticPatents')}</div>
              </div>
              <div class="text-center p-4 bg-white rounded-xl">
                <div class="text-3xl font-bold text-primary-600 mb-1">{company.intellectualProperty.internationalPatents}</div>
                <div class="text-sm text-slate-600">{t('about.ip.internationalPatents')}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Company History Timeline -->
  <section class="section bg-slate-50">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="label mb-3 block">{t('about.history.label')}</span>
        <h2 class="heading-2 mb-4">{t('about.history.title')}</h2>
        <p class="body-large">
          {t('about.history.subtitle')}
        </p>
      </div>

      <div class="max-w-3xl mx-auto">
        <div class="space-y-0">
          {milestones.map((milestone, index) => (
            <div class="relative pl-8 pb-12 last:pb-0">
              {index !== milestones.length - 1 && (
                <div class="absolute left-[11px] top-6 bottom-0 w-0.5 bg-slate-200"></div>
              )}

              <div class:list={[
                "absolute left-0 top-1 w-6 h-6 rounded-full border-4 border-white shadow-sm",
                milestone.upcoming ? "bg-accent-500" : "bg-primary-600"
              ]}></div>

              <div class="bg-white rounded-xl p-6 border border-slate-100 ml-4">
                <div class="flex items-center gap-3 mb-2">
                  <span class="text-2xl font-bold text-primary-600">{milestone.year}</span>
                  {milestone.upcoming && (
                    <span class="inline-flex items-center px-2.5 py-1 text-xs font-medium bg-accent-100 text-accent-700 rounded-full">
                      {t('common.upcoming')}
                    </span>
                  )}
                </div>
                <h3 class="font-semibold text-slate-900 mb-2">{getMilestoneTitle(milestone.year)}</h3>
                <p class="body-small">{getMilestoneDescription(milestone.year)}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- R&D Capabilities Section -->
  <section class="section bg-white" id="technology">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div>
          <span class="label mb-3 block">{t('about.rnd.label')}</span>
          <h2 class="heading-2 mb-6">{t('about.rnd.title')}</h2>
          <p class="body-large mb-8">
            {t('about.rnd.subtitle')}
          </p>

          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-primary-600 shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-slate-700">{t('about.rnd.points.research')}</span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-primary-600 shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-slate-700">{t('about.rnd.points.venture')}</span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-primary-600 shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-slate-700">{t('about.rnd.points.patents')}</span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-primary-600 shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-slate-700">{t('about.rnd.points.inventors')}</span>
            </div>
          </div>
        </div>

        <!-- Core Technologies -->
        <div class="space-y-6">
          <h3 class="heading-3">{t('about.tech.title')}</h3>
          <div class="bg-slate-50 border border-slate-100 rounded-xl p-6">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h4 class="font-semibold text-slate-900">{t('about.tech.convergence.name')}</h4>
            </div>
            <p class="body-small mb-3">{t('about.tech.convergence.description')}</p>
            <span class="inline-flex items-center text-xs font-medium text-primary-600 bg-primary-50 px-2.5 py-1 rounded-full">
              {t('common.appliedTo')}: TORR RF
            </span>
          </div>
          <div class="bg-slate-50 border border-slate-100 rounded-xl p-6">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h4 class="font-semibold text-slate-900">{t('about.tech.multiwave.name')}</h4>
            </div>
            <p class="body-small mb-3">{t('about.tech.multiwave.description')}</p>
            <span class="inline-flex items-center text-xs font-medium text-primary-600 bg-primary-50 px-2.5 py-1 rounded-full">
              {t('common.appliedTo')}: TORR RF
            </span>
          </div>
          <div class="bg-slate-50 border border-slate-100 rounded-xl p-6">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h4 class="font-semibold text-slate-900">{t('about.tech.transdermal.name')}</h4>
            </div>
            <p class="body-small mb-3">{t('about.tech.transdermal.description')}</p>
            <span class="inline-flex items-center text-xs font-medium text-primary-600 bg-primary-50 px-2.5 py-1 rounded-full">
              {t('common.appliedTo')}: ULBLANC
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Manufacturing Section -->
  <section class="section bg-slate-50">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="label mb-3 block">{t('about.manufacturing.label')}</span>
        <h2 class="heading-2 mb-4">{t('about.manufacturing.title')}</h2>
        <p class="body-large">
          {t('about.manufacturing.subtitle')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Manufacturing Infrastructure -->
        <div class="bg-white rounded-2xl p-8 border border-slate-100">
          <div class="w-14 h-14 bg-primary-100 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <h3 class="heading-3 mb-4">{t('about.manufacturing.infrastructure.title')}</h3>
          <p class="body-base mb-6">
            {t('about.manufacturing.infrastructure.description')}
          </p>
          <div class="space-y-3">
            <div class="flex items-center gap-2 text-sm">
              <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-slate-700">{t('about.manufacturing.infrastructure.mfdsLicense')} {company.manufacturing.license}</span>
            </div>
            <div class="flex items-center gap-2 text-sm">
              <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-slate-700">{t('about.manufacturing.infrastructure.gmpCertified')}</span>
            </div>
            <div class="flex items-center gap-2 text-sm">
              <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-slate-700">{t('about.manufacturing.infrastructure.isoCertified')}</span>
            </div>
          </div>
        </div>

        <!-- Manufacturing Credentials -->
        <div class="bg-white rounded-2xl p-8 border border-slate-100">
          <div class="w-14 h-14 bg-primary-100 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="heading-3 mb-4">{t('about.manufacturing.oem.title')}</h3>
          <p class="body-base mb-6">
            {t('about.manufacturing.oem.description')}
          </p>
          <div class="space-y-3">
            <div class="flex items-center gap-2 text-sm">
              <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-slate-700">{t('about.manufacturing.oem.fdaRegistered')}</span>
            </div>
            <div class="flex items-center gap-2 text-sm">
              <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-slate-700">{t('about.manufacturing.oem.ownerOperator')} {company.manufacturing.fdaRegistration.ownerOperatorNumber}</span>
            </div>
            <div class="flex items-center gap-2 text-sm">
              <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-slate-700">{t('about.manufacturing.oem.e2eSupport')}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-12 text-center">
        <a
          href={`/${lang}/contact`}
          class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white bg-primary-600 hover:bg-primary-700 rounded-lg transition-colors"
        >
          {t('about.manufacturing.cta')}
          <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
