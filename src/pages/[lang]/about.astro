---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { company, milestones, coreTechnologies } from '../../content/company';
import { supportedLanguages, languages, defaultLang, type Language } from '../../i18n/config';
import { useTranslations } from '../../i18n';

export function getStaticPaths() {
  return supportedLanguages
    .filter(lang => lang !== defaultLang)
    .map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);
---

<BaseLayout
  title={t('about.title')}
  description={t('about.subtitle')}
>
  <!-- Hero Section -->
  <section class="relative py-20 lg:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-50 via-white to-primary-50/30"></div>
    <div class="container relative">
      <div class="max-w-3xl">
        <span class="label mb-4">{t('about.title')}</span>
        <h1 class="heading-1 mb-6">{t('about.subtitle')}</h1>
        <p class="body-large">{company.philosophy}</p>
      </div>
    </div>
  </section>

  <!-- Company Info -->
  <section class="section bg-white">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20">
        <div>
          <h2 class="heading-2 mb-6">{t('about.mission.title')}</h2>
          <p class="body-large mb-8">{t('about.mission.description')}</p>

          <div class="space-y-4">
            <div class="flex items-center gap-4 p-4 bg-slate-50 rounded-xl">
              <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center">
                <span class="text-primary-600 font-bold">FDA</span>
              </div>
              <div>
                <div class="font-semibold text-slate-900">510(k) Cleared</div>
                <div class="text-sm text-slate-500">K212561</div>
              </div>
            </div>
            <div class="flex items-center gap-4 p-4 bg-slate-50 rounded-xl">
              <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center">
                <span class="text-primary-600 font-bold">ISO</span>
              </div>
              <div>
                <div class="font-semibold text-slate-900">ISO 13485:2016</div>
                <div class="text-sm text-slate-500">Quality Management</div>
              </div>
            </div>
            <div class="flex items-center gap-4 p-4 bg-slate-50 rounded-xl">
              <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center">
                <span class="text-primary-600 font-bold">11+</span>
              </div>
              <div>
                <div class="font-semibold text-slate-900">Patents</div>
                <div class="text-sm text-slate-500">Registered & Pending</div>
              </div>
            </div>
          </div>
        </div>

        <div>
          <h2 class="heading-2 mb-6">{t('about.history.title')}</h2>
          <div class="space-y-6">
            {milestones.slice(0, 5).map((milestone) => (
              <div class="flex gap-4">
                <div class="shrink-0 w-20 text-sm font-semibold text-primary-600">{milestone.year}</div>
                <div>
                  <div class="font-semibold text-slate-900">{milestone.title}</div>
                  <div class="text-sm text-slate-600">{milestone.description}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Technologies -->
  <section class="section bg-gradient-section">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <h2 class="heading-2 mb-5">Core Technologies</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
        {coreTechnologies.map((tech) => (
          <div class="card-premium p-7">
            <div class="w-14 h-14 bg-gradient-to-br from-primary-100 to-primary-50 rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3">{tech.name}</h3>
            <p class="body-base mb-4">{tech.description}</p>
            <span class="text-sm font-medium text-primary-600">{tech.appliedTo}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="section bg-white">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="heading-2 mb-5">{t('nav.contactUs')}</h2>
        <p class="body-large mb-8">{t('contact.subtitle')}</p>
        <a href={`/${lang}/contact`} class="btn-primary">
          {t('common.contactSales')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
