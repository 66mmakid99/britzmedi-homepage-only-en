---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogHero from '../../../components/blog/BlogHero.astro';
import BlogCard from '../../../components/blog/BlogCard.astro';
import CategoryFilter from '../../../components/blog/CategoryFilter.astro';
import Pagination from '../../../components/blog/Pagination.astro';
import { supportedLanguages, defaultLang, type Language } from '../../../i18n/config';
import { useTranslations } from '../../../i18n';

export function getStaticPaths() {
  return supportedLanguages
    .filter(lang => lang !== defaultLang)
    .map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);

// Helper: get translated post title/description (falls back to English original)
const getPostTitle = (slug: string, fallback: string) => {
  const key = `blog.posts.${slug}.title`;
  const translated = t(key as any);
  return translated !== key ? translated : fallback;
};
const getPostDescription = (slug: string, fallback: string) => {
  const key = `blog.posts.${slug}.description`;
  const translated = t(key as any);
  return translated !== key ? translated : fallback;
};

// Helper: translate category value to localized label
const categoryMap: Record<string, string> = {
  'industry-news': t('blog.categories.industryNews'),
  'product-updates': t('blog.categories.productUpdates'),
  'technology': t('blog.categories.technology'),
  'clinical-studies': t('blog.categories.clinicalStudies'),
  'education': t('blog.categories.education'),
  'medical-devices': t('blog.categories.medicalDevices'),
};
const getCategoryLabel = (category: string) => categoryMap[category] || category.replace('-', ' ');

// Load dynamic blog posts from content/blog/*.json
const dynamicPostModules = import.meta.glob('../../../content/blog/*.json', { eager: true });
const dynamicPosts = Object.values(dynamicPostModules).map((mod: any) => {
  const data = mod.default || mod;
  return {
    slug: data.slug,
    title: data.title,
    description: data.excerpt || data.metaDescription || '',
    author: data.author || 'BRITZMEDI Team',
    publishedAt: data.publishedAt,
    category: data.category || 'medical-devices',
    tags: data.tags || [],
    featuredImage: data.featuredImage || null,
  };
});

// Static blog posts (original hardcoded posts)
const staticPosts = [
  {
    slug: 'fda-510k-clearance-process',
    title: 'FDA 510(k) Clearance: The Complete Guide for Medical Device Distributors',
    description: 'Everything distributors need to know about FDA 510(k) clearance — from process steps and costs to why it matters for your business. Includes BRITZMEDI TORR RF case study.',
    author: 'BRITZMEDI Team',
    publishedAt: '2025-12-15',
    category: 'education',
    tags: ['FDA', '510(k)', 'Regulatory Compliance'],
    featuredImage: '/images/blog/fda-510k.jpg',
  },
  {
    slug: 'rf-technology-aesthetic-medicine',
    title: 'RF Technology in Aesthetic Medicine: How Clinics Maximize ROI with Radiofrequency Devices',
    description: 'A comprehensive guide to RF technology for clinic owners and device buyers.',
    author: 'BRITZMEDI Team',
    publishedAt: '2025-11-28',
    category: 'technology',
    tags: ['RF Technology', 'Aesthetic Medicine', 'TORR RF'],
    featuredImage: '/images/blog/rf-technology.jpg',
  },
  {
    slug: 'korean-beauty-device-market',
    title: 'Korean Aesthetic Device Market: Why Global Distributors Are Partnering with Korean Manufacturers',
    description: 'Market data, regulatory landscape, and partnership opportunities in the Korean aesthetic device industry.',
    author: 'BRITZMEDI Team',
    publishedAt: '2025-10-20',
    category: 'industry-news',
    tags: ['Korean Medical Devices', 'K-Beauty', 'Distribution Partnership'],
    featuredImage: '/images/blog/korean-market.jpg',
  },
];

// Merge and sort
const allPosts = [...staticPosts, ...dynamicPosts].sort(
  (a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime()
);

const POSTS_PER_PAGE = 9;
const heroPost = allPosts[0];
const remainingPosts = allPosts.slice(1);
const totalGridPages = Math.ceil(remainingPosts.length / POSTS_PER_PAGE);
const paginatedPosts = remainingPosts.slice(0, POSTS_PER_PAGE);

const categories = [
  { value: 'all', label: t('blog.categories.all') },
  { value: 'industry-news', label: t('blog.categories.industryNews') },
  { value: 'product-updates', label: t('blog.categories.productUpdates') },
  { value: 'technology', label: t('blog.categories.technology') },
  { value: 'clinical-studies', label: t('blog.categories.clinicalStudies') },
  { value: 'education', label: t('blog.categories.education') },
];

// Locale for date formatting
const localeMap: Record<string, string> = {
  ja: 'ja-JP', zh: 'zh-CN', th: 'th-TH', vi: 'vi-VN',
  es: 'es-ES', fr: 'fr-FR', ru: 'ru-RU', ar: 'ar-SA',
};
const dateLocale = localeMap[lang] || 'en-US';

// Structured data for BlogPosting list
const blogListSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  'name': 'BRITZMEDI Blog',
  'description': t('blog.subtitle'),
  'url': `https://britzmedi.com/${lang}/blog`,
  'inLanguage': lang,
  'publisher': {
    '@type': 'Organization',
    'name': 'BRITZMEDI Co., Ltd.',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://britzmedi.com/images/logos/britzmedi-logo.png'
    }
  },
  'blogPost': allPosts.map(post => ({
    '@type': 'BlogPosting',
    'headline': getPostTitle(post.slug, post.title),
    'description': getPostDescription(post.slug, post.description),
    'author': {
      '@type': 'Organization',
      'name': post.author
    },
    'datePublished': post.publishedAt,
    'url': `https://britzmedi.com/${lang}/blog/${post.slug}`
  }))
};

// Translated filter label
const filterLabelMap: Record<string, string> = {
  ja: '\u30c8\u30d4\u30c3\u30af\u3067\u7d5e\u308a\u8fbc\u307f',
  zh: '\u6309\u4e3b\u9898\u7b5b\u9009',
  th: '\u0e01\u0e23\u0e2d\u0e07\u0e15\u0e32\u0e21\u0e2b\u0e31\u0e27\u0e02\u0e49\u0e2d',
  vi: 'L\u1ecdc theo ch\u1ee7 \u0111\u1ec1',
  es: 'Filtrar por tema',
  fr: 'Filtrer par sujet',
  ru: '\u0424\u0438\u043b\u044c\u0442\u0440 \u043f\u043e \u0442\u0435\u043c\u0435',
  ar: '\u062a\u0635\u0641\u064a\u0629 \u062d\u0633\u0628 \u0627\u0644\u0645\u0648\u0636\u0648\u0639',
};
const filterLabel = filterLabelMap[lang] || 'Filter by topic';

// Translated "More Articles" label
const moreArticlesMap: Record<string, string> = {
  ja: '\u305d\u306e\u4ed6\u306e\u8a18\u4e8b',
  zh: '\u66f4\u591a\u6587\u7ae0',
  th: '\u0e1a\u0e17\u0e04\u0e27\u0e32\u0e21\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e40\u0e15\u0e34\u0e21',
  vi: 'Th\u00eam b\u00e0i vi\u1ebft',
  es: 'M\u00e1s art\u00edculos',
  fr: 'Plus d\'articles',
  ru: '\u0411\u043e\u043b\u044c\u0448\u0435 \u0441\u0442\u0430\u0442\u0435\u0439',
  ar: '\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0645\u0642\u0627\u0644\u0627\u062a',
};
const moreArticlesLabel = moreArticlesMap[lang] || 'More Articles';
---

<BaseLayout
  title={t('blog.title')}
  description={t('blog.subtitle')}
  keywords={['medical device blog', 'RF technology insights', 'aesthetic medicine trends', 'FDA clearance process', 'K-beauty devices', 'TORR RF updates', 'medical device industry']}
>
  <script type="application/ld+json" set:html={JSON.stringify(blogListSchema)} />

  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-hero py-20 lg:py-28">
    <!-- Decorative blurred orbs -->
    <div class="absolute top-0 right-0 w-72 h-72 bg-primary-400/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-primary-600/5 rounded-full blur-3xl translate-y-1/2 -translate-x-1/3"></div>

    <div class="container relative">
      <div class="max-w-3xl">
        <span class="badge-premium mb-4 opacity-0 animate-fade-up">{t('blog.heroLabel')}</span>
        <h1 class="heading-1 mb-6 opacity-0 animate-fade-up stagger-1">
          {t('blog.heroTitle')}
        </h1>
        <p class="body-large max-w-2xl opacity-0 animate-fade-up stagger-2">
          {t('blog.heroDescription')}
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CategoryFilter categories={categories} filterLabel={filterLabel} />

      {/* Hero Card - Latest Post */}
      {heroPost && (
        <div class="mb-12" id="blog-hero-card" data-hero-category={heroPost.category}>
          <BlogHero
            slug={heroPost.slug}
            title={getPostTitle(heroPost.slug, heroPost.title)}
            description={getPostDescription(heroPost.slug, heroPost.description)}
            category={heroPost.category}
            categoryLabel={getCategoryLabel(heroPost.category)}
            publishedAt={heroPost.publishedAt}
            featuredImage={heroPost.featuredImage}
            dateLocale={dateLocale}
            readMoreText={t('blog.readMore')}
            basePath={`/${lang}/blog`}
          />
        </div>
      )}

      {/* More Articles section label */}
      <div class="flex items-center gap-3 mb-8">
        <span class="text-sm font-semibold text-slate-500 uppercase tracking-wide whitespace-nowrap">{moreArticlesLabel}</span>
        <div class="divider-gradient flex-1"></div>
      </div>

      {/* Post Grid */}
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {paginatedPosts.map((post, index) => (
          <BlogCard
            slug={post.slug}
            title={getPostTitle(post.slug, post.title)}
            description={getPostDescription(post.slug, post.description)}
            category={post.category}
            categoryLabel={getCategoryLabel(post.category)}
            publishedAt={post.publishedAt}
            featuredImage={post.featuredImage}
            dateLocale={dateLocale}
            readMoreText={t('blog.readMore')}
            basePath={`/${lang}/blog`}
            staggerIndex={index % 3}
          />
        ))}
      </div>

      <Pagination
        currentPage={1}
        totalPages={totalGridPages}
        basePath={`/${lang}/blog`}
        previousText={t('blog.pagination.previous')}
        nextText={t('blog.pagination.next')}
        pageText={t('blog.pagination.page')}
      />
    </div>
  </section>
</BaseLayout>
