---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/features/LeadForm.astro';
import { company } from '../../content/company';
import { supportedLanguages, defaultLang, type Language } from '../../i18n/config';
import { useTranslations } from '../../i18n';

export function getStaticPaths() {
  return supportedLanguages
    .filter(lang => lang !== defaultLang)
    .map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);
---

<BaseLayout
  title={t('contact.title')}
  description={t('contact.subtitle')}
>
  <!-- Hero Section -->
  <section class="relative py-16 lg:py-24 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-50 via-white to-primary-50/30"></div>
    <div class="container relative">
      <div class="max-w-2xl">
        <span class="label mb-4">{t('contact.title')}</span>
        <h1 class="heading-1 mb-6">{t('contact.subtitle')}</h1>
        <p class="body-large">
          {lang === 'ko' ? '24-48시간 내에 답변드리겠습니다.' :
           lang === 'ja' ? '24〜48時間以内にご返答いたします。' :
           lang === 'zh' ? '我们将在24-48小时内回复您。' :
           lang === 'th' ? 'เราจะตอบกลับภายใน 24-48 ชั่วโมง' :
           lang === 'vi' ? 'Chúng tôi sẽ phản hồi trong 24-48 giờ.' :
           lang === 'es' ? 'Respondemos en 24-48 horas.' :
           lang === 'ar' ? 'نرد خلال 24-48 ساعة.' :
           'We respond within 24-48 hours.'}
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Form & Info -->
  <section class="section bg-white -mt-8">
    <div class="container">
      <div class="grid lg:grid-cols-3 gap-12 lg:gap-16">
        <!-- Contact Form -->
        <div class="lg:col-span-2">
          <LeadForm />
        </div>

        <!-- Contact Info Sidebar -->
        <div class="space-y-8">
          <div class="card-premium p-6">
            <h3 class="font-semibold text-slate-900 mb-4">{t('contact.info.title')}</h3>

            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-primary-50 rounded-lg flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-medium text-slate-900">{t('contact.info.address')}</div>
                  <div class="text-sm text-slate-600">{company.address.full}</div>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-primary-50 rounded-lg flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-medium text-slate-900">{t('contact.info.email')}</div>
                  <a href={`mailto:${company.contact.email}`} class="text-sm text-primary-600 hover:underline">
                    {company.contact.email}
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-primary-50 rounded-lg flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-medium text-slate-900">{t('contact.info.phone')}</div>
                  <div class="text-sm text-slate-600">{company.contact.phone}</div>
                </div>
              </div>
            </div>
          </div>

          <div class="card-premium p-6">
            <h3 class="font-semibold text-slate-900 mb-4">
              {lang === 'ko' ? '업무 시간' :
               lang === 'ja' ? '営業時間' :
               lang === 'zh' ? '工作时间' :
               'Business Hours'}
            </h3>
            <div class="text-sm text-slate-600 space-y-2">
              <p>
                {lang === 'ko' ? '월-금: 09:00 - 18:00 (KST)' :
                 lang === 'ja' ? '月〜金: 09:00 - 18:00 (KST)' :
                 lang === 'zh' ? '周一至周五: 09:00 - 18:00 (KST)' :
                 'Mon-Fri: 09:00 - 18:00 (KST)'}
              </p>
              <p class="text-xs text-slate-500">
                {lang === 'ko' ? '* 국제 문의는 24-48시간 내 답변' :
                 lang === 'ja' ? '* 海外からのお問い合わせは24〜48時間以内に対応' :
                 lang === 'zh' ? '* 国际查询将在24-48小时内回复' :
                 '* International inquiries responded within 24-48 hours'}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
