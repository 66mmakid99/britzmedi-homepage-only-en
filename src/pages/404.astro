---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" noIndex={true}>
  <section class="min-h-[60vh] flex items-center justify-center py-20">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto">
        <!-- 404 Number -->
        <div class="text-9xl font-bold bg-gradient-to-r from-primary-600 to-primary-400 bg-clip-text text-transparent mb-6 select-none">
          404
        </div>

        <h1 class="text-2xl lg:text-3xl font-bold text-slate-900 mb-4">
          Page Not Found
        </h1>
        <p class="text-slate-600 mb-8 max-w-md mx-auto">
          The page you're looking for doesn't exist or has been moved. Try searching or use the links below.
        </p>

        <!-- Search Bar -->
        <div class="max-w-md mx-auto mb-10">
          <form action="/" method="get" id="search-form" class="relative">
            <input
              type="search"
              name="q"
              placeholder="Search products, pages..."
              class="w-full px-5 py-3.5 pl-12 text-base text-slate-900 bg-white border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-shadow shadow-sm"
            />
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </form>
        </div>

        <!-- Quick Links -->
        <div class="flex flex-wrap justify-center gap-3">
          <a
            href="/"
            class="inline-flex items-center gap-2 px-6 py-3 text-base font-semibold text-white bg-primary-600 hover:bg-primary-700 rounded-xl transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            Go Home
          </a>
          <a
            href="/products"
            class="inline-flex items-center gap-2 px-6 py-3 text-base font-semibold text-slate-700 bg-white border border-slate-200 hover:border-slate-300 hover:bg-slate-50 rounded-xl transition-colors"
          >
            Products
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-6 py-3 text-base font-semibold text-slate-700 bg-white border border-slate-200 hover:border-slate-300 hover:bg-slate-50 rounded-xl transition-colors"
          >
            Contact Us
          </a>
          <a
            href="/faq"
            class="inline-flex items-center gap-2 px-6 py-3 text-base font-semibold text-slate-700 bg-white border border-slate-200 hover:border-slate-300 hover:bg-slate-50 rounded-xl transition-colors"
          >
            FAQ
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
