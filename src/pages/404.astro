---
import BaseLayout from '../layouts/BaseLayout.astro';
import { translations } from '../i18n/translations';

// Build-time map of notFound strings for all 9 languages.
// The page is prerendered English-only; the inline script below swaps the
// three strings client-side when the URL has a language prefix (e.g. /ja/...).
const notFoundI18n = Object.fromEntries(
  Object.entries(translations).map(([lang, t]) => [lang, t.notFound])
);
const nf = notFoundI18n.en;
---

<BaseLayout title="Page Not Found" noIndex={true}>
  <section class="min-h-[60vh] flex items-center justify-center py-20">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto">
        <!-- 404 Number -->
        <div class="text-9xl font-bold bg-gradient-to-r from-primary-600 to-primary-400 bg-clip-text text-transparent mb-6 select-none">
          404
        </div>

        <h1 id="nf-title" class="text-2xl lg:text-3xl font-bold text-slate-900 mb-4">
          {nf.title}
        </h1>
        <p id="nf-message" class="text-slate-600 mb-8 max-w-md mx-auto">
          {nf.message}
        </p>

        <!-- Quick Links -->
        <div class="flex flex-wrap justify-center gap-3">
          <a
            href="/"
            class="inline-flex items-center gap-2 px-6 py-3 text-base font-semibold text-white bg-primary-600 hover:bg-primary-700 rounded-xl transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            <span id="nf-home">{nf.backHome}</span>
          </a>
          <a
            href="/products"
            class="inline-flex items-center gap-2 px-6 py-3 text-base font-semibold text-slate-700 bg-white border border-slate-200 hover:border-slate-300 hover:bg-slate-50 rounded-xl transition-colors"
          >
            Products
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-6 py-3 text-base font-semibold text-slate-700 bg-white border border-slate-200 hover:border-slate-300 hover:bg-slate-50 rounded-xl transition-colors"
          >
            Contact Us
          </a>
          <a
            href="/faq"
            class="inline-flex items-center gap-2 px-6 py-3 text-base font-semibold text-slate-700 bg-white border border-slate-200 hover:border-slate-300 hover:bg-slate-50 rounded-xl transition-colors"
          >
            FAQ
          </a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ notFoundI18n }}>
    // Swap the three notFound strings to the visitor's language based on the URL prefix.
    const lang = window.location.pathname.split('/')[1];
    const t = notFoundI18n[lang];
    if (t) {
      const title = document.getElementById('nf-title');
      const message = document.getElementById('nf-message');
      const home = document.getElementById('nf-home');
      if (title) title.textContent = t.title;
      if (message) message.textContent = t.message;
      if (home) home.textContent = t.backHome;
    }
  </script>
</BaseLayout>
