# BRITZMEDI Global Environment Variables
# Copy this file to .env and fill in the values
# (Production values are Cloudflare Pages secrets — process.env does NOT work at runtime)

# ===================
# Admin Authentication
# ===================
ADMIN_PASSWORD=
# Static admin session secret (dev-only cookie fallback; prod sessions are KV-backed)
ADMIN_SESSION_SECRET=

# ===================
# Cron / Internal Pipelines
# ===================
# Bearer token for /api/cron/* and the blog pipeline orchestrator's internal calls
CRON_SECRET=

# ===================
# API Keys
# ===================
# Claude API Key (content generation, AEO engine, lead research, chatbot)
ANTHROPIC_API_KEY=

# Slack Webhook for Lead Notifications
SLACK_WEBHOOK_URL=

# ===================
# YouTube to Blog System
# ===================
# Gemini API Key (translation, research, image generation)
GEMINI_API_KEY=

# Resend API Key (approval emails)
RESEND_API_KEY=

# Admin email for approval notifications
ADMIN_EMAIL=

# GitHub token for blog publishing (needs repo write access)
GITHUB_TOKEN=

# GitHub repo (format: owner/repo)
GITHUB_REPO=

# ===================
# SEO Workers API
# ===================
# Base URL of the external britzmedi-seo Workers API (content-hub SEO proxies)
SEO_WORKERS_URL=

# ===================
# Social Media
# ===================
# Twitter / X API
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# LinkedIn (OAuth client credentials)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=

# ===================
# Translation
# ===================
# DeepL API Key for translations
DEEPL_API_KEY=

# ===================
# Gmail API (AI Lead Draft)
# ===================
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
