# Cloudflare Pages Redirects
# Format: from  to  status

# www → non-www (requires www.britzmedi.com added as custom domain in Pages)
https://www.britzmedi.com/*  https://britzmedi.com/:splat  301

# Normalize trailing index.html
/index.html  /  301

# Korean path redirect (ko not in supported languages — redirect to English)
/ko  /  301
/ko/  /  301
/ko/*  /:splat  301

# Common old URL patterns (exact matches first, then splats)
/home  /  301
/about-us  /about  301
/product  /products  301
/faqs  /faq  301
/inquiry  /contact  301
/enquiry  /contact  301
/product/*  /products/:splat  301

# Admin legacy redirects
/admin/blog-manager  /admin/content-hub  301
/admin/blog-manager/*  /admin/content-hub  301
/admin/youtube-to-blog  /admin/content-hub  301
/admin/subscribers  /admin/content-hub  301
/admin/homepage  /admin/settings/site-editor  301
/admin/health  /admin  301
/admin/activity  /admin  301
/admin/resources  /admin/content-hub  301
